[Unit]
Description=Framerize public inference proxy
After=network-online.target

[Service]
ExecStart=%h/.nvm/versions/node/v20.20.0/bin/node --max-old-space-size=64 %h/.local/share/framerize-public/gateway.mjs
Restart=on-failure
RestartSec=3
MemoryMax=128M
NoNewPrivileges=yes
UMask=0077
TimeoutStopSec=1250

[Install]
WantedBy=default.target
