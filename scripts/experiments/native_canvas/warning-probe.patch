--- /dev/null
+++ b/scripts/offline_worker/warnings.mjs
@@ -0,0 +1,12 @@
+// Diagnostic fixture only. Retain categories and counts, never warning text.
+export const warnings = { process: 0, vm_modules: 0, vm_loader_origin: 0, other: 0 };
+export function observeWarning(warning) {
+  warnings.process++;
+  const vm = warning instanceof Error && warning.name === 'ExperimentalWarning'
+    && warning.message === 'VM Modules is an experimental feature and might change at any time';
+  if (vm) warnings.vm_modules++;
+  else warnings.other++;
+  if (vm && typeof warning.stack === 'string'
+      && warning.stack.includes('node:internal/vm/module:')
+      && /\/sdk_loader\.mjs:\d+:\d+/.test(warning.stack)) warnings.vm_loader_origin++;
+}
