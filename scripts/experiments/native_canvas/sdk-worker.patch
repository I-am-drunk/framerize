+export const graphics = {blocked_resources: 0, local_pngs: 0, jsdom_errors: 0, console_warnings: 0, console_errors: 0, process_warnings: 0};
+export function resources(ResourceLoader) {
+class Resources extends ResourceLoader {
+  constructor() { super({ userAgent: 'Framerize/0.1' }); }
+  fetch(url) {
+    const match = /^data:image\/png;base64,([A-Za-z0-9+/]*={0,2})$/.exec(url);
+    if (!match || match[1].length > 87384) { graphics.blocked_resources++; return null; }
+    const bytes = Buffer.from(match[1], 'base64');
+    if (bytes.length > 65536 || bytes.toString('base64') !== match[1]) {
+      graphics.blocked_resources++; return null;
+    }
+    if (bytes.length < 33 || bytes.subarray(0, 8).toString('hex') !== '89504e470d0a1a0a'
+        || bytes.readUInt32BE(8) !== 13 || bytes.toString('ascii', 12, 16) !== 'IHDR') {
+      graphics.blocked_resources++; return null;
+    }
+    const width = bytes.readUInt32BE(16), height = bytes.readUInt32BE(20);
+    if (!width || !height || width > 2048 || height > 2048
+        || width * height > 262144 || graphics.local_pngs >= 4) {
+      graphics.blocked_resources++; return null;
+    }
+    graphics.local_pngs++;
+    const result = Promise.resolve(bytes);
+    result.abort = () => {};
+    return result;
+  }
+}
+return Resources;
+}
