# Framerize gateway env contract (.env.example). Copy to .env and edit.
# Spend hierarchy: ALLOW_SPEND (master) > ALLOW_METERED / ALLOW_TOOL_LEGS.
# All *_CUTOFF/engine defaults keep serving free; research flags default off.

# --- spend gates ---
FRAMERIZE_ALLOW_SPEND=0
FRAMERIZE_ALLOW_METERED=0
FRAMERIZE_ALLOW_TOOL_LEGS=1
FRAMERIZE_MAX_SPEND_PER_REQUEST=0.01
FRAMERIZE_CREDIT_FLOOR=2.0

# --- routing / engines ---
FRAMERIZE_ENGINE_CHAT=
FRAMERIZE_ENGINE_RESPONSES=
FRAMERIZE_ENGINE_ANTHRO=
FRAMERIZE_DIRECT_NITRO=1
FRAMERIZE_CUSTOM_TRANSPORT=
FRAMERIZE_GOOSE_ROUTE=0

# --- billing research (default off unless noted) ---
FRAMERIZE_SSC_ALLOW_CAPS=0
FRAMERIZE_CUT_TRACE=1
FRAMERIZE_TOOL_CUTOFF=0
FRAMERIZE_NO_THINKING_CAP=0
FRAMERIZE_MODEL_GATE=0
FRAMERIZE_EMULATE_TOOLS=0
FRAMERIZE_REFUND_LAB=0

# --- infra ---
FRAMERIZE_STATE=
FRAMERIZE_LOG_DIR=
FRAMERIZE_BREAKER_FILE=
FRAMERIZE_REFUND_JOURNAL=
FRAMERIZE_SERVING_ACCOUNTS=
FRAMERIZE_ACTIVE_POOL_SIZE=
FRAMERIZE_JWT_RELAY_URL=
FRAMERIZE_JWT_RELAY_TOKEN=
