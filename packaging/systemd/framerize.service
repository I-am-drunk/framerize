[Unit]
Description=Framerize browser service

[Service]
Type=exec
ExecStart=%h/.local/share/framerize/current/bin/framerize daemon --engine camoufox --profiles %h/.framerize/profiles --db %h/.framerize/framerize.db
Environment=FRAMERIZE_PYTHON=%h/.framerize/venv/bin/python3
Restart=on-failure
RestartSec=5s
TimeoutStopSec=300s
KillMode=mixed
SendSIGKILL=yes
Delegate=no
UMask=0077

[Install]
WantedBy=default.target
