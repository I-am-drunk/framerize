{
  "name": "framerize",
  "version": "0.1.0",
  "description": "Node-native HTTP server for operator-authorized inference endpoints",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "frm": "./bin/framerize-server.js",
    "framerize": "./bin/framerize-server.js",
    "framerize-server": "./bin/framerize-server.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./config": "./dist/config.js",
    "./accounts": "./dist/accounts.js",
    "./logger": "./dist/logger.js",
    "./provider": "./dist/provider.js",
    "./framer-auth": "./dist/framer-auth.js",
    "./framer-backend": "./dist/framer-backend.js",
    "./account-backend": "./dist/account-backend.js",
    "./startup-access": "./dist/startup-access.js"
  },
  "files": [
    "bin",
    "dist/backend.js",
    "dist/backend.d.ts",
    "dist/castle-loader.js",
    "dist/castle-loader.d.ts",
    "dist/castle.js",
    "dist/accounts.js",
    "dist/accounts.d.ts",
    "dist/account-cli.js",
    "dist/account-cli.d.ts",
    "dist/account-store.js",
    "dist/account-store.d.ts",
    "dist/browser-login.js",
    "dist/browser-login.d.ts",
    "dist/account-backend.js",
    "dist/account-backend.d.ts",
    "dist/core.js",
    "dist/core.d.ts",
    "dist/core-types/backend.d.ts",
    "dist/core-types/http-policy.d.ts",
    "dist/core-types/instance.d.ts",
    "dist/core-types/instance-options.d.ts",
    "dist/core-types/readiness.d.ts",
    "dist/config.js",
    "dist/config.d.ts",
    "dist/errors.js",
    "dist/errors.d.ts",
    "dist/provider.js",
    "dist/provider.d.ts",
    "dist/framer-auth.js",
    "dist/framer-auth.d.ts",
    "dist/framer-backend.js",
    "dist/framer-backend.d.ts",
    "dist/framer-request.js",
    "dist/framer-request.d.ts",
    "dist/compat/completed-reply.js",
    "dist/compat/completed-reply.d.ts",
    "dist/compat/completed-stream.js",
    "dist/compat/completed-stream.d.ts",
    "dist/compat/messages-stream.js",
    "dist/compat/messages-stream.d.ts",
    "dist/compat/responses-stream.js",
    "dist/compat/responses-stream.d.ts",
    "dist/compat/events.js",
    "dist/compat/events.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/startup-access.js",
    "dist/startup-access.d.ts",
    "dist/private-network.js",
    "dist/private-network.d.ts",
    "dist/qr-code.js",
    "dist/qr-code.d.ts",
    "dist/settings.js",
    "dist/settings.d.ts",
    "dist/setup.js",
    "dist/setup.d.ts",
    "dist/service-units.js",
    "dist/service-units.d.ts",
    "dist/service-control.js",
    "dist/service-control.d.ts",
    "dist/tailscale.js",
    "dist/tailscale.d.ts",
    "dist/logger.js",
    "dist/logger.d.ts",
    "dist/server.js",
    "dist/server.d.ts",
    "README.md",
    "LICENSE",
    "T3-LICENSE",
    "NAYUKI-LICENSE",
    "T3-ATTRIBUTION.md"
  ],
  "scripts": {
    "start": "node bin/framerize-server.js serve",
    "dev": "node --watch bin/framerize-server.js serve",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.js",
    "acceptance": "node scripts/acceptance.js",
    "pack:check": "node scripts/package-smoke.js",
    "binary": "node scripts/build-binary.js",
    "binary:package": "node scripts/package-binary.js",
    "binary:check": "node scripts/binary-smoke.js"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}
