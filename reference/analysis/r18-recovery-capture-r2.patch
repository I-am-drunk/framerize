+"""Exercise the installed-runtime capture through the real preparation call."""
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+import copy
+import json
+import sys
+import tempfile
+import unittest
+import driver
+from recovery_binding import module
+
+HERE = Path(__file__).resolve().parent.parent
+PRIOR = HERE.parent / 'offline-serving-deployment-r18'
+R18 = '9e03bde34d7ca68ed6ed58a38cf0a373f3bac6978383a1c0f603306d6589bfb8'
+PRE_R18 = '162105d5d1c010c60f8bcebefbddc63e0cee492f0f9942459a6fcc11cfedba7b'
+
+
+class LaunchCaptureTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.output = Path(temporary.name)
+        modules = patch.dict(sys.modules)
+        modules.start()
+        self.addCleanup(modules.stop)
+        self.pins = json.loads((HERE / 'test-inputs.json').read_text())
+        module('observer', self.pin(PRIOR / 'startup/observer.py'))
+        self.capture = module('fixture_capture', self.pin(HERE / 'startup/launch.py'))
+        self.legacy = module('fixture_legacy', self.pin(PRIOR / 'startup/launch.py'))
+        self.current = dict(main=dict(pid=100, exe_sha256=R18),
+                            sidecar=dict(pid=101), boot_id='fixture', cgroup='/fixture')
+        self.target = dict(active_capacity=6, eligible_accounts='all')
+        self.pool = json.dumps(self.target)
+        self.adapter = SimpleNamespace(OLD_BIN=PRE_R18, OLD_PY='unchanged-host',
+            TARGET=self.target, snapshot=Mock(return_value=self.current),
+            accepted_base=Mock(return_value='fixture-base'),
+            pool_setting=Mock(return_value=self.pool),
+            same_processes=lambda left, right: left == right)
+        self.record = dict(files=dict(binary=dict(new_sha256=R18)))
+        self.inputs = dict(capacity_override=None, cmdline_sha256='a' * 64,
+                           environment_sha256='b' * 64, legacy_config=self.target)
+        self.reader = Mock(return_value=self.inputs)
+        self.controls = Mock(spec=['assert_held', 'release'])
+        self.held = SimpleNamespace(marker_identity=[1, 2],
+            marker_sha256='c' * 64, boot_id='fixture')
+        self.guard = {'fixture': 'guard'}
+        self.identity = SimpleNamespace(identity=lambda: self.guard,
+            bound_controls=lambda *_: lambda *_: self.controls)
+        self.plan = dict(sources={}, evidence={}, guard_identity={}, original_receipt={},
+            modules={name: {} for name in ('observer', 'launch', 'startup_runtime',
+                'settlement_runtime', 'cooldown_transfer', 'fd_bridge', 'coordinator',
+                'recovery_identity')})
+        for name, path in (('observer', PRIOR / 'startup/observer.py'),
+                           ('launch', HERE / 'startup/launch.py')):
+            self.plan['modules'][name] = self.pin(path)
+            self.plan['sources'][str(path)] = self.pins[str(path)]
+
+    def pin(self, path):
+        return dict(path=str(path), sha256=self.pins[str(path)])
+
+    def load(self, name, pin):
+        if name in ('observer', 'launch'):
+            result = module(name, pin)
+            if name == 'launch':
+                result.process_inputs = self.reader
+            return result
+        return self.identity if name == 'recovery_identity' else SimpleNamespace()
+
+    def prepare(self):
+        before = dict(current=copy.deepcopy(self.current))
+        with patch.object(driver, 'module', side_effect=self.load), \
+             patch.object(driver, 'document', return_value=self.guard), \
+             patch.object(driver.recovery_checks, 'existing', return_value=before):
+            return driver.prepare_held(self.plan, {}, {}, self.output, Mock(),
+                self.adapter, self.held, self.record, Mock(), Mock())
+
+    def test_r18_preparation_captures_installed_binary_and_preserves_old_constants(self):
+        context = self.prepare()
+        capture = json.loads((self.output / 'launch-capture.json').read_text())
+        self.assertEqual(context['capture'], capture)
+        self.assertEqual(capture['prior'], self.current)
+        self.assertEqual(capture['replacement_sha256'], R18)
+        self.assertEqual(capture['inputs'], self.inputs)
+        self.assertEqual(capture['pool_before'], self.pool)
+        self.assertEqual(capture['startup_policy'], 'pool_v1_ordered')
+        self.assertEqual(self.adapter.OLD_BIN, PRE_R18)
+        self.assertEqual(self.adapter.OLD_PY, 'unchanged-host')
+        self.reader.assert_called_once_with(100)
+        self.controls.assert_held.assert_called_once()
+        self.controls.release.assert_not_called()
+
+    def test_wrong_running_binary_is_refused_before_process_input_capture(self):
+        for digest in (PRE_R18, 'f' * 64):
+            with self.subTest(running_sha256=digest):
+                self.current['main']['exe_sha256'] = digest
+                with self.assertRaisesRegex(RuntimeError, 'unexpected original executable'):
+                    self.prepare()
+                self.reader.assert_not_called()
+                self.assertFalse((self.output / 'launch-capture.json').exists())
+                self.assertEqual(self.adapter.OLD_BIN, PRE_R18)
+
+    def test_current_binary_pin_is_required_and_validated_before_snapshot(self):
+        with self.assertRaises(TypeError):
+            self.capture.capture_launch(self.adapter, 'fixture-base', R18)
+        for digest in (None, '', R18.upper(), 'g' * 64, R18[:-1]):
+            with self.subTest(current_sha256=digest):
+                with self.assertRaisesRegex(RuntimeError, 'accepted current identity'):
+                    self.capture.capture_launch(self.adapter, 'fixture-base', R18,
+                                                current_sha256=digest)
+        self.adapter.snapshot.assert_not_called()
+
+    def test_original_helper_reproduces_r18_refusal(self):
+        with patch.object(self.legacy, 'process_inputs', self.reader):
+            with self.assertRaisesRegex(RuntimeError, 'unexpected original executable'):
+                self.legacy.capture_launch(self.adapter, 'fixture-base', R18)
+        self.reader.assert_not_called()
+        self.assertEqual(self.adapter.OLD_BIN, PRE_R18)
