+import hashlib
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from materialize import copy_one
+
+
+class MaterializeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.base = Path(self.temp.name)
+        self.source = self.base / 'source'
+        self.source.write_bytes(b'pinned software fixture\n')
+        self.source.chmod(0o755)
+        self.root = self.base / 'tree'
+        self.root.mkdir(mode=0o700)
+        self.row = dict(path='usr/lib/example', mode=0o755,
+                        size=self.source.stat().st_size,
+                        sha256=hashlib.sha256(self.source.read_bytes()).hexdigest())
+
+    def test_exact_copy_preserves_mode_without_linking(self):
+        self.assertEqual(copy_one(self.source, self.root, self.row), self.row['size'])
+        result = self.root / self.row['path']
+        self.assertEqual(result.read_bytes(), self.source.read_bytes())
+        self.assertEqual(result.stat().st_mode & 0o777, 0o755)
+        self.assertEqual(result.stat().st_nlink, 1)
+        self.assertNotEqual(result.stat().st_ino, self.source.stat().st_ino)
+
+    def test_corrupt_input_never_returns_success(self):
+        with self.assertRaisesRegex(RuntimeError, 'source_digest'):
+            copy_one(self.source, self.root, self.row | {'sha256': '0' * 64})
+        self.assertEqual(self.source.read_bytes(), b'pinned software fixture\n')
+
+    def test_size_or_mode_mismatch_refuses_before_copy(self):
+        for changed in ({'size': 0}, {'mode': 0o600}):
+            with self.subTest(changed=changed):
+                with self.assertRaises(RuntimeError):
+                    copy_one(self.source, self.root, self.row | changed)
+                self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_source_symlink_is_refused(self):
+        link = self.base / 'link'
+        link.symlink_to(self.source)
+        with self.assertRaisesRegex(RuntimeError, 'source'):
+            copy_one(link, self.root, self.row)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_destination_symlinks_never_change_target(self):
+        (self.root / 'usr').symlink_to(self.base, target_is_directory=True)
+        with self.assertRaisesRegex(RuntimeError, 'parent_symlink'):
+            copy_one(self.source, self.root, self.row)
+        (self.root / 'usr').unlink()
+        (self.root / 'target').symlink_to(self.source)
+        with self.assertRaisesRegex(RuntimeError, 'exists'):
+            copy_one(self.source, self.root, self.row | {'path': 'target'})
+        self.assertEqual(self.source.read_bytes(), b'pinned software fixture\n')
+
+    def test_noncanonical_paths_and_replacement_refuse(self):
+        for path in ('/absolute', '../escape', 'a/../escape', 'a//b', './a', ''):
+            with self.subTest(path=path):
+                with self.assertRaises(RuntimeError):
+                    copy_one(self.source, self.root, self.row | {'path': path})
+        copy_one(self.source, self.root, self.row)
+        with self.assertRaisesRegex(RuntimeError, 'exists'):
+            copy_one(self.source, self.root, self.row)
+        self.assertEqual((self.root / self.row['path']).read_bytes(), self.source.read_bytes())
