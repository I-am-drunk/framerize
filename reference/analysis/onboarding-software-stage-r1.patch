+"""Copy exact software pins in small isolated batches; execute no target code."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+HERE = Path(__file__).resolve().parent
+binding = json.loads((HERE / 'stage-inputs.json').read_text())
+root = HERE / 'tree'
+root.mkdir(mode=0o700)
+deadline = time.monotonic() + 110
+completed = []
+for number in range(binding['batches']):
+    rows = json.loads((HERE / 'batches' / (str(number) + '.json')).read_text())
+    mounts = ['--dir', '/inputs', '--bind', str(root), '/release']
+    for index, row in enumerate(rows):
+        mounts += ['--ro-bind', row['source'], '/inputs/' + str(index)]
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--new-session',
+            '--clearenv', '--ro-bind', '/usr', '/usr', '--ro-bind', '/lib', '/lib',
+            '--ro-bind', '/lib64', '/lib64', '--ro-bind', str(HERE), '/work',
+            *mounts, '--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
+            '--chdir', '/work', '/usr/bin/python3.12', '-I', '-B',
+            '/work/materialize.py', str(number)]
+    assert len(argv) < 8000
+    assert sum(len(x.encode()) + 9 for x in argv) < os.sysconf('SC_ARG_MAX') - 65536
+    result = subprocess.run(argv, capture_output=True, text=True,
+                            timeout=max(.01, deadline - time.monotonic()))
+    assert result.returncode == 0, result.stderr[:4096]
+    assert len(result.stdout) < 4096 and len(result.stderr) < 4096
+    summary = json.loads(result.stdout)
+    assert summary == dict(files=len(rows), bytes=sum(x['size'] for x in rows),
+                           executable_started=False)
+    completed.append(summary)
+    with (HERE / ('batch-' + str(number) + '.json')).open('x') as out:
+        out.write(json.dumps(summary, sort_keys=True) + '\n')
+print(json.dumps(dict(files=sum(row['files'] for row in completed),
+    bytes=sum(row['bytes'] for row in completed), batches=len(completed),
+    executable_started=False)))
