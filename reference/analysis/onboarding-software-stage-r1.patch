+"""Collect one completed staging operation; never execute staged software."""
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+def sha(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+assert len(sys.argv) == 3, 'actual terminal and execution chunk required'
+result = json.loads((HERE / 'result.json').read_text())
+assert result['accepted'] and result['exit'] == 0 and result['before'] == result['after']
+assert result['after'] == json.loads((HERE / 'execution-inputs.json').read_text())
+process = json.loads((HERE / 'process.json').read_text())
+assert all(not Path('/proc', str(process[key])).exists() for key in ('launcher', 'child'))
+unit = subprocess.run(['systemctl', '--user', 'show', process['unit'], '-p',
+                       'LoadState', '--value'], capture_output=True, text=True, timeout=10)
+assert unit.stdout.strip() == 'not-found'
+with (HERE.parents[1] / 't3-binding-recovery-r1/execution-slot.lock').open('a') as lock:
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+rows = []
+for batch in sorted((HERE / 'batches').glob('*.json')):
+    rows.extend(json.loads(batch.read_text()))
+root = HERE / 'tree'
+expected = {row['path'] for row in rows}
+actual = set()
+for path in root.rglob('*'):
+    info = path.lstat()
+    assert stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)
+    if stat.S_ISREG(info.st_mode):
+        actual.add(str(path.relative_to(root)))
+assert actual == expected
+for row in rows:
+    path = root / row['path']
+    info = path.stat()
+    assert info.st_size == row['size'] and stat.S_IMODE(info.st_mode) == row['mode']
+    assert info.st_nlink == 1 and sha(path) == row['sha256']
+summary = dict(files=len(rows), bytes=sum(row['size'] for row in rows),
+               batches=len(list((HERE / 'batches').glob('*.json'))), executable_started=False)
+assert json.loads(result['stdout']) == summary
+record = dict(status='FILES_COPIED_NOT_LAUNCHABLE', collected_at=
+    datetime.datetime.now(datetime.timezone.utc).isoformat(), summary=summary,
+    actual_terminal=int(sys.argv[1]), actual_chunk=sys.argv[2], unit_absent=True,
+    known_processes_absent=True, lock_free=True, result_sha256=sha(HERE / 'result.json'),
+    execution_inputs_sha256=sha(HERE / 'execution-inputs.json'))
+with (HERE / 'collection.json').open('x') as out:
+    out.write(json.dumps(record, sort_keys=True) + '\n')
+print(json.dumps(record))
