+"""Copy only pinned software into a new task-owned sparse tree."""
+import hashlib
+import os
+from pathlib import Path, PurePosixPath
+import stat
+
+
+def require(value, reason):
+    if not value:
+        raise RuntimeError('software_stage_' + reason)
+
+
+def relative(text):
+    require(type(text) is str and text and not text.startswith('/'), 'relative')
+    path = PurePosixPath(text)
+    require(str(path) == text and not set(path.parts) & {'.', '..'}, 'normalized')
+    require(not any(ord(c) < 32 or ord(c) == 127 for c in text), 'path_control')
+    return path
+
+
+def sha(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def identity(info):
+    return tuple(getattr(info, key) for key in ('st_dev', 'st_ino', 'st_mode',
+                 'st_size', 'st_mtime_ns', 'st_ctime_ns'))
+
+
+def copy_one(source, root, row):
+    source, root = Path(source), Path(root)
+    rel = relative(row['path'])
+    require(root.resolve(strict=True) == root and root.is_dir(), 'root')
+    require(root.stat().st_uid == os.getuid(), 'owner')
+    info = source.lstat()
+    require(stat.S_ISREG(info.st_mode) and info.st_size == row['size'], 'source')
+    require(stat.S_IMODE(info.st_mode) == row['mode'], 'source_mode')
+    require(not row['mode'] & 0o7000, 'unsafe_mode')
+    parent = root
+    for name in rel.parts[:-1]:
+        parent /= name
+        try:
+            parent.mkdir(mode=0o755)
+        except FileExistsError:
+            pass
+        require(stat.S_ISDIR(parent.lstat().st_mode), 'parent_symlink')
+    destination = parent / rel.name
+    require(not destination.exists() and not destination.is_symlink(), 'exists')
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
+    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(source_fd, 'rb') as inp:
+        require(identity(os.fstat(inp.fileno())) == identity(info), 'source_changed')
+        with os.fdopen(os.open(destination, flags, 0o600), 'wb') as out:
+            digest = hashlib.sha256()
+            size = 0
+            while block := inp.read(1024 * 1024):
+                size += len(block)
+                require(size <= row['size'], 'source_grew')
+                digest.update(block)
+                out.write(block)
+            require(size == row['size'] and digest.hexdigest() == row['sha256'],
+                    'source_digest')
+            require(identity(os.fstat(inp.fileno())) == identity(info), 'source_changed')
+            out.flush()
+            os.fsync(out.fileno())
+            os.fchmod(out.fileno(), row['mode'])
+    require(identity(source.stat()) == identity(info), 'source_replaced')
+    require(sha(destination) == row['sha256'], 'destination_digest')
+    require(destination.stat().st_nlink == 1, 'linked_destination')
+    return size
+
+
+def main():
+    import json
+    import sys
+    batch = json.loads(Path('/work/batches', sys.argv[1] + '.json').read_text())
+    total = 0
+    for index, row in enumerate(batch):
+        total += copy_one(Path('/inputs') / str(index), Path('/release'), row)
+    print(json.dumps(dict(files=len(batch), bytes=total, executable_started=False)))
+
+
+if __name__ == '__main__':
+    main()
