+"""Stage inert software files within the accepted resource and process limits."""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+HERE = Path(__file__).resolve().parent
+def sha(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+def save(name, value):
+    with (HERE / name).open('x') as out:
+        out.write(json.dumps(value, sort_keys=True) + '\n')
+
+binding = json.loads((HERE / 'stage-inputs.json').read_text())
+unit = 'framerize-onboarding-software-stage-' + str(os.getpid())
+argv = ['/usr/bin/systemd-run', '--user', '--wait', '--pipe', '--collect',
+        '--unit=' + unit, '-p', 'MemoryMax=134217728', '-p', 'MemorySwapMax=0',
+        '-p', 'TasksMax=32', '-p', 'CPUQuota=100%', '-p', 'RuntimeMaxSec=120',
+        '-p', 'TimeoutStopSec=10', '/usr/bin/python3.12', '-I', '-B',
+        str(HERE / 'execute_batches.py')]
+lock = HERE.parents[1] / 't3-binding-recovery-r1/execution-slot.lock'
+with lock.open('a') as slot:
+    fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    assert not (HERE / 'tree').exists() and not (HERE / 'process.json').exists()
+    memory = {line.split(':')[0]: int(line.split()[1])*1024
+              for line in Path('/proc/meminfo').read_text().splitlines()
+              if line.startswith(('MemTotal:', 'MemAvailable:'))}
+    assert memory['MemAvailable'] > memory['MemTotal']//10 + 640*1024**2
+    disk = os.statvfs(HERE)
+    assert disk.f_bavail * disk.f_frsize > binding['bytes'] + 1024**3
+    pins = json.loads((HERE / 'execution-inputs.json').read_text())
+    before = {name: sha(Path(name)) for name in pins}
+    assert before == pins, 'staging inputs changed'
+    started = time.time()
+    child = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True)
+    save('process.json', dict(launcher=os.getpid(), child=child.pid, unit=unit))
+    try:
+        stdout, stderr = child.communicate(timeout=132)
+    finally:
+        if child.poll() is None:
+            subprocess.run(['systemctl', '--user', 'stop', unit], timeout=10,
+                           capture_output=True)
+            child.kill()
+            child.wait(timeout=5)
+    after = {name: sha(Path(name)) for name in pins}
+    assert len(stdout) + len(stderr) < 1024 * 1024
+    result = dict(accepted=child.returncode == 0 and before == after,
+                  before=before, after=after, exit=child.returncode, stdout=stdout,
+                  stderr=stderr, started=started, finished=time.time())
+    save('result.json', result)
+print(json.dumps({key: result[key] for key in ('accepted', 'exit', 'stdout', 'stderr')}))
+raise SystemExit(0 if result['accepted'] else 1)
