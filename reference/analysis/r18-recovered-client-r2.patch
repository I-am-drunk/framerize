@@ -2,0 +3 @@
+import runpy
@@ -9,0 +11,23 @@
+    def test_wrapper_must_bind_state_fingerprint_and_release(self):
+        mutations = [('fingerprint', dict(changed=True)),
+                     ('release', dict(path='/inert/other', sha256='0' * 64))]
+        for field, value in mutations:
+            with self.subTest(field=field), case() as f:
+                for record in (f.before, f.post, f.released):
+                    record['protected'] = dict(record['protected'], **{field: value})
+                f.refresh()
+                with self.assertRaisesRegex(check.Refused, 'inconsistent_recovery_protection'):
+                    recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_original_client_refuses_actual_producer_shape(self):
+        original = runpy.run_path(str(recovery.HERE.parent /
+            'offline-serving-client-check-r15/recovery_state.py'))
+        with case() as f:
+            pins = {key: getattr(recovery, key) for key in
+                    ('RECOVERY', 'PLAN_SHA', 'REVIEW_SHA')}
+            with patch.dict(original['saved'].__globals__, pins):
+                with self.assertRaisesRegex(check.Refused, 'inconsistent_recovery_protection'):
+                    original['saved'](f.client, f.original, f.original_sha)
+            result = recovery.saved(f.client, f.original, f.original_sha)
+            self.assertEqual(result['service'], recovery.service(f.current))
+
