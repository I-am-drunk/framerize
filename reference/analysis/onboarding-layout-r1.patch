+"""Own one isolated onboarding daemon; never submit a login or inference."""
+import http.client
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+
+def request(method, path, body=None, timeout=2):
+    connection = http.client.HTTPConnection('127.0.0.1', 18788, timeout=timeout)
+    try:
+        payload = None if body is None else json.dumps(body).encode()
+        connection.request(method, path, payload, {'Content-Type': 'application/json'})
+        reply = connection.getresponse()
+        data = reply.read(65537)
+        if len(data) > 65536:
+            raise RuntimeError('oversized_local_response')
+        return reply.status, data
+    finally:
+        connection.close()
+
+def save(root, name, value):
+    with (root/name).open('x') as out:
+        json.dump(value, out, indent=2)
+    (root/name).chmod(0o600)
+
+def require(value, reason):
+    if not value:
+        raise RuntimeError(reason)
+
+def owns_listener(pid):
+    sockets = set()
+    for line in Path('/proc/net/tcp').read_text().splitlines()[1:]:
+        columns = line.split()
+        if columns[1] == '0100007F:4964' and columns[3] == '0A':
+            sockets.add('socket:['+columns[9]+']')
+    for descriptor in Path('/proc', str(pid), 'fd').iterdir():
+        try:
+            if os.readlink(descriptor) in sockets:
+                return True
+        except FileNotFoundError:
+            continue
+    return False
+
+def ready(child):
+    end = time.monotonic() + 10
+    while time.monotonic() < end:
+        require(child.poll() is None, 'daemon_exited_before_ready')
+        if not owns_listener(child.pid):
+            time.sleep(.1)
+            continue
+        try:
+            if request('GET', '/api/health') == (200, b'ok'):
+                status, body = request('GET', '/api/accounts')
+                require(status == 200 and json.loads(body) == [], 'store_not_empty')
+                return
+        except (OSError, http.client.HTTPException):
+            pass
+        time.sleep(.1)
+    raise RuntimeError('daemon_readiness_deadline')
+
+def park_once():
+    status, raw = request('GET', '/api/pool')
+    require(status == 200, 'pool_read_refused')
+    pool = json.loads(raw)
+    require(pool['accounts'] <= 1, 'multiple_account_records')
+    residents = pool['residency']['residents']
+    require(len(residents) <= 1, 'multiple_resident_accounts')
+    if residents:
+        account = residents[0]['account']
+        status, raw = request('POST', '/api/pool/park', {'account_id': account}, 25)
+        require(status == 200, 'park_refused')
+        result = json.loads(raw)
+        require(result.get('account_id') == account and result.get('status') == 'parked',
+                'park_receipt_mismatch')
+    status, raw = request('GET', '/api/pool')
+    require(status == 200 and json.loads(raw)['residency']['residents'] == [],
+            'resident_work_remained')
+    return {'registered_accounts': pool['accounts'], 'parked_residents': len(residents)}
+
+def run(plan):
+    root = Path(plan['private'])
+    require(root.is_dir() and not root.is_symlink() and not any(root.iterdir()),
+            'empty_private_directory_required')
+    require(root.stat().st_uid == os.getuid() and root.stat().st_mode & 0o777 == 0o700,
+            'private_directory_permissions')
+    require(plan['daemon_argv'][0] == plan['package']+'/bin/framerize', 'wrong_binary')
+    stop = []
+    for number in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(number, lambda *_: stop.append(True))
+    result = {'status': 'failed', 'agent_login_submissions': 0,
+              'agent_inference_submissions': 0, 'joined_park': False}
+    with (root/'daemon.log').open('xb') as log:
+        child = subprocess.Popen(plan['daemon_argv'], stdin=subprocess.DEVNULL,
+                                 stdout=log, stderr=subprocess.STDOUT)
+        try:
+            ready(child)
+            save(root, 'ready.json', {'url': 'http://127.0.0.1:18788',
+                'pid_in_namespace': child.pid, 'at': time.time()})
+            end = time.monotonic() + 540
+            while not stop and not (root/'stop').exists() and time.monotonic() < end:
+                require(child.poll() is None, 'daemon_exited')
+                time.sleep(.25)
+            result.update(park_once(), joined_park=True, status='parked')
+        except Exception as error:
+            result['failure_class'] = type(error).__name__
+            if type(error) is RuntimeError:
+                result['failure'] = str(error)
+        finally:
+            finish(child, root, result)
+    return result
+
+def finish(child, root, result):
+    if child.poll() is None:
+        child.send_signal(signal.SIGTERM)
+    try:
+        child.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        child.kill()
+        child.wait(timeout=3)
+        result.update(status='failed', forced_kill=True)
+    result['daemon_exit'] = child.returncode
+    result['daemon_joined'] = True
+    save(root, 'instance-result.json', result)
+
+if __name__ == '__main__':
+    os.umask(0o077)
+    plan = json.loads((HERE/'launch-plan.json').read_text())
+    require(plan.get('launchable') is True, 'final_binding_required')
+    result = run(plan)
+    print(json.dumps(result))
+    raise SystemExit(0 if result['status'] == 'parked' else 1)
