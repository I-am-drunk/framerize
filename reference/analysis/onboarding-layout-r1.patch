+"""Pinned sparse software layout. No private state is read or created here."""
+from pathlib import Path, PurePosixPath
+import hashlib
+import json
+import os
+import posixpath
+import stat
+
+HERE = Path(__file__).resolve().parent
+VIEW_SHA256 = '9d773579b2a86d9903c897c9744d48277117ffe21da863ac8c3fbafe78923ed1'
+CACHE_SOURCE = '/home/tjninja/.cache/camoufox'
+MASKS = ('/home', '/root', '/run', '/tmp', '/var/tmp', '/usr')
+PRIVATE_NAMES = ('home', 'cache', 'config', 'data', 'state', 'run', 'tmp',
+                 'cwd', 'cache/camoufox/fontconfig', 'cache/fontconfig')
+ENV_PATHS = {'HOME': 'home', 'XDG_CACHE_HOME': 'cache',
+             'XDG_CONFIG_HOME': 'config', 'XDG_DATA_HOME': 'data',
+             'XDG_STATE_HOME': 'state', 'XDG_RUNTIME_DIR': 'run', 'TMPDIR': 'tmp'}
+
+
+def require(value, reason):
+    if not value:
+        raise RuntimeError('onboarding_layout_' + reason)
+
+
+def within(path, root):
+    return path == root or path.startswith(root + '/')
+
+
+def path_text(value):
+    require(type(value) is str and 1 < len(value) <= 4096, 'path_type')
+    require(value.startswith('/') and not value.startswith('//'), 'absolute_path')
+    require(str(PurePosixPath(value)) == value and '..' not in value.split('/'),
+            'normalized_path')
+    require(not any(ord(c) < 32 or ord(c) == 127 for c in value), 'path_control')
+    return value
+
+
+def hash_text(value):
+    require(type(value) is str and len(value) == 64 and
+            all(c in '0123456789abcdef' for c in value), 'digest')
+
+
+def resolve_alias(path, aliases):
+    for _ in range(len(aliases) + 1):
+        parts = path.split('/')[1:]
+        for index in range(1, len(parts) + 1):
+            prefix = '/' + '/'.join(parts[:index])
+            if prefix in aliases:
+                target = aliases[prefix]['target']
+                path = posixpath.normpath(posixpath.join(
+                    posixpath.dirname(prefix), target, *parts[index:]))
+                break
+        else:
+            return path
+    raise RuntimeError('onboarding_layout_alias_cycle')
+
+
+def private_layout(value):
+    root = path_text(value['environment_root'])
+    account = path_text(value['account_state'])
+    require(PurePosixPath(root).name == 'private-environment' and
+            PurePosixPath(account).name == 'private' and
+            PurePosixPath(root).parent == PurePosixPath(account).parent and
+            within(root, '/home'), 'private_separation')
+    expected = [root + '/' + name for name in PRIVATE_NAMES]
+    require(type(value['private_directories']) is list and
+            value['private_directories'] == expected, 'private_directories')
+    env = value['environment']
+    require(type(env) is dict and set(env) == set(ENV_PATHS) |
+            {'FRAMERIZE_PYTHON', 'PYTHONDONTWRITEBYTECODE', 'PYTHONNOUSERSITE'},
+            'environment_keys')
+    require(all(type(k) is str and type(v) is str for k, v in env.items()),
+            'environment_types')
+    require(all(env[k] == root + '/' + suffix for k, suffix in ENV_PATHS.items())
+            and env['PYTHONDONTWRITEBYTECODE'] == '1' and
+            env['PYTHONNOUSERSITE'] == '1', 'environment_values')
+    path_text(env['FRAMERIZE_PYTHON'])
+    return root, account
+
+
+def validate(value):
+    require(type(value) is dict and set(value) == {'account_state', 'aliases',
+            'environment', 'environment_root', 'inputs', 'mounts',
+            'private_directories', 'remaining', 'status'}, 'view_fields')
+    root, account = private_layout(value)
+    rows, aliases = value['mounts'], value['aliases']
+    require(type(rows) is list and 0 < len(rows) <= 10000, 'mount_rows')
+    require(type(aliases) is dict and len(aliases) <= 512, 'alias_rows')
+    targets, sources = set(), set()
+    for row in rows:
+        require(type(row) is dict and set(row) == {'source', 'target', 'sha256'},
+                'mount_fields')
+        source, target = path_text(row['source']), path_text(row['target'])
+        hash_text(row['sha256'])
+        require(source not in sources and target not in targets, 'duplicate_mount')
+        expected = (root + '/cache/camoufox' + source[len(CACHE_SOURCE):]
+                    if within(source, CACHE_SOURCE) else source)
+        require(target == expected, 'mount_translation')
+        require(not within(source, root) and not within(source, account) and
+                not within(target, account), 'private_input')
+        require(not within(target, root) or within(target, root + '/cache/camoufox'),
+                'environment_input')
+        sources.add(source)
+        targets.add(target)
+    for name, row in aliases.items():
+        path_text(name)
+        require(type(row) is dict and set(row) ==
+                {'canonical_target', 'target', 'kind', 'mode'}, 'alias_fields')
+        path_text(row['canonical_target'])
+        text = row['target']
+        require(type(text) is str and 0 < len(text) <= 4096 and
+                not any(ord(c) < 32 or ord(c) == 127 for c in text), 'alias_text')
+        require(type(row['kind']) is str and row['kind'] in ('file', 'directory')
+                and row['mode'] == '0o777', 'alias_metadata')
+        require(not within(name, root) and not within(name, account), 'private_alias')
+    directories = set(MASKS) | set(value['private_directories'])
+    directories.update((root, account, root + '/cache/camoufox'))
+    for name in targets | set(aliases) | set(directories):
+        directories.update(str(p) for p in PurePosixPath(name).parents if str(p) != '/')
+    require(not targets.intersection(aliases) and
+            not (targets | set(aliases)).intersection(directories), 'path_collision')
+    for name, row in aliases.items():
+        canonical = resolve_alias(name, aliases)
+        require(canonical == row['canonical_target'], 'alias_resolution')
+        require(canonical in (targets if row['kind'] == 'file' else directories),
+                'alias_unbound')
+        require(row['kind'] == 'file' or
+                any(within(p, canonical) for p in targets | set(aliases)),
+                'empty_directory_alias')
+    require(value['environment']['FRAMERIZE_PYTHON'] in targets | set(aliases),
+            'python_unbound')
+    for row in aliases.values():
+        require(not within(row['canonical_target'], root) and
+                not within(row['canonical_target'], account), 'private_alias_target')
+    require(type(value['inputs']) is dict and len(value['inputs']) <= 32, 'input_map')
+    for name, expected in value['inputs'].items():
+        path_text(name)
+        hash_text(expected)
+        require(not within(name, root) and not within(name, account), 'private_input')
+    require(value['status'] == 'prepared-not-launchable', 'view_status')
+    return directories
+
+
+def check_file(name, expected, retain=False):
+    path = Path(name)
+    require(path.resolve(strict=True) == path and
+            stat.S_ISREG(path.lstat().st_mode), 'noncanonical_file')
+    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, 'rb') as stream:
+        before = os.fstat(stream.fileno())
+        require(stat.S_ISREG(before.st_mode), 'nonregular_file')
+        raw = stream.read(8 * 1024 * 1024 + 1) if retain else None
+        require(raw is None or len(raw) <= 8 * 1024 * 1024, 'oversized_manifest')
+        digest = (hashlib.sha256(raw) if retain else hashlib.file_digest(stream, 'sha256'))
+        require(digest.hexdigest() == expected, 'file_changed')
+        after = os.fstat(stream.fileno())
+    identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_size,
+                          s.st_mtime_ns, s.st_ctime_ns)
+    require(identity(before) == identity(after) == identity(path.stat()) and
+            path.resolve(strict=True) == path, 'file_replaced')
+    return raw
+
+
+def binding():
+    value = json.loads(check_file(str(HERE / 'dependency-view.json'), VIEW_SHA256, True))
+    validate(value)
+    require(PurePosixPath(value['account_state']).parent == PurePosixPath(str(HERE)),
+            'view_location')
+    return value
+
+
+def software_metadata(value):
+    names = [n for n in value['inputs'] if Path(n).name == 'HANDOFF-MANIFEST.json']
+    require(len(names) == 1, 'software_manifest')
+    name = names[0]
+    manifest = json.loads(check_file(name, value['inputs'][name], True))
+    entry = manifest['software-details.json']
+    path = str(Path(name).parent / 'software-details.json')
+    return json.loads(check_file(path, entry['sha256'], True))
+
+
+def verify_snapshot():
+    value = binding()
+    pins = dict(value['inputs'])
+    for row in value['mounts']:
+        require(pins.get(row['source'], row['sha256']) == row['sha256'], 'pin_conflict')
+        pins[row['source']] = row['sha256']
+    metadata = software_metadata(value)
+    require(type(metadata) is dict and set(metadata) <= set(pins), 'software_metadata')
+    for name, expected in pins.items():
+        check_file(name, expected)
+        if name in metadata:
+            actual, bound = Path(name).stat(), metadata[name]
+            require(actual.st_size == bound['size'] and
+                    oct(stat.S_IMODE(actual.st_mode)) == bound['mode'], 'software_metadata_changed')
+    for name, row in value['aliases'].items():
+        path = Path(name)
+        require(path.is_symlink() and oct(stat.S_IMODE(path.lstat().st_mode)) ==
+                row['mode'] and os.readlink(path) == row['target'], 'alias_changed')
+        require(str(path.resolve(strict=True)) == row['canonical_target'] and
+                (path.is_file() if row['kind'] == 'file' else path.is_dir()),
+                'alias_target_changed')
+
+
+def arguments(value):
+    directories = validate(value)
+    root = value['environment_root']
+    cache = root + '/cache/camoufox'
+    args = [part for name in MASKS for part in ('--tmpfs', name)]
+    args += ['--perms', '0700', '--tmpfs', root,
+             '--perms', '0700', '--dir', root + '/cache', '--tmpfs', cache]
+    existing = set(MASKS) | {root, root + '/cache', cache}
+    for name in sorted(directories - existing, key=lambda p: (p.count('/'), p)):
+        private = name in value['private_directories'] or name == value['account_state']
+        mode = '0700' if private else '0755'
+        args += ['--perms', mode, '--dir', name]
+    args += ['--perms', '0700', '--tmpfs', cache + '/fontconfig']
+    for row in value['mounts']:
+        args += ['--ro-bind', row['source'], row['target']]
+    for name, row in sorted(value['aliases'].items()):
+        args += ['--symlink', row['target'], name]
+    # Home/run/tmp are empty scaffolds for the owner's later writable mounts.
+    # Every selected software file is a separate read-only bind.
+    for name in ('/usr', cache):
+        args += ['--remount-ro', name]
+    for name, text in value['environment'].items():
+        args += ['--setenv', name, text]
+    return args
+
+
+def mounts():
+    args = arguments(binding())
+    for kind in ('net', 'pid'):
+        args += ['--setenv', 'CHECK_PARENT_' + kind.upper() + 'NS',
+                 os.readlink('/proc/self/ns/' + kind)]
+    args += ['--setenv', 'TOKIO_WORKER_THREADS', '2']
+    return args
