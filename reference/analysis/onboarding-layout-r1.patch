+"""Expose explicit control files and only the dedicated empty account store."""
+import json
+import os
+from pathlib import Path
+
+def extra_mounts(here):
+    here = Path(here).resolve(strict=True)
+    plan = json.loads((here/'launch-plan.json').read_text())
+    state = here/'private'
+    assert plan['private'] == str(state), 'account store changed'
+    info = state.lstat()
+    assert state.is_dir() and not state.is_symlink()
+    assert info.st_uid == os.getuid() and info.st_mode & 0o777 == 0o700
+    assert not any(state.iterdir()), 'account store not empty'
+    files = [here/name for name in ('lifecycle.py', 'layout.py', 'launch-plan.json')]
+    assert plan['control_files'] == [str(path) for path in files]
+    args = []
+    for path in files:
+        assert path.is_file() and not path.is_symlink()
+        args += ['--ro-bind', str(path), str(path)]
+    args += ['--bind', str(state), str(state)]
+    runtime = here/'onboarding-r1'
+    assert runtime.is_dir() and not runtime.is_symlink()
+    assert {path.name for path in runtime.iterdir()} <= {'receipt.json', 'tmp'}
+    assert not any((runtime/'tmp').iterdir()), 'runtime scratch not empty'
+    return args
