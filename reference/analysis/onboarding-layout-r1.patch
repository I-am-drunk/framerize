+"""Create only the fresh, task-owned onboarding directories at launch time."""
+import json
+import os
+from pathlib import Path
+
+def create(here):
+    here = Path(here).resolve(strict=True)
+    view = json.loads((here/'dependency-view.json').read_text())
+    state, environment = here/'private', here/'private-environment'
+    assert view['account_state'] == str(state)
+    assert view['environment_root'] == str(environment)
+    assert not os.path.lexists(state) and not os.path.lexists(environment)
+    state.mkdir(mode=0o700)
+    # Environment directories belong to the sandbox layout, never a host overlay.
