+"""Apply task-specific bounds to the accepted isolated process supervisor."""
+from pathlib import Path
+import hashlib
+import sys
+import types
+
+HERE = Path(__file__).resolve().parent
+BASE = HERE.parents[1]/'browserless-resume-20261020/run_offline.py'
+raw = BASE.read_bytes()
+if hashlib.sha256(raw).hexdigest() != 'b20a80807d89a81a5d308d0e4e3082c2c4d265b8aad4e2e0a8588e77e64bd61a':
+    raise RuntimeError('accepted runner changed')
+source = raw.decode()
+
+def replace(before, after):
+    global source
+    if source.count(before) != 1:
+        raise RuntimeError('runner insertion point changed')
+    source = source.replace(before, after)
+
+replace('framerize-browserless-{phase}-20261020-{attempt}.service',
+        'framerize-onboarding-{phase}-{attempt}.service')
+replace('"--new-session", "--clearenv",',
+        '"--new-session", "--unshare-pid", "--clearenv",')
+replace('contract["deadline_seconds"] <= 120',
+        'contract["deadline_seconds"] <= 600')
+replace('helper.Monitor(group, result, started + 120)',
+        'helper.Monitor(group, result, started + 600)')
+marker = '"--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",'
+replace(marker, marker + '\n                   *onboarding_mounts(),')
+
+runner = types.ModuleType('accepted_onboarding_runner')
+runner.__file__ = str(BASE)
+exec(compile(source, str(BASE), 'exec'), runner.__dict__)
+runner.HERE = HERE
+runner.LIMITS = {'onboarding': 1536 * 1024**2}
+
+def onboarding_mounts():
+    sys.path.insert(0, str(HERE))
+    from layout import mounts
+    from runtime_mounts import extra_mounts
+    return mounts() + extra_mounts(HERE)
+
+runner.onboarding_mounts = onboarding_mounts
+original_inputs = runner.inputs
+
+def checked_inputs(phase, attempt, expected):
+    manifest, contract = original_inputs(phase, attempt, expected)
+    sys.path.insert(0, str(HERE))
+    from layout import verify_snapshot
+    verify_snapshot()
+    return manifest, contract
+
+runner.inputs = checked_inputs
+original_run = runner.run
+
+def run(runtime, phase, attempt, expected, helper, started, result):
+    def protected_headroom():
+        values = {line.split(':')[0]: int(line.split()[1])*1024
+                  for line in Path('/proc/meminfo').read_text().splitlines()
+                  if line.startswith(('MemTotal:', 'MemAvailable:'))}
+        return values['MemAvailable'] - max(1667398860, values['MemTotal']//10)
+    helper.headroom = protected_headroom
+    memory = helper.memory
+    def sampled(group):
+        value = memory(group)
+        for name in ('pids.current', 'pids.max', 'pids.peak'):
+            value[name] = int((group/name).read_text())
+        value['pids.events'] = dict((k, int(v)) for k,v in
+            (line.split() for line in (group/'pids.events').read_text().splitlines()))
+        if value['pids.max'] != 256 or any(value['pids.events'].values()):
+            raise RuntimeError('task policy changed or exhausted')
+        return value
+    helper.memory = sampled
+    result['source_audited_intent'] = dict(separate_daemon=1,
+        automatic_login=0, automatic_inference=0, user_driven_onboarding=True)
+    result['containment_limit'] = (
+        'Shared network for loopback UI and normal login; private PID namespace, '
+        'cleared environment and masked host homes/run/temp. Exact software '
+        'read-only; only dedicated private state and bounded scratch writable. '
+        'Action counts describe supervisor intent, not user UI activity.')
+    return original_run(runtime, phase, attempt, expected, helper, started, result)
+
+runner.run = run
+if __name__ == '__main__':
+    raise SystemExit(runner.main())
