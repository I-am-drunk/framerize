+from pathlib import Path
+import datetime, hashlib, json, os, shutil, subprocess, sys, time
+HERE = Path(__file__).resolve().parent
+def process_identity(pid):
+    identity = {'pid': pid}
+    try:
+        raw = Path('/proc', str(pid), 'stat').read_text()
+        identity['start_time_ticks'] = int(raw.rsplit(')', 1)[1].split()[19])
+    except (FileNotFoundError, ProcessLookupError):
+        identity['exited_before_snapshot'] = True
+    return identity
+
+phase = sys.argv[1]
+contract_path = HERE / ('contract-' + phase + '-r1.json')
+manifest = HERE / ('inputs-' + phase + '-r1.json')
+contract = json.loads(contract_path.read_text())
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+out = HERE / (phase + '-outer-r1.json')
+assert not (HERE / (phase + '-spawn-r1.json')).exists(), 'capture already exists'
+assert not out.exists() and not (HERE / (phase + '-r1')).exists(), 'attempt already consumed'
+memory = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
+available = int(memory['MemAvailable'].split()[0]) * 1024
+free = shutil.disk_usage(HERE).free
+headroom = available - max(1667398860, int(memory['MemTotal'].split()[0]) * 1024 // 10)
+assert headroom >= contract['memory_max_bytes'] + 512 * 1024**2, 'insufficient memory reserve'
+assert free > 1024**3, 'insufficient disk reserve'
+argv = contract['argv_without_manifest_digest'] + [sha(manifest)]
+result = dict(started_at=datetime.datetime.now(datetime.timezone.utc).isoformat(), argv=argv,
+    manifest_sha256=sha(manifest), contract_sha256=sha(contract_path),
+    admission_host_headroom_bytes=headroom, admission_disk_bytes=free)
+assert phase == 'onboarding', 'unexpected launch phase'
+sys.path.insert(0, str(HERE))
+from create_private import create
+create(HERE)
+(HERE / (phase + '-r1')).mkdir(mode=0o700)
+started = time.monotonic()
+with (HERE / (phase + '-outer-r1.log')).open('xb') as log:
+    with (HERE / (phase + '-spawn-r1.json')).open('x') as capture:
+        with subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT,
+                              env=os.environ | contract['environment']) as run:
+            try:
+                json.dump(dict(launcher=process_identity(os.getpid()),
+                    unit_client=process_identity(run.pid), argv=argv,
+                    manifest_sha256=sha(manifest)), capture, indent=2)
+                capture.write('\n')
+                capture.flush()
+                os.fsync(capture.fileno())
+                run.wait(timeout=max(0, contract['outer_timeout_seconds'] - (time.monotonic() - started)))
+            except BaseException:
+                run.kill()
+                run.wait()
+                raise
+result.update(exit_code=run.returncode, seconds=time.monotonic() - started,
+    finished_at=datetime.datetime.now(datetime.timezone.utc).isoformat())
+with out.open('x') as stream:
+    json.dump(result, stream, indent=2); stream.write('\n')
+print(json.dumps(dict(phase=phase, exit_code=run.returncode, seconds=result['seconds'])))
+raise SystemExit(run.returncode)
