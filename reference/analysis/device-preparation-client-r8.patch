+"""Disposable inputs and mocked boundaries for the R8 driver only."""
+import hashlib
+import io
+import json
+import runpy
+import tempfile
+import time
+from contextlib import ExitStack, contextmanager
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+import events
+import prepare
+import run_once as driver
+
+ROOT = Path(__file__).resolve().parent
+CHECK = runpy.run_path(str(driver.CLIENT))
+ACCOUNT = '11111111-1111-4111-8111-111111111111'
+SERVICE = dict(pid=424242, start=123, invocation_id='test-generation')
+
+def completion_rows():
+    return [dict(event='ai.post.started', path='/ai/v3/responses/',
+                 ts='2026-10-23T08:00:00.000Z'),
+            dict(event='ai.chain', account=ACCOUNT[:8], outcome='ok',
+                 chunks=1, metered_chunks=0, ts='2026-10-23T08:00:01.000Z')]
+
+def encode_rows(rows):
+    return b''.join(json.dumps(row).encode() + b'\n' for row in rows)
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+@contextmanager
+def case():
+    with tempfile.TemporaryDirectory() as folder, ExitStack() as stack:
+        root = Path(folder)
+        value = dict(account_id=ACCOUNT, request=dict(model='gpt-4.1', stream=False))
+        raw = json.dumps(value).encode()
+        (root / 'request.json').write_bytes(raw)
+        prior = root / 'prior.json'
+        prior.write_text(json.dumps(dict(service=SERVICE)))
+        for name in ('prepare.py', 'events.py'):
+            (root / name).write_bytes((ROOT / name).read_bytes())
+        log = root / '.framerize/profiles/.logs' / time.strftime('events-%Y-%m-%d.ndjson', time.gmtime())
+        log.parent.mkdir(parents=True)
+        log.write_bytes(encode_rows([dict(event='old.private.event', secret='old-secret')]))
+        response = Mock(status=200, length=0)
+        response.getheader.return_value = 'application/json'
+        response.isclosed.return_value = True
+        response.read.return_value = json.dumps(dict(id='private-response-id', status='completed',
+            output=[dict(text='private-response-text')], usage=dict(input_tokens=1, output_tokens=1))).encode()
+        connection = Mock()
+        connection.getresponse.return_value = response
+        current = Mock(return_value=dict(SERVICE))
+        client = dict(inspect_response=CHECK['inspect_response'], current_service=current,
+                      deployed=Mock(return_value=(dict(SERVICE), 'test-release')))
+        resident = dict(account=ACCOUNT, users=0, status='idle', replacement=None,
+                        close_started=False, uncertain=False)
+        before = dict(workspaces=[dict(accounts=[dict(account_id=ACCOUNT, available=True)])],
+                      residency=dict(residents=[]))
+        ready = dict(residency=dict(residents=[resident]))
+        parked = dict(account_id=ACCOUNT, status='parked')
+        after = dict(residency=dict(residents=[]))
+        state = SimpleNamespace(root=root, raw=raw, log=log, response=response,
+            connection=connection, current=current, client=client, before=before,
+            ready=ready, resident=resident, parked=parked, after=after,
+            rows=completion_rows(), environment=b'FRAMERIZE_ALLOW_METERED=0\0',
+            report=dict(preparation_post_calls=0, park_calls=0, client_started=False, accepted=False))
+        def send(*_args, **_kwargs):
+            with log.open('ab') as stream:
+                stream.write(encode_rows(state.rows))
+        connection.request.side_effect = send
+        original_open = Path.open
+        def open_file(path, *args, **kwargs):
+            if str(path) == '/proc/424242/environ':
+                return io.BytesIO(state.environment)
+            assert not str(path).startswith('/proc/'), 'unexpected process input'
+            return original_open(path, *args, **kwargs)
+        def load(path):
+            path = Path(path)
+            if path == driver.CLIENT:
+                return client
+            if path == root / 'prepare.py':
+                return vars(prepare)
+            if path == ROOT / 'events.py':
+                return vars(events)
+            raise AssertionError('unexpected module load')
+        stack.enter_context(patch.multiple(driver, HERE=root, PRIOR=prior,
+            PRIOR_SHA=digest(prior), REQUEST_SHA=digest(root / 'request.json')))
+        stack.enter_context(patch.object(Path, 'home', return_value=root))
+        stack.enter_context(patch.object(Path, 'open', open_file))
+        stack.enter_context(patch.object(runpy, 'run_path', side_effect=load))
+        stack.enter_context(patch.object(prepare.http.client, 'HTTPConnection', return_value=connection))
+        state.pool = stack.enter_context(patch.object(driver, 'call', side_effect=[before, ready, parked, after]))
+        state.native = stack.enter_context(patch.object(driver.subprocess, 'run', return_value=SimpleNamespace(returncode=0)))
+        yield state
