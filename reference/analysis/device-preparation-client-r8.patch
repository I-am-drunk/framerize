+import json
+import unittest
+from contextlib import closing
+from client_fixture import ACCOUNT, case, completion_rows, encode_rows
+import events
+
+class EventTests(unittest.TestCase):
+    def test_only_new_interval_is_reported_without_private_fields(self):
+        with case() as state:
+            observation = events.start()
+            with closing(observation[0]), state.log.open('ab') as output:
+                output.write(encode_rows(state.rows)); output.flush()
+                result = events.confirm(observation, ACCOUNT)
+            self.assertTrue(result['same_account'])
+            self.assertEqual(result['observed_starts'], 1)
+            self.assertNotIn(ACCOUNT, json.dumps(result))
+            self.assertNotIn('secret', json.dumps(result))
+
+    def test_ambiguous_or_unpaid_proof_missing_is_rejected(self):
+        start, complete = completion_rows()
+        cases = [
+            ('no_start', [complete]), ('no_completion', [start]),
+            ('two_starts', [start, start, complete]),
+            ('two_completions', [start, complete, complete]),
+            ('metered', [start, complete | {'metered_chunks': 1}]),
+            ('continuation', [start, complete | {'chunks': 2}]),
+            ('wrong_account', [start, complete | {'account': '99999999'}]),
+            ('failed', [start, complete | {'outcome': 'error'}]),
+            ('repick', [start, dict(event='ai.chain.repick'), complete]),
+            ('wrong_path', [start | {'path': '/other'}, complete]),
+            ('reversed', [complete, start]),
+            ('invalid_time', [start | {'ts': 'private-data'}, complete]),
+        ]
+        for name, rows in cases:
+            with self.subTest(name=name), case() as state:
+                observation = events.start()
+                with closing(observation[0]), state.log.open('ab') as output:
+                    output.write(encode_rows(rows)); output.flush()
+                    with self.assertRaises(AssertionError):
+                        events.confirm(observation, ACCOUNT)
+
+    def test_rotated_log_is_rejected(self):
+        with case() as state:
+            observation = events.start()
+            with closing(observation[0]):
+                state.log.rename(state.log.with_suffix('.old'))
+                state.log.write_bytes(encode_rows(state.rows))
+                with self.assertRaisesRegex(AssertionError, 'event path changed'):
+                    events.confirm(observation, ACCOUNT)
+
+    def test_partial_oversized_or_truncated_interval_is_rejected(self):
+        for name in ('partial', 'oversized', 'truncated'):
+            with self.subTest(name=name), case() as state:
+                observation = events.start()
+                with closing(observation[0]):
+                    if name == 'truncated':
+                        state.log.write_bytes(b'')
+                    else:
+                        content = encode_rows(state.rows)[:-1] if name == 'partial' else b'x' * (1024**2 + 1)
+                        with state.log.open('ab') as output:
+                            output.write(content)
+                    with self.assertRaises(AssertionError):
+                        events.confirm(observation, ACCOUNT)
+
+    def test_symlink_event_input_is_not_opened(self):
+        with case() as state:
+            target = state.root / 'other-log'
+            state.log.rename(target)
+            state.log.symlink_to(target)
+            with self.assertRaises(OSError):
+                events.start()
