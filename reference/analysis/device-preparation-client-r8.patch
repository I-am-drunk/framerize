+import io
+import json
+import unittest
+from unittest.mock import patch
+from client_fixture import ACCOUNT, SERVICE, case
+import run_once as driver
+
+class DriverTests(unittest.TestCase):
+    def test_completed_free_preparation_precedes_park_and_native(self):
+        with case() as state:
+            driver.run(state.report)
+            self.assertTrue(state.report['accepted'])
+            self.assertEqual(state.report['preparation_post_calls'], 1)
+            self.assertEqual(state.report['park_calls'], 1)
+            state.connection.request.assert_called_once()
+            state.connection.close.assert_called_once()
+            state.native.assert_called_once()
+            self.assertEqual(state.native.call_args.kwargs['input'], state.raw)
+            self.assertNotIn('private-response', json.dumps(state.report))
+            args = state.connection.request.call_args.args
+            self.assertEqual(args[:2], ('POST', '/openai/v1/responses'))
+            self.assertEqual(json.loads(args[2])['max_output_tokens'], 16)
+            self.assertEqual(args[3]['x-framerize-mode'], 'free')
+            self.assertEqual(args[3]['x-framerize-account'], ACCOUNT)
+
+    def test_unavailable_or_owned_account_sends_nothing(self):
+        for reason in ('unavailable', 'busy', 'uncertain', 'closing'):
+            with self.subTest(reason=reason), case() as state:
+                if reason == 'unavailable':
+                    state.before['workspaces'][0]['accounts'][0]['available'] = False
+                else:
+                    key = {'busy': 'users', 'uncertain': 'uncertain', 'closing': 'close_started'}[reason]
+                    state.before['residency']['residents'] = [state.resident | {key: 1}]
+                with self.assertRaises(AssertionError):
+                    driver.run(state.report)
+                state.connection.request.assert_not_called()
+                state.native.assert_not_called()
+
+    def test_changed_binding_or_generation_never_sends(self):
+        for reason in ('changed_prior', 'changed_helper', 'changed_request', 'changed_generation'):
+            with self.subTest(reason=reason), case() as state:
+                if reason == 'changed_prior':
+                    (state.root / 'prior.json').write_text('{}')
+                elif reason == 'changed_helper':
+                    (state.root / 'prepare.py').write_text('changed')
