+"""Establish the existing account's actual browser selection before parking."""
+import http.client
+import json
+import runpy
+import time
+import uuid
+from pathlib import Path
+
+
+def prepare(client, raw, report):
+    value = json.loads(raw)
+    account = value['account_id']
+    service = report['service']
+    assert client['current_service']() == service, 'service changed before preparation'
+    with Path('/proc', str(service['pid']), 'environ').open('rb') as stream:
+        environment = stream.read(262145)
+    assert len(environment) <= 262144, 'environment exceeds preparation bound'
+    assert b'FRAMERIZE_ALLOW_METERED=1' not in environment.split(b'\0'), 'metered fallback enabled'
+    payload = dict(model=value['request']['model'], input='Reply with OK.',
+                   stream=False, max_output_tokens=16)
+    headers = {'Content-Type': 'application/json', 'x-framerize-mode': 'free',
+               'x-framerize-account': account, 'x-framerize-session': str(uuid.uuid4())}
+    connection = http.client.HTTPConnection('127.0.0.1', 8787, timeout=65)
+    events = runpy.run_path(str(Path(__file__).with_name('events.py')))
+    observation = events['start']()
+    started = time.monotonic()
+    report['preparation_post_calls'] = 0
+    try:
+        report['preparation_post_calls'] += 1
+        connection.request('POST', '/openai/v1/responses', json.dumps(payload), headers)
+        response = connection.getresponse()
+        body = response.read(65537)
+        assert len(body) <= 65536, 'preparation response exceeds bound'
+        assert response.length in (None, 0), 'preparation framing incomplete'
+        if not response.isclosed():
+            assert response.read(1) == b'', 'preparation framing incomplete'
+        assert response.isclosed(), 'preparation connection incomplete'
+        prepared = client['inspect_response'](response.status,
+            response.getheader('Content-Type', ''), body, '/ai/v3/responses/')
+        prepared.update(elapsed_seconds=time.monotonic() - started,
+            http_framing_complete=True)
+        report['preparation'] = prepared
+        assert prepared.get('complete_json') is True and response.status == 200, 'preparation did not complete'
+        prepared['events'] = events['confirm'](observation, account)
+    finally:
+        connection.close()
+        observation[0].close()
+    assert client['current_service']() == service, 'service changed during preparation'
