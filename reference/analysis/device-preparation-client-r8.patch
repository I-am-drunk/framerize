+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+GROUP = Path('/sys/fs/cgroup' + Path('/proc/self/cgroup').read_text().split('0::', 1)[1].strip())
+LIMITS = {name: (GROUP / name).read_text().strip()
+          for name in ('memory.max', 'memory.swap.max', 'pids.max')}
+assert LIMITS == {'memory.max': '134217728', 'memory.swap.max': '0', 'pids.max': '16'}
+assert sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode and not sys.flags.optimize
+def pins():
+    paths = sorted(HERE.glob('*.py')) + [HERE.parent / 'offline-serving-client-check-r14/check.py', Path('/proc/self/exe')]
+    return {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
+
+def names(suite):
+    for test in suite:
+        if isinstance(test, unittest.TestSuite):
+            yield from names(test)
+        else:
+            yield test.id()
+
+before = pins()
+started = time.monotonic()
+with patch('socket.socket', side_effect=AssertionError('fixture network forbidden')), \
+     patch('subprocess.Popen', side_effect=AssertionError('fixture process launch forbidden')):
+    suite = unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromName(name)
+                               for name in ('test_driver', 'test_events'))
+    cases = sorted(names(suite))
+    assert len(cases) == len(set(cases)) == 16
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+after = pins()
+passed = result.wasSuccessful() and not result.skipped and result.testsRun == 16 and before == after
+report = dict(accepted=passed, tests_run=result.testsRun, cases=cases,
+    errors=len(result.errors), failures=len(result.failures), skipped=len(result.skipped),
+    before=before, after=after, limits=LIMITS, cgroup=str(GROUP),
+    elapsed_seconds=time.monotonic() - started,
+    max_rss_kib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
+    network_and_process_launches_forbidden=True)
+report['counters'] = {name: (GROUP / name).read_text().strip() for name in
+    ('memory.peak', 'memory.events', 'memory.swap.peak', 'pids.peak', 'pids.events')}
+with (HERE / 'validation.json').open('x') as output:
+    json.dump(report, output, sort_keys=True, indent=2)
+    output.write('\n')
+print(json.dumps(dict(accepted=passed, tests_run=result.testsRun)))
+raise SystemExit(0 if passed else 1)
