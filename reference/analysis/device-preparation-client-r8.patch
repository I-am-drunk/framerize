+import subprocess
+import time
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+UNIT = 'framerize-client-r8-fixture-20261023'
+mem = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
+available = int(mem['MemAvailable'].split()[0]) * 1024
+free = shutil.disk_usage(HERE).free
+assert available >= 512 * 1024**2, 'fixture memory reserve'
+assert free >= 1024**3, 'fixture disk reserve'
+paths = sorted(HERE.glob('*.py')) + [Path('/usr/bin/python3').resolve(),
+    HERE.parent / 'offline-serving-client-check-r14/check.py']
+pins = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
+def save(name, value):
+    with (HERE / name).open('x') as output:
