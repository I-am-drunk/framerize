+                adapter.sha(adapter.DEST) == adapter.OLD_BIN and
+                adapter.sha(adapter.SIDECAR) == adapter.OLD_PY, 'original files changed')
+        adapter.runtime_config.verify_process(adapter, before['main']['pid'], old=True)
+        return None
+    record = adapter.document(adapter.RECEIPT)
+    require(adapter.same_processes(before, record['current']), 'candidate generation changed')
+    adapter.runtime_config.verify_process(adapter, before['main']['pid'], old=False)
