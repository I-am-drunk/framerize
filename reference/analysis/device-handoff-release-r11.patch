+def bind_runtime(adapter, data, runtime, inputs):
+    require, document, pinned = adapter.require, adapter.document, adapter.pinned
+    origins = document(adapter.HERE / 'origins.json')
+    require(data['device_handoff_review'] == origins['device_handoff_review'],
+            'device handoff review differs')
+    review = document(pinned(data['device_handoff_review']))
+    require(review['accepted'] is True and
+            review['status'] == 'ACCEPTED_SOURCE_AND_SAVED_EVIDENCE_ONLY' and
+            review['source'] == origins['device_handoff_source'] and
+            review['result'] == origins['device_handoff_result'],
+            'device handoff is not independently accepted')
+    for row in (review['source'], review['result'], review['adapter']):
+        inputs[str(pinned(row))] = row['sha256']
+    original = document(pinned(runtime['manifest']))
+    current = document(pinned(data['cooldown_runtime']))
+    require(current == dict(original, **{'native_device.py': review['adapter']['sha256']}),
+            'runtime differs beyond the accepted native device adapter')
+    require(runtime['sidecar']['sha256'] == adapter.OLD_PY,
+            'runtime parent is not the installed baseline')
+    previous = pinned(runtime['sidecar']).read_bytes()
+    old_hash = runtime['manifest']['sha256'].encode()
+    new_hash = data['cooldown_runtime']['sha256'].encode()
+    old_name = b'cooldown-support-' + old_hash[:16]
+    new_name = b'cooldown-support-' + new_hash[:16]
+    require(previous.count(old_hash) == previous.count(old_name) == 1,
+            'runtime parent has an ambiguous support binding')
+    expected = previous.replace(old_hash, new_hash).replace(old_name, new_name)
+    require(pinned(data['cooldown_sidecar']).read_bytes() == expected,
+            'generated host differs beyond the support binding')
+
 
