@@ -0,0 +1,30 @@
+"""Rejected requests must not put arbitrary repick reasons in saved reports."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from events import Events
+
+class EventPrivacyTests(unittest.TestCase):
+    def test_raw_reasons_are_omitted_and_admission_codes_remain(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'events.ndjson'
+            path.touch()
+            events = Events(path)
+            try:
+                rows = [dict(event='ai.chain.repick', reason='private-repick-sentinel'),
+                        dict(event='operation.admission.refused', reason='private-code-sentinel'),
+                        dict(event='operation.admission.refused', reason='Unconfirmed',
+                             active=1, sealed=False, unconfirmed=True)]
+                path.write_text(''.join(json.dumps(row) + '\n' for row in rows))
+                events.poll()
+                report = json.dumps(dict(accepted=False, events=events.public))
+                self.assertNotIn('private-repick-sentinel', report)
+                self.assertNotIn('private-code-sentinel', report)
+                self.assertNotIn('reason', events.public[0])
+                self.assertNotIn('reason', events.public[1])
+                self.assertEqual(events.public[2]['reason'], 'Unconfirmed')
+                self.assertEqual(events.count('ai.chain.repick'), 1)
+                self.assertEqual(events.count('operation.admission.refused'), 2)
+            finally:
+                events.stream.close()
