+"""Consume the saved validation shape without reading installed inputs."""
+import contextlib
+import json
+from pathlib import Path
+import tempfile
+import time
+import unittest
+import run
+
+class ControlTests(unittest.TestCase):
+    @contextlib.contextmanager
+    def fixture(self, accepted=True, matching=True):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            def save(name, value):
+                path = root / name
+                path.write_text(json.dumps(value))
+                return dict(path=str(path), sha256=run.sha(path))
+            saved = json.loads((run.HERE / 'validation-1792765724455617944.json').read_text())
+            saved['accepted'] = accepted
+            validation = save('validation.json', saved)
+            inputs = save('inputs.json', {})
+            paths = [run.HERE / name for name in ('run.py', 'runtime.py', 'verification.py')]
+            files = {str(path): run.sha(path) for path in paths}
+            files[inputs['path']] = inputs['sha256']
+            freeze = save('freeze.json', dict(files=files, inputs=inputs, validation=validation))
+            review = save('review.json', dict(accepted=True,
+                status='ACCEPTED_FOR_OWNED_RECOVERY_HOLD_RELEASE', freeze=freeze,
