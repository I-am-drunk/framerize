+"""Verify and release one completed rollback; never launch or stop a service."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+def pin(path):
+    return dict(path=str(Path(path).resolve(strict=True)), sha256=sha(path))
+
+def read(bound):
+    path = Path(bound['path'])
+    require(path.is_absolute() and sha(path) == bound['sha256'], 'bound evidence changed')
+    require(path.stat().st_size <= 4 * 1024**2, 'oversized evidence')
+    return json.loads(path.read_bytes())
+
+def save(name, value):
+    fd = os.open(HERE / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, 'w') as stream:
+        json.dump(value, stream, sort_keys=True, indent=2, allow_nan=False)
+        stream.write('\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+def controller_absent(outer):
+    require(re.fullmatch(r'framerize-r18-recover-[0-9a-f]{12}', outer['unit']), 'wrong controller unit')
+    require(outer['exit_code'] == 1 and not outer['errors'] and outer['command_joined']
+            and outer['unit_absent'] and outer['cgroup_absent'], 'controller teardown is unconfirmed')
+    unit = outer['unit'] + '.service'
+    raw = subprocess.check_output(['systemctl', '--user', 'show', unit, '-p',
+        'MainPID,ActiveState,Job,ControlGroup'], text=True, timeout=5)
+    state = dict(row.split('=', 1) for row in raw.splitlines())
+    require(state['MainPID'] == '0' and state['ActiveState'] in ('inactive', 'failed')
+        and state['Job'] in ('', '0', '0 /', '[not set]') and not state['ControlGroup'],
+        'controller is not absent')
+    require(not Path('/proc', str(outer['command_pid'])).exists(), 'controller command PID exists')
+    base = Path('/sys/fs/cgroup/user.slice') / f'user-{os.getuid()}.slice' / f'user@{os.getuid()}.service/app.slice'
+    require(not (base / unit).exists(), 'controller cgroup exists')
+
+def prepare(freeze):
+    inputs = read(freeze['inputs'])
+    require(inputs['purpose'] == 'VERIFY_AND_RELEASE_COMPLETED_ROLLBACK_ONLY', 'wrong recovery scope')
+    documents = {name: read(value) for name, value in inputs['pins'].items()}
+    plan, review = documents['plan'], documents['plan_review']
+    require(review.get('accepted') is True and review.get('status') == 'ACCEPTED_FOR_COORDINATED_ACTIVATION'
+        and review['plan_sha256'] == inputs['pins']['plan']['sha256'], 'deployment review differs')
+    for name in ('sources', 'evidence'):
+        for path, digest in plan[name].items():
+            require(sha(path) == digest, 'accepted deployment input changed')
+    root = Path(inputs['deployment'])
+    sys.path.insert(0, str(root))
+    sys.path.insert(0, str(root / 'controller'))
+    import recovery_binding as binding
+    binding.checked_plan(inputs['pins']['plan'], inputs['pins']['plan_review'])
+    controller_absent(documents['outer'])
+    return bind(freeze, inputs, documents, plan, root, binding)
+
+def bind(freeze, inputs, documents, plan, root, binding):
+    record, result, state, outer = [documents[k] for k in ('record', 'result', 'state', 'outer')]
+    require(record['status'] == result['status'] == state['status'] ==
+            'rolled_back_pending_independent_verification', 'rollback is not complete')
+    require(result['attempts'] == state['attempts'] == ['activate', 'rollback'], 'unexpected attempts')
+    require([a['direction'] for a in record['startup_attempts']] == ['candidate', 'rollback']
+            and 'completion' not in record['startup_attempts'][0], 'startup history differs')
+    require(result['adapter_receipt'] == inputs['pins']['record'], 'rollback record differs')
+    require(state['maintenance'] == result['maintenance'] and
+            state['launch_capture'] == inputs['pins']['capture'], 'controller state binding differs')
+    require(outer['plan'] == inputs['pins']['plan'] and outer['review'] == inputs['pins']['plan_review'],
+            'outer execution binding differs')
+    require(documents['sequence']['client_started'] is False, 'client unexpectedly ran')
+    names = ('window', 'control', 'recovery_identity', 'adapter', 'cooldown_transfer', 'observer', 'restoration')
+    loaded = {name: binding.module(name, plan['modules'][name]) for name in names}
+    verify_path = str(HERE / 'verification.py')
+    loaded['verification'] = binding.module('rollback_verification',
+        dict(path=verify_path, sha256=freeze['files'][verify_path]))
+    adopt = binding.module('rollback_adopt', dict(path=str(root / 'adopt.py'),
+        sha256=plan['sources'][str(root / 'adopt.py')]))
+    require(loaded['recovery_identity'].identity() == documents['producer'], 'recovery producer changed')
+    cls = loaded['recovery_identity'].bound_controls(loaded['control'].Controls, documents['producer'])
+    cls = adopt.adopted_controls(cls, state['maintenance'], loaded['control'].MARKER)
+    sources = dict(plan['sources']) | plan['evidence'] | freeze['files']
+    sources.update({value['path']: value['sha256'] for value in inputs['pins'].values()})
+    controls = cls(outer['coordination'], sources)
+    controls.acquire()
+    try:
+        controls.wait_guard()
+        adapter = loaded['adapter']
+        require(adapter.RECEIPT == Path(inputs['pins']['record']['path']), 'wrong adapter record')
+        adapter.TRANSFER = loaded['cooldown_transfer'].Transfer(adapter)
+        bound = adapter.release(plan['release'])
+        return dict(inputs=inputs, documents=documents, plan=plan, loaded=loaded,
+                    controls=controls, adapter=adapter, bound=bound, record=record)
+    except BaseException:
+        os.close(controls._marker_fd)
+        controls._marker_fd = None
+        raise
+
+def inspect(context):
+    adapter, controls = context['adapter'], context['controls']
+    loaded, record = context['loaded'], context['record']
+    observed = loaded['verification'].inspect(adapter, adapter.accepted_base(),
+        context['bound'], controls, loaded, record)
+    controls.assert_restart_excluded(observed['current'])
+    controller_absent(context['documents']['outer'])
+    return observed
+
+def close(context):
+    controls = context['controls']
+    if getattr(controls, '_marker_fd', None) is not None:
+        os.close(controls._marker_fd)
+        controls._marker_fd = None
+
+def barrier(context, observed):
+    adapter, controls = context['adapter'], context['controls']
+    controls.assert_held()
+    current = adapter.snapshot(adapter.accepted_base())
+    require(adapter.same_processes(current, observed['current']), 'recovered generation changed')
+    require(current['main']['exe_sha256'] == sha(adapter.DEST) == adapter.OLD_BIN and
+            sha(adapter.SIDECAR) == adapter.OLD_PY, 'recovered executable or host changed')
+    adapter.runtime_config.verify_process(adapter, current['main']['pid'], old=True)
+    require(adapter.protected(context['bound'], current['main']['pid']) == observed['protected'],
+            'protected inputs changed before mutation')
+    metrics = context['loaded']['verification'].no_swap(current)
+    live = adapter.observe_live_state(context['record']['stops'][-1])
+    adapter.verify_pool(context['record'])
+    adapter.require_idle_residency(context['record']['pool_residency'])
+    controls.assert_restart_excluded(current)
+    controller_absent(context['documents']['outer'])
+    return dict(current=current, metrics=metrics, live_state=live)
+
+def release(context, observed, review_pin, freeze_pin):
+    controls, adapter = context['controls'], context['adapter']
+    intent = dict(at_unix=time.time(), review=review_pin, freeze=freeze_pin,
+        inputs=context['inputs']['pins'], observed=observed,
+        marker_identity=controls.marker_identity, marker_sha256=controls.marker_sha256,
+        browserless_accepted=False, admission_repair_accepted=False)
+    save('release-intent.json', intent)
+    first = barrier(context, observed)
+    cleared = context['loaded']['restoration'].clear_verified(adapter,
+        context['record'], first['current'])
+    save('cleared-handoff.json', cleared)
+    final = barrier(context, observed)
+    controls.release_verified = True
+    controls.release()
+    require(not context['loaded']['control'].MARKER.exists(), 'maintenance marker remains')
+    result = intent | dict(final=final, accepted=True, marker_absent=True,
+        status='VERIFIED_ROLLBACK_HOLD_RELEASED', completed_at_unix=time.time())
+    save('released.json', result)
+    return result
+
