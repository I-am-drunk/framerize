+"""One coordinated rollback verification and release, with owner silence."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import resource
+import signal
+import sys
+import time
+import traceback
+
+HERE = Path(__file__).resolve().parent
+PEERS = {'466b6e5b-4733-4325-b5c4-fb2eac98b835',
+         'mcp:5f12e90a-05fe-4ae9-ad74-80288a94c597',
+         '0b8f0573-c8fd-4bd6-a241-d202430fdc9c',
+         'mcp:28c55101-e602-443c-a616-db31e42ee907'}
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+def read(pin):
+    path = Path(pin['path'])
+    assert path.is_absolute() and sha(path) == pin['sha256'], 'bound input changed'
+    assert path.stat().st_size <= 4 * 1024**2, 'oversized control input'
+    return json.loads(path.read_bytes())
+
+def checked(control):
+    assert len(control['peers']) == 4 and {p['thread_id'] for p in control['peers']} == PEERS
+    now = time.time()
+    for peer in control['peers']:
+        assert peer['message_id'] and peer['ack_at_unix'] <= now
+        assert peer['quiet_until_unix'] >= control['quiet_until_unix']
+    assert now + 400 < control['quiet_until_unix'], 'quiet window too short'
+    freeze, review = read(control['freeze']), read(control['review'])
+    assert review.get('accepted') is True
+    assert review.get('status') == 'ACCEPTED_FOR_OWNED_RECOVERY_HOLD_RELEASE'
+    assert review.get('freeze') == control['freeze']
+    assert review.get('validation') == freeze['validation']
+    for path, digest in freeze['files'].items():
+        assert Path(path).is_absolute() and sha(path) == digest, 'recovery source changed'
+    assert freeze['files'].get(str(Path(__file__).resolve())) == sha(__file__)
+    assert freeze['files'].get(str(HERE / 'runtime.py')) == sha(HERE / 'runtime.py')
+    assert freeze['files'].get(str(HERE / 'verification.py')) == sha(HERE / 'verification.py')
+    assert freeze['files'].get(freeze['inputs']['path']) == freeze['inputs']['sha256']
+    read(freeze['inputs'])
+    assert read(freeze['validation']).get('accepted') is True
+    return freeze
+
+def main():
+    assert sys.argv[1:2] == ['--execute'] and len(sys.argv) == 3 and not sys.flags.optimize
+    os.umask(0o077)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+    def expired(_signal, _frame):
+        raise TimeoutError('bounded recovery deadline')
+    def cancelled(_signal, _frame):
+        raise InterruptedError('recovery cancellation requested')
+    signal.signal(signal.SIGALRM, expired)
+    for number in (signal.SIGINT, signal.SIGTERM):
+        signal.signal(number, cancelled)
+    signal.alarm(360)
+    fd = os.open(HERE / 'run-result.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    report = dict(accepted=False, started_at_unix=time.time(), control_sha256=sys.argv[2])
+    context = None
+    try:
+        control = read(dict(path=str(HERE / 'control.json'), sha256=sys.argv[2]))
+        freeze = checked(control)
+        report['phase'] = 'owner_quiet_settling'
+        print(json.dumps(dict(phase=report['phase'], seconds=45)), flush=True)
+        time.sleep(45)
+        checked(control)
+        sys.path.insert(0, str(HERE))
+        import runtime
+        report['phase'] = 'verifying_rollback'
+        context = runtime.prepare(freeze)
+        observed = runtime.inspect(context)
+        runtime.save('inspection.json', dict(observed, at_unix=time.time(),
+            status='VERIFIED_ROLLBACK_PENDING_HOLD_RELEASE', freeze=control['freeze']))
+        report['phase'] = 'releasing_verified_rollback'
+        runtime.release(context, observed, control['review'], control['freeze'])
+        report.update(accepted=True, phase='released', released=dict(
+            path=str(HERE / 'released.json'), sha256=sha(HERE / 'released.json')))
+    except BaseException as error:
+        report['error_type'] = type(error).__name__
+        report['error_frames'] = [dict(file=Path(f.filename).name, line=f.lineno,
+            function=f.name) for f in traceback.extract_tb(error.__traceback__)]
+    finally:
+        signal.alarm(0)
+        if context is not None:
+            try:
+                runtime.close(context)
+            except Exception as error:
+                report.update(accepted=False, cleanup_error_type=type(error).__name__)
+        report['finished_at_unix'] = time.time()
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(report, stream, sort_keys=True, indent=2)
+            stream.write('\n')
+            stream.flush()
+            os.fsync(stream.fileno())
+    print(json.dumps(report), flush=True)
+    return 0 if report['accepted'] else 1
+
+if __name__ == '__main__':
+    raise SystemExit(main())
