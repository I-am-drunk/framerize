+"""Read-only verification of the restored generation using accepted checks."""
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+from recovery_binding import require, save, sha
+
+
+def pin(path):
+    return dict(path=str(path), sha256=sha(path))
+
+
+def metrics(current):
+    root = Path('/sys/fs/cgroup' + current['cgroup'])
+    return {name: (root / name).read_text().strip() for name in (
+        'memory.current', 'memory.peak', 'memory.swap.current',
+        'memory.swap.peak', 'memory.swap.max', 'memory.events')}
+
+
+def no_events(values):
+    require(all(row.split()[1] == '0' for row in values['memory.events'].splitlines()),
+            'service resource event detected')
+
+
+def no_swap(current):
+    values = metrics(current)
+    no_events(values)
+    require(values['memory.swap.current'] == values['memory.swap.peak'] == '0',
+            'service has current or historical swap')
+    return values
+
+
+def startup_bytes(adapter, observer, attempt):
+    before, after = attempt['boundary']['log'], attempt['completion']['event_log']
+    for key in ('device', 'inode', 'start_offset'):
+        require(before[key] == after[key], 'startup log boundary differs')
+    count = after['end_offset'] - after['start_offset']
+    require(0 < count == after['bytes'] <= 8*1024**2, 'invalid startup byte span')
+    path = adapter.PROFILES/'.logs'/('events-'+attempt['boundary']['event_day']+'.ndjson')
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(fd)
+        require((info.st_dev, info.st_ino) == (after['device'], after['inode']),
+                'startup log inode differs')
+        raw = os.pread(fd, count, after['start_offset'])
+        require(len(raw) == count and raw.endswith(b'\n'), 'incomplete startup span')
+        require(hashlib.sha256(raw).hexdigest() == after['sha256'], 'startup bytes changed')
+    finally:
+        os.close(fd)
+    coverage = observer.Coverage(attempt['plan'])
+    for line in raw.splitlines():
+        require(len(line) <= 65536, 'oversized startup event')
+        coverage.observe(json.loads(line))
+    require(coverage.complete(), 'startup event coverage is incomplete')
+    return dict(log=after, daemon_starts=coverage.daemon_starts,
+                successful_account_prefixes=coverage.seen)
+
+
+def inspect(adapter, base, bound, controls, loaded, record):
+    current = adapter.snapshot(base)
+    require(adapter.same_processes(current, record['current']), 'deployed generation changed')
+    require(current['main']['exe_sha256'] == sha(adapter.DEST) == adapter.OLD_BIN
+            and sha(adapter.SIDECAR) == adapter.OLD_PY == adapter.NEW_PY,
+            'installed binary or preserved host differs')
+    adapter.runtime_config.verify_process(adapter, current['main']['pid'], old=True)
+    require(adapter.protected(bound, current['main']['pid']) == record['protected'],
+            'protected state changed')
+    require(len(record['stops']) == len(record['startup_attempts']) == 2,
+            'unexpected restart count')
+    stopped, attempt = record['stops'][-1], record['startup_attempts'][-1]
+    adapter.require_settlement(stopped, stopped['settlement'], after_start=True)
+    live_state = adapter.observe_live_state(stopped)
+    adapter.verify_pool(record)
+    adapter.require_idle_residency(record['pool_residency'])
+    for key in ('plan', 'boundary'):
+        require(hashlib.sha256(json.dumps(attempt[key], sort_keys=True).encode()).hexdigest()
+                == attempt[key + '_sha256'], 'startup object hash differs')
+    restoration = loaded['restoration'].verify_restored(adapter, record, current)
+    coverage = startup_bytes(adapter, loaded['observer'], attempt)
+    completion = attempt['completion']
+    require(completion['main'] == current['main'] and completion['invocation_id'] ==
+            current['service']['InvocationID'], 'startup generation differs')
+    require(completion['plan_sha256'] == attempt['plan_sha256'] and
+            completion['boundary_sha256'] == attempt['boundary_sha256'], 'startup binding differs')
+    require(completion['daemon_start_count'] == 1 and completion['terminals'] ==
+            [dict(account_id=a, outcome='ok') for a in attempt['plan']['expected_accounts']],
+            'startup terminals differ')
+    values = no_swap(current)
+    controls.assert_held()
+    require(adapter.same_processes(current, adapter.snapshot(base)),
+            'service changed during verification')
+    return dict(current=current, startup=coverage, pool=record['pool_verified'],
+        metrics=values, live_state=live_state, pool_residency=record['pool_residency'],
+        cooldown_restoration=restoration, protected=record['protected'])
+
