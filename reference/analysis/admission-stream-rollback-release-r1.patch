+"""Inert checks of the two mutation barriers. No installed inputs are read."""
+import contextlib
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+import runtime
+
+class ReleaseTests(unittest.TestCase):
+    @contextlib.contextmanager
+    def fixture(self, *, bad_protection=None, changed_generation=None, swap=False):
+        events, calls = [], {'snapshot': 0, 'protected': 0}
+        current = {'main': {'pid': 7, 'exe_sha256': 'old'}, 'generation': 'fixed'}
+        def snapshot(_base):
+            calls['snapshot'] += 1
+            return current if calls['snapshot'] != changed_generation else dict(current, generation='changed')
+        def protected(_bound, _pid):
+            calls['protected'] += 1
+            return 'changed' if calls['protected'] == bad_protection else 'bound'
+        def no_swap(_current):
+            runtime.require(not swap, 'service has current or historical swap')
+            return {'memory.swap.current': '0'}
+        def unlock():
+            runtime.require(controls.release_verified, 'unverified release')
+            events.append('unlock')
+        controls = SimpleNamespace(marker_identity=(1, 2), marker_sha256='marker',
+            release_verified=False, assert_held=lambda: None,
+            assert_restart_excluded=lambda _current: None, release=unlock)
+        adapter = SimpleNamespace(OLD_BIN='old', OLD_PY='host', DEST='binary', SIDECAR='host',
+            accepted_base=lambda: None, snapshot=snapshot, same_processes=lambda a, b: a == b,
+            runtime_config=SimpleNamespace(verify_process=lambda *a, **kw: None),
+            protected=protected, observe_live_state=lambda _stop: {}, verify_pool=lambda _record: None,
+            require_idle_residency=lambda _residency: None)
+        loaded = {'verification': SimpleNamespace(no_swap=no_swap),
+            'restoration': SimpleNamespace(clear_verified=lambda *args: events.append('clear') or {}),
+            'control': SimpleNamespace(MARKER=SimpleNamespace(exists=lambda: False))}
+        context = dict(controls=controls, adapter=adapter, loaded=loaded, bound={},
+            documents={'outer': {}}, inputs={'pins': {}},
+            record={'stops': [{}], 'pool_residency': {}})
+        observed = {'current': current, 'protected': 'bound'}
+        with patch.object(runtime, 'sha', side_effect=lambda p: {'binary': 'old', 'host': 'host'}[p]), \
+             patch.object(runtime, 'controller_absent'), \
+             patch.object(runtime, 'save', side_effect=lambda name, value: events.append(name)):
+            yield context, observed, events, calls
+
+    def test_release_requires_two_fresh_protection_checks(self):
+        with self.fixture() as (context, observed, events, calls):
+            result = runtime.release(context, observed, {}, {})
+        self.assertTrue(result['accepted'])
+        self.assertEqual(calls['protected'], 2)
+        self.assertEqual(events, ['release-intent.json', 'clear', 'cleared-handoff.json', 'unlock', 'released.json'])
+
+    def test_changed_protected_files_prevent_handoff_clearance(self):
+        with self.fixture(bad_protection=1) as (context, observed, events, _):
+            with self.assertRaisesRegex(RuntimeError, 'protected inputs changed'):
+                runtime.release(context, observed, {}, {})
+        self.assertEqual(events, ['release-intent.json'])
+
+    def test_later_protection_change_keeps_maintenance_hold(self):
+        with self.fixture(bad_protection=2) as (context, observed, events, _):
+            with self.assertRaisesRegex(RuntimeError, 'protected inputs changed'):
+                runtime.release(context, observed, {}, {})
+        self.assertEqual(events, ['release-intent.json', 'clear', 'cleared-handoff.json'])
+
+    def test_generation_change_after_clearance_keeps_hold(self):
+        with self.fixture(changed_generation=2) as (context, observed, events, _):
+            with self.assertRaisesRegex(RuntimeError, 'recovered generation changed'):
+                runtime.release(context, observed, {}, {})
+        self.assertEqual(events, ['release-intent.json', 'clear', 'cleared-handoff.json'])
+
+    def test_swap_refusal_prevents_both_mutations(self):
+        with self.fixture(swap=True) as (context, observed, events, _):
+            with self.assertRaisesRegex(RuntimeError, 'historical swap'):
+                runtime.release(context, observed, {}, {})
+        self.assertEqual(events, ['release-intent.json'])
+
+    def test_inspection_cleanup_only_closes_the_lock(self):
+        with self.fixture() as (context, _, events, _):
+            context['controls']._marker_fd = 123
+            with patch.object(runtime.os, 'close') as close:
+                runtime.close(context)
+            close.assert_called_once_with(123)
+        self.assertIsNone(context['controls']._marker_fd)
+        self.assertEqual(events, [])
+
+if __name__ == '__main__':
+    unittest.main()
