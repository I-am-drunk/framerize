+"""Only extractor fixtures, plus the original extractor's expected regression."""
+import hashlib
+import json
+import resource
+import runpy
+import sys
+import time
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+from run_checks import names, pins
+import test_extract
+
+group = Path('/sys/fs/cgroup' + Path('/proc/self/cgroup').read_text().split('0::', 1)[1].strip())
+limits = {name: (group / name).read_text().strip()
+          for name in ('memory.max', 'memory.swap.max', 'pids.max')}
+assert limits == dict(zip(('memory.max', 'memory.swap.max', 'pids.max'),
+                         ('134217728', '0', '16')))
+before = pins()
+started = time.monotonic()
+suite = unittest.defaultTestLoader.loadTestsFromModule(test_extract)
+cases = sorted(names(suite))
+assert len(cases) == len(set(cases)) == 17
+result = unittest.TextTestRunner(verbosity=2).run(suite)
+original = HERE.parent / 'pool-cooldown-handoff-r1/extract.py'
+original_hash = hashlib.sha256(original.read_bytes()).hexdigest()
+assert original_hash == 'a29bba956768e933112cba8a231861713ed7ea0d6669fb59e42fa794abb15a7a'
+old_extract = runpy.run_path(str(original))['extract']
+with test_extract.fixture('parked_primary') as (memory, expected):
+    old_value = old_extract(memory)
+    account = next(iter(expected['accounts']))
+    lost_primary = old_value['accounts'][account]['primary_device'] is None
+    old_value['accounts'][account]['primary_device'] = expected['accounts'][account]['primary_device']
+    regression = lost_primary and old_value == expected
+after = pins()
+unchanged = before == after and original_hash == hashlib.sha256(original.read_bytes()).hexdigest()
+passed = result.wasSuccessful() and not result.skipped and result.testsRun == 17 and unchanged and regression
+report = dict(accepted=passed, cases=cases, tests_run=result.testsRun,
+              errors=len(result.errors), failures=len(result.failures),
+              original_regression_reproduced=regression, original_sha256=original_hash,
+              before=before, after=after, limits=limits, cgroup=str(group),
+              elapsed_seconds=time.monotonic() - started,
+              max_rss_kib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+report['counters'] = {name: (group / name).read_text().strip() for name in
+    ('memory.peak', 'memory.events', 'memory.swap.peak', 'pids.peak', 'pids.events')}
+with (HERE / 'result.json').open('x') as output:
+    json.dump(report, output, indent=2, sort_keys=True)
+    output.write('\n')
+print(json.dumps(dict(accepted=passed, tests_run=result.testsRun, original_regression_reproduced=regression)))
+raise SystemExit(0 if passed else 1)
