+"""Inert configuration preservation and fresh maintenance-ownership cases."""
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+import driver
+from installed_runtime import InstalledRuntime
+from recovery_binding import require, sha
+
+class InstalledRuntimeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        (self.root / 'runtime-launch.json').write_bytes(b'{}')
+        self.data, files = {}, []
+        for label in ('config', 'dropin'):
+            path = self.root / label
+            path.write_bytes(label.encode())
+            info = path.stat()
+            self.data[label] = dict(destination=str(path), source=dict(sha256=sha(path)))
+            files.append(dict(target=str(path), sha256=sha(path),
+                              installed_identity=[info.st_dev, info.st_ino]))
+        self.record = dict(runtime_launch=dict(files=files,
+            sha256=sha(self.root / 'runtime-launch.json')))
+        self.original = SimpleNamespace(plan=lambda _: self.data,
+            verify_files=Mock(return_value=True), verify_process=Mock())
+        self.runtime = InstalledRuntime(self.original)
+        self.adapter = SimpleNamespace(HERE=self.root, require=require, sha=sha,
+            require_stopped=Mock(), accepted_base=Mock())
+
+    def install(self, old=False):
+        self.runtime.install(self.adapter, self.record, {'before': {}}, old=old)
+
+    def test_verified_runtime_keeps_files_and_inodes(self):
+        before = {p: (p.read_bytes(), p.stat().st_ino) for p in self.root.iterdir()}
+        self.install()
+        self.assertEqual(before, {p: (p.read_bytes(), p.stat().st_ino) for p in self.root.iterdir()})
+        self.assertEqual(self.adapter.require_stopped.call_count, 2)
+        self.original.verify_files.assert_called_once_with(self.adapter)
+
+    def test_modified_runtime_is_refused(self):
+        (self.root / 'config').write_bytes(b'changed')
+        with self.assertRaisesRegex(RuntimeError, 'installed runtime changed'):
+            self.install()
+
+    def test_rollback_direction_is_refused(self):
+        with self.assertRaisesRegex(RuntimeError, 'retain the installed runtime'):
+            self.install(old=True)
+
+    def test_identical_replacement_file_is_refused(self):
+        path = self.root / 'config'
+        replacement = self.root / 'replacement'
+        replacement.write_bytes(path.read_bytes())
+        os.replace(replacement, path)
+        with self.assertRaisesRegex(RuntimeError, 'runtime file identity changed'):
+            self.install()
+
+class FreshHoldTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.held = Mock(spec=['acquire', 'release'])
+        self.recovery = Mock()
+        self.recovery.prepare.return_value = (Mock(), self.held, {}, Mock(), Mock())
+        self.plan = dict(execution_dir=str(self.root / 'execution'), modules={'prior_recovery': {}})
+        for patcher in (patch.object(driver, '__file__', str(self.root / 'driver.py')),
+                        patch.object(driver, 'module', return_value=self.recovery)):
+            patcher.start()
+            self.addCleanup(patcher.stop)
+
+    def test_preparation_failure_releases_new_hold(self):
+        with patch.object(driver, 'prepare_held', side_effect=RuntimeError('preflight refused')):
+            with self.assertRaisesRegex(RuntimeError, 'preflight refused'):
+                driver.prepare(self.plan, {}, {})
+        self.held.acquire.assert_called_once()
+        self.held.release.assert_called_once()
+
+    def test_prepared_context_keeps_new_hold(self):
+        context = object()
+        with patch.object(driver, 'prepare_held', return_value=context):
+            self.assertIs(driver.prepare(self.plan, {}, {}), context)
+        self.held.acquire.assert_called_once()
+        self.held.release.assert_not_called()
