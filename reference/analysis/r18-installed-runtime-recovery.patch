+"""Verify the installed R18 configuration without publishing or removing files."""
+from pathlib import Path
+import stat
+
+class InstalledRuntime:
+    def __init__(self, original):
+        self.plan = original.plan
+        self.verify_files = original.verify_files
+        self.verify_process = original.verify_process
+
+    def install(self, adapter, record, stopped, old=False):
+        adapter.require(old is False, 'recovery must retain the installed runtime')
+        adapter.require_stopped(adapter.accepted_base(), stopped['before'])
+        data, saved = self.plan(adapter), record['runtime_launch']
+        adapter.require(saved['sha256'] == adapter.sha(adapter.HERE / 'runtime-launch.json'),
+                        'runtime launch plan changed')
+        adapter.require(len(saved['files']) == 2, 'runtime file inventory changed')
+        for item, label in zip(saved['files'], ('config', 'dropin')):
+            target = Path(item['target'])
+            adapter.require(str(target) == data[label]['destination'], 'runtime target changed')
+            info = target.lstat()
+            adapter.require(stat.S_ISREG(info.st_mode) and not target.is_symlink(),
+                            'runtime target is not a regular file')
+            adapter.require(item['installed_identity'] == [info.st_dev, info.st_ino],
+                            'runtime file identity changed')
+            adapter.require(adapter.sha(target) == item['sha256'] == data[label]['source']['sha256'],
+                            'installed runtime changed')
+        adapter.require(self.verify_files(adapter), 'installed runtime is incomplete')
+        adapter.require_stopped(adapter.accepted_base(), stopped['before'])
