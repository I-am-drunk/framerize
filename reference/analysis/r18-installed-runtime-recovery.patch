+"""Bind one recovery to the released R18 generation and unchanged payload."""
+from pathlib import Path
+import copy
+from recovery_binding import document, module, require, sha
+from installed_runtime import InstalledRuntime
+DEPLOY = Path(__file__).resolve().parents[2] / 'offline-serving-deployment-r18'
+expected = None
+
+def protected(adapter, record, current):
+    bound = adapter.release(record['release'])
+    fingerprint = adapter.protected(bound, current['main']['pid'])
+    require(fingerprint == record['protected'], 'protected runtime inputs changed')
+    return dict(fingerprint=fingerprint, release=record['release'])
+
+def prepare(plan, coordination, bindings):
+    global expected
+    require(Path(plan['original_receipt']['path']) == DEPLOY / 'deployment.json',
+            'wrong original deployment receipt')
+    require(Path(plan['original_release']['path']) == DEPLOY / 'release/released.json',
+            'wrong original release')
+    require(Path(plan['cleared_handoff']['path']) == DEPLOY / 'release/cleared-handoff.json',
+            'wrong cleared handoff receipt')
+    released = document(plan['original_release'])
+    record = copy.deepcopy(document(plan['original_receipt']))
+    require(released['marker_absent'] is True, 'prior release is incomplete')
+    require(record['status'] == 'configured_pending_independent_verification',
+            'unexpected original deployment status')
+    expected = released['service']
+    adapter = module('adapter', plan['modules']['adapter'])
+    require(adapter.HERE == DEPLOY, 'wrong installed deployment adapter')
+    require(adapter.same_processes(record['current'], expected), 'release generation differs')
+    require(record['files']['binary']['new_sha256'] ==
+        '9e03bde34d7ca68ed6ed58a38cf0a373f3bac6978383a1c0f603306d6589bfb8',
+        'wrong installed binary')
+    cleared = document(plan['cleared_handoff'])
+    handoff = record['startup_attempts'][-1]['cooldown_handoff']
+    accepted = adapter.DB.parent / 'cooldown-handoff' / ('accepted-' + handoff['nonce'] + '.json')
+    require(Path(cleared['path']) == accepted and cleared['sha256'] == handoff['sha256'],
+            'cleared handoff binding differs')
+    require(sha(accepted) == handoff['sha256'], 'accepted handoff changed')
+    require(not (accepted.parent / 'pending.json').exists(), 'another handoff is pending')
+    record['recovery_original_handoff'] = copy.deepcopy(handoff)
+    handoff['path'] = str(accepted)
+    adapter.runtime_config = InstalledRuntime(adapter.runtime_config)
+    transfer = module('cooldown_transfer', plan['modules']['cooldown_transfer'])
+    adapter.TRANSFER = transfer.Transfer(adapter)
+    restoration = module('restoration', plan['modules']['restoration'])
+    module('window', plan['modules']['window'])
+    control = module('control', plan['modules']['control'])
+    identity = module('recovery_identity', plan['modules']['recovery_identity'])
+    guard = document(plan['guard_identity'])
+    require(identity.identity() == guard, 'recovery producer changed')
+    sources = dict(plan['sources']) | plan['evidence'] | bindings
+    cls = identity.bound_controls(control.Controls, guard)
+    controls = cls(coordination, sources)
+    return adapter, controls, record, restoration.verify_restored, restoration.clear_verified
