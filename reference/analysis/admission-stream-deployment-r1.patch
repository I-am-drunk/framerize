+"""Root startup callback for this fixed release. Not a standalone launcher."""
+from pathlib import Path
+import datetime
+import hashlib
+import json
+import signal
+import sqlite3
+import time
+from observer import Coverage, EventCursor, canonical_id, derive_plan, require
+from launch import configuration
+
+
+class StartupObserver:
+    def __init__(self, adapter, base, assert_holds, source_pins, launch_capture):
+        require(callable(assert_holds) and source_pins, 'root controls are required')
+        self.adapter, self.base = adapter, base
+        self.assert_holds, self.source_pins = assert_holds, source_pins
+        require(launch_capture, 'captured launch inputs are required')
+        self.launch_capture = json.loads(json.dumps(launch_capture))
+        self.cursor = None
+        self.phase = None
+        self.failed = False
+
+    def accounts(self):
+        with sqlite3.connect('file:' + str(self.adapter.DB) + '?mode=ro',
+                             uri=True, timeout=3) as connection:
+            raw = [row[0] for row in connection.execute('SELECT json FROM accounts')]
+        records = [json.loads(value) for value in raw]
+        require(len(records) == 11, 'saved account inventory changed')
+        hashes = {canonical_id(record['id']): hashlib.sha256(value.encode()).hexdigest()
+                  for record, value in zip(records, raw)}
+        require(len(hashes) == len(records), 'duplicate saved identity')
+        return records, hashes
+
+    def configuration(self, context):
+        self.launch_sha256 = self.launch_capture['inputs']['cmdline_sha256']
+        return configuration(self.adapter, self.base, self.launch_capture, context)
+
+    def verify_controls(self):
+        self.assert_holds()
+        for name, expected in self.source_pins.items():
+            with Path(name).open('rb') as stream:
+                require(hashlib.file_digest(stream, 'sha256').hexdigest() == expected,
+                        'startup proof source changed')
+
+    def preflight(self, context):
+        require(self.phase is None, 'startup observer has already been used')
+        capture = self.launch_capture
+        require(capture.get('startup_policy') == 'pool_v1_ordered' and
+                context['pool_before'] == capture['pool_before'],
+                'startup preflight policy changed')
+        config = json.loads(context['pool_before'])
+        override = capture['inputs']['capacity_override']
+        if override is not None:
+            config['active_capacity'] = override
+        require(config == self.adapter.TARGET, 'startup preflight config changed')
+        seconds = context['timer_config']['required_seconds']
+        require(type(seconds) in (int, float) and 0 <= seconds <= 900,
+                'startup settlement bound differs')
+        accounts, hashes = self.accounts()
+        now = int(time.time() * 1000)
+        # Cover the later 340 s bind plus 100 s setup and actual settlement.
+        plan = derive_plan(accounts, config, now, now + 440000 + int(seconds * 1000))
+        return plan | {'records_sha256': hashes, 'pool_before': context['pool_before']}
+
+    def bind(self, context):
+        require(self.phase is None, 'startup observer has already been used')
+        require(context.get('startup_policy') == 'pool_v1_ordered' and
+                self.launch_capture.get('startup_policy') == 'pool_v1_ordered',
+                'startup capability is not bound')
+        self.legacy = False
+        self.config = self.configuration(context)
+        self.stopped_sha256 = hashlib.sha256(json.dumps(
+            context['stopped'], sort_keys=True).encode()).hexdigest()
+        accounts, self.record_hashes = self.accounts()
+        self.account_baseline = self.adapter.account_snapshot()
+        now = int(time.time() * 1000)
+        admission = context['stopped']['startup_admission']
+        require(admission['pool_before'] == context['pool_before'] and
+                self.record_hashes == admission['records_sha256'] and
+                admission['lower_ms'] <= now and now + 340000 <= admission['upper_ms'],
+                'held startup admission changed or no longer covers the bind interval')
+        plan = derive_plan(accounts, self.config, now, now + 340000, self.legacy)
+        self.plan = plan | {'timeout_seconds': 240, 'error_policy': 'all_ok',
+                            'source_binding': {
+                                'entries': len(self.source_pins),
+                                'sha256': hashlib.sha256(json.dumps(self.source_pins,
+                                    sort_keys=True, separators=(',', ':'),
+                                    allow_nan=False).encode()).hexdigest()},
+                            'launch_sha256': self.launch_sha256,
+                            'stopped_sha256': self.stopped_sha256}
+        self.plan_sha256 = hashlib.sha256(json.dumps(self.plan, sort_keys=True).encode()).hexdigest()
+        self.phase = 'bound'
+        return self.plan
+
+    def before_start(self, context):
+        require(self.phase == 'bound', 'startup boundary is out of order')
+        require(context['plan'] == self.plan, 'startup plan changed')
+        require(context['plan_sha256'] == self.plan_sha256, 'startup plan hash changed')
+        require(hashlib.sha256(json.dumps(context['stopped'], sort_keys=True).encode()).hexdigest()
+                == self.stopped_sha256, 'stopped startup boundary changed')
+        accounts, hashes = self.accounts()
+        require(hashes == self.record_hashes, 'accounts changed before startup')
+        self.wall_ms, self.monotonic = int(time.time() * 1000), time.monotonic()
+        self.upper_ms = self.wall_ms + 240000
+        require(self.upper_ms <= self.plan['upper_ms'],
+                'startup preparation exceeded its admitted interval')
+        plan = derive_plan(accounts, self.config, self.wall_ms, self.upper_ms, self.legacy)
+        require(plan['expected_accounts'] == self.plan['expected_accounts'],
+                'startup membership changed before start')
+        self.day = datetime.datetime.now(datetime.timezone.utc).date().isoformat()
+        require(self.base.LOG.name == 'events-' + self.day + '.ndjson', 'event day differs')
+        self.cursor = EventCursor(self.base.LOG)
+        self.coverage = Coverage(self.plan)
+        self.phase = 'started_boundary'
+        boundary = {'plan_sha256': context['plan_sha256'], 'log': self.cursor.receipt(),
+                    'event_day': self.day, 'records_sha256': self.record_hashes}
+        self.boundary_sha256 = hashlib.sha256(json.dumps(boundary, sort_keys=True).encode()).hexdigest()
+        return boundary
+
+    def complete(self, context):
+        require(self.phase == 'started_boundary', 'startup completion is out of order')
+        require(context['plan'] == self.plan, 'startup plan changed')
+        require(context['plan_sha256'] == self.plan_sha256 and
+                context['boundary_sha256'] == self.boundary_sha256, 'startup binding changed')
+        current = context['current']
+        while time.monotonic() < context['deadline_monotonic']:
+            self.assert_holds()
+            require(self.adapter.same_processes(current, self.adapter.snapshot(self.base)),
+                    'startup service identity changed')
+            self.adapter.require_account_inventory(
+                self.adapter.account_snapshot(), self.account_baseline)
+            wall = int(time.time() * 1000)
+            elapsed = (time.monotonic() - self.monotonic) * 1000
+            require(abs(wall - self.wall_ms - elapsed) <= 2000, 'wall clock changed')
+            require(self.wall_ms <= wall <= self.upper_ms, 'startup clock bound expired')
+            day = datetime.datetime.now(datetime.timezone.utc).date().isoformat()
+            require(day == self.day, 'startup crossed the bound event day')
+            for event in self.cursor.read_events():
+                self.coverage.observe(event)
+            if self.coverage.complete() and not self.cursor.pending:
+                return self.finish(context)
+            time.sleep(min(1, max(0, context['deadline_monotonic'] - time.monotonic())))
+        raise RuntimeError('startup terminal coverage deadline expired')
+
+    def finish(self, context):
+        self.verify_controls()
+        mapping = {item[:8]: item for item in self.plan['expected_accounts']}
+        evidence = {'plan_sha256': self.plan_sha256,
+                    'boundary_sha256': self.boundary_sha256,
+                    'invocation_id': context['current']['service']['InvocationID'],
+                    'main': context['current']['main'],
+                    'daemon_start_count': self.coverage.daemon_starts,
+                    'terminals': [{'account_id': mapping[prefix], 'outcome': 'ok'}
+                                  for prefix in self.coverage.seen],
+                    'event_log': self.cursor.receipt()}
+        self.cursor.close()
+        self.phase = 'complete'
+        return evidence
+
+    def close(self):
+        if self.cursor is not None:
+            self.cursor.close()
+
+    def __call__(self, phase, context):
+        handler_owned = False
+        def expired(_number, _frame):
+            raise TimeoutError('root startup observer deadline expired')
+        try:
+            require(not self.failed, 'startup observer has already failed')
+            require(phase in ('preflight', 'bind', 'before_start', 'complete'),
+                    'unknown startup phase')
+            remaining = context['deadline_monotonic'] - time.monotonic()
+            require(0 < remaining <= 300, 'invalid startup deadline')
+            require(signal.getitimer(signal.ITIMER_REAL) == (0.0, 0.0),
+                    'another timer owns the process')
+            previous = signal.getsignal(signal.SIGALRM)
+            signal.signal(signal.SIGALRM, expired)
+            handler_owned = True
+            signal.setitimer(signal.ITIMER_REAL, remaining)
+            self.verify_controls()
+            return getattr(self, phase)(context)
+        except BaseException:
+            self.failed = True
+            self.close()
+            raise
+        finally:
+            if handler_owned:
+                signal.setitimer(signal.ITIMER_REAL, 0)
+                signal.signal(signal.SIGALRM, previous)
