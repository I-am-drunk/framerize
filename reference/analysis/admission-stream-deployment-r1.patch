+"""Controller-owned capture, durable handoff, and startup receipt checks."""
+import contextlib
+import importlib.util
+import json
+import os
+import stat
+import sys
+import time
+import uuid
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+SUPPORT = HERE.parent / 'pool-cooldown-handoff-r2'
+sys.path.insert(0, str(SUPPORT))
+_capture_path = SUPPORT / 'capture.py'
+_capture_spec = importlib.util.spec_from_file_location('cooldown_support_capture', _capture_path)
+_capture = importlib.util.module_from_spec(_capture_spec)
+sys.modules[_capture_spec.name] = _capture
+_capture_spec.loader.exec_module(_capture)
+HeldCapture, identity, thread_states = _capture.HeldCapture, _capture.identity, _capture.thread_states
+import inventory
+import ledger
+import private_state
+
+
+class Transfer:
+    def __init__(self, adapter, controls=None, original=None, memory_fd=None):
+        self.adapter, self.controls = adapter, controls
+        self.original, self.memory_fd = original, memory_fd
+        self.root = adapter.DB.parent
+        self.directory = self.root / 'cooldown-handoff'
+        self.controller = identity(os.getpid())
+
+    def ensure_directory(self):
+        self.directory.mkdir(mode=0o700, exist_ok=True)
+        mode = self.directory.lstat()
+        ledger.require(stat.S_ISDIR(mode.st_mode) and mode.st_uid == os.getuid()
+                       and stat.S_IMODE(mode.st_mode) == 0o700, 'unsafe handoff directory')
+
+    def require_controls(self, before):
+        ledger.require(self.controls is not None, 'capture controls are not bound')
+        self.controls.assert_restart_excluded(before)
+
+    @contextlib.contextmanager
+    def capture(self, before, event):
+        self.require_controls(before)
+        self.ensure_directory()
+        saved, devices = inventory.collect(self.root)
+        expected = before['sidecar']
+        guard = HERE / 'controller/execution' / ('held-' + uuid.uuid4().hex + '.json')
+        def remember_stop(_expected):
+            private_state.write_new(guard, {'controller': self.controller, 'sidecar': _expected})
+        if expected == self.original and self.memory_fd is not None:
+            fd = os.dup(self.memory_fd)
+        else:
+            fd = os.open('/proc/' + str(expected['pid']) + '/mem', os.O_RDONLY)
+        try:
+            with HeldCapture(expected, fd, devices, remember_stop) as held:
+                self.require_controls(before)
+                current = self.adapter.snapshot(self.adapter.accepted_base())
+                ledger.require(self.adapter.same_processes(before, current), 'capture service changed')
+                nonce = uuid.uuid4().hex
+                path = self.directory / ('snapshot-' + nonce + '.json')
+                digest = private_state.write_new(path, held.payload)
+                event['rate_limits'] = dict(nonce=nonce, snapshot={'path': str(path), 'sha256': digest},
+                    sidecar=expected, generation=held.payload['state']['generation'],
+                    captured_monotonic=held.payload['captured_monotonic'],
+                    bytes_read=held.bytes_read, inventory_before=saved)
+                yield held
+        finally:
+            os.close(fd)
+            if guard.exists():
+                try:
+                    unresolved = 'T' in thread_states(expected['pid']).values()
+                except FileNotFoundError:
+                    unresolved = False
+                if not unresolved:
+                    private_state.write_new(guard.with_suffix('.done'), {'resolved': True})
+
+    def final_inventory(self, event):
+        saved, _ = inventory.collect(self.root)
+        previous = event['rate_limits']['inventory_before']
+        ledger.require(all(saved[k] == previous[k] for k in ('identities', 'device_hashes')),
+                       'account or device identity changed during capture')
+        ledger.require(set(saved['records']) == set(previous['records']), 'account set changed')
+        return saved
+
+    def verify_event(self, event, *, require_full_records=True):
+        rate = event['rate_limits']
+        payload, digest = private_state.read(rate['snapshot']['path'], rate['snapshot']['sha256'])
+        saved, devices = inventory.collect(self.root)
+        ledger.validate(payload, event['before']['boot_id'], time.monotonic(), devices)
+        final = event['cooldown_final_inventory']
+        if require_full_records:
+            ledger.require(saved == final, 'handoff account state changed')
+        else:
+            ledger.require(set(saved['records']) == set(final['records']) and
+                all(saved[k] == final[k] for k in ('identities', 'device_hashes')),
+                'handoff account isolation changed')
+        ledger.require(rate['sidecar'] == event['before']['sidecar'], 'capture identity differs')
+        ledger.require(payload['state']['generation'] == rate['generation'], 'capture host differs')
+        killed = event['capture_termination']
+        captured = payload['captured_monotonic']
+        ledger.require(killed['never_resumed'] is True and captured == rate['captured_monotonic']
+                       and captured <= killed['terminated_monotonic'] <=
+                       event['stopped']['confirmed_absence_monotonic'], 'capture boundary differs')
+        return payload
+
+    def install_support(self):
+        manifest = HERE / 'runtime-sources.json'
+        pins = self.adapter.document(manifest)
+        ledger.require(set(pins) == {'__init__.py', 'startup_state.py', 'inventory.py',
+                                    'ledger.py', 'private_state.py', 'native_device.py'},
+                       'wrong support inventory')
+        expected = self.adapter.sha(manifest)
+        target = self.root / ('cooldown-support-' + expected[:16])
+        ledger.require(target.is_dir() and not target.is_symlink(),
+                       'preserved support directory is missing')
+        for name, digest in dict(pins, **{'runtime-sources.json': expected}).items():
+            source = manifest if name == 'runtime-sources.json' else HERE / 'runtime-support' / name
+            path = target / name
+            ledger.require(path.is_file() and not path.is_symlink(),
+                           'preserved support file is missing')
+            ledger.require(self.adapter.sha(path) == digest, 'installed support differs')
+        ledger.require(set(p.name for p in target.iterdir()) == set(pins) | {'runtime-sources.json'},
+                       'installed support inventory differs')
+        return {'path': str(target), 'manifest_sha256': expected}
+
+    def retire_pending(self, before):
+        pending = self.directory / 'pending.json'
+        if not pending.exists():
+            return
+        old, _ = private_state.read(pending)
+        claimed = self.directory / ('claim-' + old['nonce'] + '.json')
+        if claimed.exists():
+            restored, _ = private_state.read(self.directory / ('restored-' + old['nonce'] + '.json'))
+            ledger.require(all(restored[k] == before[k] for k in ('main', 'sidecar')),
+                           'prior handoff belongs to another generation')
+        else:
+            ledger.require(all(old['source'][k] == before[k] for k in ('main', 'sidecar')),
+                           'unused handoff belongs to another stopped source')
+        archived = self.directory / ('pending-' + old['nonce'] + '.json')
+        os.link(pending, archived, follow_symlinks=False)
+        pending.unlink()
+
+    def arm(self, event, binary_sha256, sidecar_sha256):
+        ledger.require(not event.get('start_attempted'), 'capture already consumed by a start')
+        payload = self.verify_event(event)
+        self.adapter.require_stopped(self.adapter.accepted_base(), event['before'])
+        self.retire_pending(event['before'])
+        nonce = uuid.uuid4().hex
+        snapshot = self.directory / ('snapshot-' + nonce + '.json')
+        digest = private_state.write_new(snapshot, payload)
+        prior = event['before']
+        source = {key: prior[key] for key in ('main', 'sidecar', 'cgroup')}
+        source.update(invocation_id=prior['service']['InvocationID'],
+                      host_generation=payload['state']['generation'])
+        request = dict(format=1, nonce=nonce, boot_id=prior['boot_id'], source=source,
+                       destination=dict(binary_sha256=binary_sha256,
+                                        sidecar_sha256=sidecar_sha256, controller=self.controller),
+                       snapshot=dict(path=str(snapshot), sha256=digest),
+                       inventory=event['cooldown_final_inventory'])
+        pending = self.directory / 'pending.json'
+        request_hash = private_state.write_new(pending, request)
+        return dict(path=str(pending), sha256=request_hash, nonce=nonce,
+                    snapshot_sha256=digest)
+
+    def restoration(self, handoff, current):
+        request, _ = private_state.read(handoff['path'], handoff['sha256'])
+        path = self.directory / ('restored-' + handoff['nonce'] + '.json')
+        receipt, digest = private_state.read(path)
+        ledger.require(receipt['request_sha256'] == handoff['sha256'] and
+                       receipt['snapshot_sha256'] == handoff['snapshot_sha256'] and
+                       receipt['nonce'] == request['nonce'], 'restoration binding differs')
+        ledger.require(receipt['status'] == 'restored' and
+                       all(receipt[k] == current[k] for k in ('main', 'sidecar')) and
+                       receipt['invocation_id'] == current['service']['InvocationID'],
+                       'restoration belongs to another process')
+        claim, _ = private_state.read(self.directory / ('claim-' + handoff['nonce'] + '.json'))
+        ledger.require(all(receipt[k] == value for k, value in claim.items()),
+                       'restoration claim differs')
+        payload, _ = private_state.read(request['snapshot']['path'], handoff['snapshot_sha256'])
+        ledger.require(receipt['source_generation'] == payload['state']['generation'] and
+                       receipt['account_count'] == len(payload['state']['accounts']) and
+                       payload['captured_monotonic'] <= receipt['restored_monotonic'] <= time.monotonic(),
+                       'restoration content or timing differs')
+        return {'path': str(path), 'sha256': digest, 'receipt': receipt}
+
+    def clear_pending(self, handoff, current):
+        self.restoration(handoff, current)
+        pending = self.directory / 'pending.json'
+        archived = self.directory / ('accepted-' + handoff['nonce'] + '.json')
+        os.link(pending, archived, follow_symlinks=False)
+        pending.unlink()
+        fd = os.open(self.directory, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
