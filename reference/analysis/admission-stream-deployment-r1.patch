+"""Terminal entry for activation or rollback with one administrator prompt."""
+import os
+import resource
+import signal
+import subprocess
+import sys
+import time
+import uuid
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE / 'controller'))
+from recovery_binding import checked_plan, document, module, require, save, sha
+from launch import launch
+STOP_REQUESTED = False
+
+
+def request_stop(_number, _frame):
+    global STOP_REQUESTED
+    STOP_REQUESTED = True
+
+
+def pin(path):
+    return {'path': str(path), 'sha256': sha(path)}
+
+
+def main(purpose):
+    require(purpose == 'activate', 'unknown operation')
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+    plan_pin = pin(HERE / 'release/plan.json')
+    review_pin = document(pin(HERE / 'release/plan-review-pin.json'))
+    plan = checked_plan(plan_pin, review_pin)
+    require(plan.get('cooldown_handoff_required') is True, 'cooldown handoff is not bound')
+    directory = 'controller' if purpose == 'activate' else 'manual'
+    require(not (HERE / directory / 'execution').exists(), 'preserve and reconcile the prior execution first')
+    safety = module('operator_safety', plan['modules']['rollback_safety'])
+    authentication = ['sudo', '-v'] if sys.stdin.isatty() else ['sudo', '-n', '-v']
+    require(subprocess.run(authentication, timeout=120).returncode == 0,
+            'administrator authentication is required before any service transition')
+    coordination = safety.authorized_cancellation()
+    ack = HERE / ('operator-cancellation-' + uuid.uuid4().hex + '.json')
+    save(ack, coordination)
+    return run(plan_pin, review_pin, pin(ack), purpose)
+
+
+def run(plan_pin, review_pin, coordination, purpose):
+    global STOP_REQUESTED
+    STOP_REQUESTED = False
+    signals = (signal.SIGINT, signal.SIGTERM)
+    previous = {number: signal.getsignal(number) for number in signals}
+    try:
+        for number in signals:
+            signal.signal(number, request_stop)
+        return run_owned(plan_pin, review_pin, coordination, purpose)
+    finally:
+        for number, handler in previous.items():
+            signal.signal(number, handler)
+
+
+def run_owned(plan_pin, review_pin, coordination, purpose):
+    require(not STOP_REQUESTED, 'operator cancellation requested before launch')
+    helper = subprocess.Popen(['/usr/bin/python3', '-I', '-B', '-S',
+                               str(HERE / 'authorize.py'), purpose, str(os.getpid())])
+    try:
+        result = launch(plan_pin, review_pin, coordination, rollback=purpose == 'rollback',
+                        cancelled=lambda: STOP_REQUESTED)
+    finally:
+        if helper.poll() is None:
+            try:
+                helper.terminate()
+            except ProcessLookupError:
+                pass
+        try:
+            helper.wait(timeout=30)
+        except subprocess.TimeoutExpired:
+            helper.kill()
+            helper.wait(timeout=5)
+            raise RuntimeError('authorization cleanup is unconfirmed')
+    passed = not STOP_REQUESTED and result.get('exit_code') == 0 and not result['errors'] and (
