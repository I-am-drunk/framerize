+"""Continue the exact abandoned owned marker; retain it on every refusal."""
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+def adopted_controls(original, expected, marker):
+    class Controls(original):
+        release_verified = False
+
+        def acquire(self):
+            if self.marker_identity is not None:
+                raise RuntimeError('maintenance already acquired')
+            info = marker.lstat()
+            if marker.is_symlink() or info.st_size > 4096:
+                raise RuntimeError('unsafe retained marker')
+            self.marker_identity = tuple(expected['identity'])
+            self.marker_sha256 = expected['sha256']
+            self.boot_id = expected['boot_id']
+            self.acquired_at = time.monotonic()
+            self.assert_held()
+            fd = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW)
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                opened = os.fstat(fd)
+                if (opened.st_dev, opened.st_ino) != self.marker_identity:
+                    raise RuntimeError('retained marker changed while locking')
+                self._marker_fd = fd
+            except BaseException:
+                os.close(fd)
+                raise
+
+            try:
+                self.verify_prior_absent()
+                self.assert_held()
+            except BaseException:
+                os.close(self._marker_fd)
+                self._marker_fd = None
+                raise
+
+        def verify_prior_absent(self):
+            owner = json.loads(marker.read_bytes())['owner_pid']
+            if Path('/proc', str(owner)).exists():
+                raise RuntimeError('prior marker owner is still present')
+            unit = 'framerize-r18-recover-38b58eeb4656.service'
+            raw = subprocess.check_output(['systemctl', '--user', 'show', unit,
+                '-p', 'MainPID,ActiveState,Job'], text=True, timeout=5)
+            state = dict(row.split('=', 1) for row in raw.splitlines())
+            if state['MainPID'] != '0' or state['ActiveState'] not in ('inactive', 'failed') \
+                    or state['Job'] not in ('', '0', '0 /', '[not set]'):
+                raise RuntimeError('prior controller is not absent')
+        def release(self):
+            if not self.release_verified:
+                raise RuntimeError('retained marker awaits verified deployment release')
+            self.assert_held()
+            result = super().release()
+            os.close(self._marker_fd)
+            self._marker_fd = None
+            return result
+
+    return Controls
