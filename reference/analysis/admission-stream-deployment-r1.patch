+class MarkerTests(unittest.TestCase):
+    def setUp(self):
+        folder = tempfile.TemporaryDirectory()
+        self.addCleanup(folder.cleanup)
+        self.root = Path(folder.name)
+        self.marker = self.root / 'maintenance'
+        self.marker.write_text(json.dumps({'owner_pid': -1}))
+        self.ack = self.root / 'ack.json'
+        self.ack.write_text(json.dumps(dict(requests_may_be_cancelled=True,
+            clients_held=False, kind='authorized_cancellation')))
+        control = LOADED['control']
+        for scope in (patch.object(control, 'MARKER', self.marker),
+                      patch.object(adopt.subprocess, 'check_output',
+                          return_value='MainPID=0\nActiveState=inactive\nJob=\n')):
+            scope.start()
+            self.addCleanup(scope.stop)
+        info = self.marker.stat()
+        self.expected = dict(identity=[info.st_dev, info.st_ino],
+            sha256=binding.sha(self.marker),
+            boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip())
+        self.cls = adopt.adopted_controls(control.Controls, self.expected, self.marker)
+        self.instances = []
+        self.addCleanup(self.close_locks)
+
+    def make(self):
+        pin = dict(path=str(self.ack), sha256=binding.sha(self.ack))
+        instance = self.cls(pin, {pin['path']: pin['sha256']})
+        self.instances.append(instance)
+        return instance
+
+    def close_locks(self):
+        for instance in self.instances:
+            fd = getattr(instance, '_marker_fd', None)
+            if fd is not None:
+                os.close(fd)
+                instance._marker_fd = None
+
+    def test_unverified_release_keeps_marker_and_exclusive_owner(self):
+        first = self.make()
+        first.acquire()
+        with self.assertRaisesRegex(RuntimeError, 'verified deployment release'):
+            first.release()
+        self.assertEqual(binding.sha(self.marker), self.expected['sha256'])
+        with self.assertRaises(BlockingIOError):
+            self.make().acquire()
+        first.release_verified = True
+        first.release()
+        self.assertFalse(self.marker.exists())
+
+    def test_live_prior_owner_refuses_adoption(self):
+        self.marker.write_text(json.dumps({'owner_pid': os.getpid()}))
+        self.expected['sha256'] = binding.sha(self.marker)
+        owner = self.make()
+        with self.assertRaisesRegex(RuntimeError, 'prior marker owner'):
+            owner.acquire()
+        self.assertTrue(self.marker.exists())
+        self.assertIsNone(owner._marker_fd)
+
+    def test_changed_marker_is_not_adopted(self):
+        self.marker.write_text(json.dumps({'owner_pid': -2}))
+        with self.assertRaisesRegex(RuntimeError, 'maintenance ownership changed'):
+            self.make().acquire()
+        self.assertTrue(self.marker.exists())
