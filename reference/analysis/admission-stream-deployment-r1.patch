+"""Bounded outer launcher with explicit cancellation policy and fresh drain."""
+from pathlib import Path
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import uuid
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from recovery_binding import checked_plan, document, require, save, sha
+
+
+def launch(plan_pin, review_pin, coordination, rollback=False, cancelled=lambda: False):
+    plan = checked_plan(plan_pin, review_pin)
+    ack = document(coordination)
+    require(ack.get('requests_may_be_cancelled') is True and
+            ack.get('clients_held') is False and ack.get('kind') == 'authorized_cancellation',
+            'explicit cancellation policy is required')
+    require(0 <= time.time() - ack['at_unix'] < 300, 'operation epoch is stale')
+    memory = {row.split(':')[0]: int(row.split()[1]) * 1024
+        for row in Path('/proc/meminfo').read_text().splitlines()
+        if row.startswith(('MemTotal:', 'MemAvailable:'))}
+    root = Path(__file__).resolve().parent
+    disk = os.statvfs(root)
+    require(memory['MemAvailable'] >= memory['MemTotal'] // 10 + 640 * 1024**2,
+            'fresh deployment memory admission failed')
+    require(disk.f_bavail * disk.f_frsize > 1024**3, 'fresh deployment disk admission failed')
+    unit = 'framerize-r18-recover-' + uuid.uuid4().hex[:12]
+    # User-service mount isolation creates a private user namespace and blocks
+    # the exact /proc identities this trusted maintenance controller must read.
+    # Keep normal UID permissions; the offline test unit remains isolated.
+    properties = ['MemoryMax=128M', 'MemorySwapMax=0', 'TasksMax=32',
+        'CPUQuota=100%', 'RuntimeMaxSec=2700', 'TimeoutStopSec=10',
+        'KillMode=control-group', 'NoNewPrivileges=yes']
+    cleanup = root.parent / 'cleanup.py'
+    require(plan['sources'].get(str(cleanup)) == sha(cleanup), 'cleanup is not bound')
+    properties += ['ExecStopPost=/usr/bin/python3 -I -B ' + str(cleanup) + ' ' + sha(cleanup)]
+    argv = ['systemd-run', '--user', '--wait', '--pipe', '--collect', '--unit=' + unit]
+    argv += ['--property=' + value for value in properties]
+    driver = root.parent / 'manual/run.py' if rollback else root / 'driver.py'
+    require(plan['sources'].get(str(driver)) == sha(driver), 'driver is not bound')
+    argv += ['/usr/bin/python3', '-I', '-B', '-u', str(driver), '--execute']
+    for name, pin in (('plan', plan_pin), ('review', review_pin), ('coordination', coordination)):
+        argv += ['--' + name, pin['path'], '--' + name + '-sha256', pin['sha256']]
+    record = {'unit': unit, 'argv': argv, 'plan': plan_pin, 'review': review_pin,
+        'coordination': coordination, 'admitted_at_unix': time.time(), 'memory': memory,
+        'free_disk': disk.f_bavail * disk.f_frsize, 'errors': []}
+    receipt = root / (unit + '.json')
+    log = root / (unit + '.log')
+    save(receipt, record)
+    with log.open('x') as stream:
+        child = None
+        try:
+            require(not cancelled(), 'operator cancelled before controller spawn')
+            child = subprocess.Popen(argv, stdout=stream, stderr=subprocess.STDOUT)
+            record['command_pid'] = child.pid
+            deadline = time.monotonic() + 2730
+            while child.poll() is None:
+                require(not cancelled(), 'operator cancelled controller')
+                require(time.monotonic() < deadline, 'outer controller deadline exceeded')
+                time.sleep(0.1)
+            require(not cancelled(), 'operator cancelled controller completion')
+            record['exit_code'] = child.returncode
+        except BaseException as error:
+            record['errors'].append({'phase': 'run', 'type': type(error).__name__})
+        finally:
+            if child is not None:
+                try:
+                    if child.poll() is None:
+                        try:
+                            child.terminate()
+                        except ProcessLookupError:
+                            pass
+                    try:
+                        child.wait(timeout=5)
+                    except subprocess.TimeoutExpired:
+                        child.kill()
+                        child.wait(timeout=5)
+                        record['errors'].append({'phase': 'join', 'type': 'ForcedCleanup'})
+                    record['command_joined'] = True
+                except BaseException as error:
+                    record['errors'].append({'phase': 'join', 'type': type(error).__name__})
+            try:
+                subprocess.run(['systemctl', '--user', 'stop', unit], timeout=15,
+                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            except BaseException as error:
+                record['errors'].append({'phase': 'stop', 'type': type(error).__name__})
+    record.update(unit_absent=False, cgroup_absent=False)
+    try:
+        loaded = subprocess.check_output(['systemctl', '--user', 'show', unit,
+            '-p', 'LoadState', '--value'], text=True, timeout=5)
+        record['unit_absent'] = loaded.strip() == 'not-found'
+    except BaseException as error:
+        record['errors'].append({'phase': 'show', 'type': type(error).__name__})
+    try:
+        record['cgroup_absent'] = not list(Path('/sys/fs/cgroup/user.slice').rglob(unit + '.service'))
+        record['log_sha256'] = sha(log)
+    except BaseException as error:
+        record['errors'].append({'phase': 'cleanup_check', 'type': type(error).__name__})
+    record['completed_at_unix'] = time.time()
+    save(receipt, record)
+    print(json.dumps({'outer_receipt': str(receipt), 'sha256': sha(receipt)}), flush=True)
+    return record
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--execute', action='store_true', required=True)
+    for name in ('plan', 'review', 'coordination'):
+        parser.add_argument('--' + name, required=True)
+        parser.add_argument('--' + name + '-sha256', required=True)
+    args = parser.parse_args()
+    def pin(name):
+        return {'path': str(Path(getattr(args, name)).resolve()),
+                'sha256': getattr(args, name + '_sha256')}
+    cancellation = {'requested': False}
+    def request_stop(_number, _frame):
+        cancellation['requested'] = True
+    for number in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(number, request_stop)
+    result = launch(pin('plan'), pin('review'), pin('coordination'),
+                    cancelled=lambda: cancellation['requested'])
+    raise SystemExit(0 if result.get('exit_code') == 0 and not result['errors']
+                    and result['unit_absent'] and result['cgroup_absent'] else 1)
