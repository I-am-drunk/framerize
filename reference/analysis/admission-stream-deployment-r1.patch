+"""Systemd stop hook: release only an unresolved, exactly owned capture hold."""
+import hashlib
+import json
+import os
+import signal
+import sys
+from pathlib import Path
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def ticks(pid):
+    raw = Path('/proc', str(pid), 'stat').read_text().rsplit(') ', 1)[1].split()
+    return int(raw[19]), raw[0]
+
+
+def resume(expected):
+    try:
+        start, state = ticks(expected['pid'])
+    except FileNotFoundError:
+        return 'absent'
+    if start != expected['start'] or state not in ('T', 't'):
+        return 'not_held'
+    fd = os.pidfd_open(expected['pid'])
+    try:
+        if ticks(expected['pid'])[0] != start:
+            raise RuntimeError('capture generation changed')
+        if sha(Path('/proc', str(expected['pid']), 'exe')) != expected['exe_sha256']:
+            raise RuntimeError('capture executable changed')
+        signal.pidfd_send_signal(fd, signal.SIGCONT)
+        return 'resumed_after_controller_exit'
+    finally:
+        os.close(fd)
+
+
+def main(expected):
+    if sha(Path(__file__)) != expected:
+        raise RuntimeError('capture cleanup source changed')
+    root = Path(__file__).resolve().parent / 'controller/execution'
+    paths = sorted(root.glob('held-*.json'))
+    if len(paths) > 8:
+        raise RuntimeError('unexpected capture hold inventory')
+    for path in paths:
+        if path.with_suffix('.done').exists():
+            continue
+        if path.stat().st_size > 4096:
+            raise RuntimeError('oversized capture hold')
+        result = resume(json.loads(path.read_text())['sidecar'])
+        print(json.dumps({'hold': path.name, 'result': result}), flush=True)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 2:
+        raise SystemExit('exact cleanup source hash is required')
+    main(sys.argv[1])
