+
+def require_supervisor():
+    relative = Path('/proc/self/cgroup').read_text().split('0::')[1].strip().lstrip('/')
+    group = Path('/sys/fs/cgroup') / relative
+    require(group.name.startswith('framerize-r18-recover-') and
+            group.name.endswith('.service'), 'reviewed supervisor is required')
+    for name, expected in (('memory.max', str(128 * 1024**2)),
+                           ('memory.swap.max', '0'), ('pids.max', '32')):
+        require((group / name).read_text().strip() == expected, 'supervisor limit differs')
+    duration = subprocess.check_output(['systemctl', '--user', 'show', group.name,
+        '-p', 'RuntimeMaxUSec', '--value'], text=True, timeout=5).strip()
+    require(duration in ('45min', '2700s'), 'external deadline differs')
+
+
+def execute(plan, coordination, bindings):
+    output = Path(plan['execution_dir'])
+    require(output == Path(__file__).resolve().parent / 'execution', 'wrong output path')
+    output.mkdir(mode=0o700)
+    names = ('window', 'control', 'observer', 'launch', 'startup_runtime',
+             'settlement_runtime', 'adapter', 'cooldown_transfer', 'fd_bridge',
+             'coordinator', 'recovery_identity', 'restoration')
+    loaded = {name: module(name, plan['modules'][name]) for name in names}
+    adapter = loaded['adapter']
+    base, release = adapter.accepted_base(), plan['release']
+    bound = adapter.release(release)
+    baseline = document(plan['baseline'])
+    capture = loaded['launch'].capture_launch(adapter, base, bound['binary_sha256'])
+    require(adapter.same_processes(capture['prior'], baseline['current']),
+            'captured generation changed')
+    require(adapter.protected(bound, capture['prior']['main']['pid']) == baseline['protected'],
+            'captured protected inputs changed')
+    adapter.runtime_config.verify_process(adapter, capture['prior']['main']['pid'], old=True)
+    adapter.require_account_inventory(adapter.account_snapshot(), baseline['accounts'])
+    metrics = verification.metrics(capture['prior'])
+    verification.no_events(metrics)
+    require(metrics['memory.swap.max'] == str(1024**3) and
+            0 <= int(metrics['memory.swap.current']) <= 1024**3,
+            'outside bounded input-runtime swap policy')
+    timers = adapter.stop_inputs(capture['prior'])['timer_config']
+    require(timers['required_seconds'] <= plan['max_settlement_seconds'],
+            'actual timer exceeds controller budget')
+    capture_path = output / 'launch-capture.json'
+    save(capture_path, capture)
+    save(output / 'input-metrics.json', metrics)
+    sources = dict(plan['sources']) | plan['evidence'] | bindings
+    sources[str(capture_path)] = sha(capture_path)
+    guard = loaded['recovery_identity'].identity()
+    require(guard == baseline['guard'], 'recovery producer changed')
+    save(output / 'recovery-producer.json', guard)
+    cls = loaded['recovery_identity'].bound_controls(loaded['control'].Controls, guard)
+    cls = adopted_controls(cls, baseline['held_marker'], loaded['control'].MARKER)
+    controls = cls(coordination, sources)
+
+    def progress(event):
+        print(json.dumps(event, sort_keys=True), flush=True)
+
+    settlement = loaded['settlement_runtime'].Settlement(adapter, base, controls, progress)
