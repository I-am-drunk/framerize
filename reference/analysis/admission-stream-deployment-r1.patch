+"""One-shot read-only descriptor handoff. Privileged mode never reads memory."""
+import array
+import hashlib
+import json
+import os
+import pwd
+import re
+import socket
+import stat
+import struct
+import time
+from pathlib import Path
+PYTHON_SHA = 'e50d468e8b0adfb05733f5b87b3cff34829c4a8c1aea50c865aa8bdfe4bb150f'
+OLD_BINARY = '9e03bde34d7ca68ed6ed58a38cf0a373f3bac6978383a1c0f603306d6589bfb8'
+OLD_SCRIPT = 'fd17f5a2d2547f01ccf0e62849ce4d6a67037fca7f0bd0cb3357e0636c85210b'
+NEW_BINARY = '00508774de666528cf1ec3b8ee5f049666ce26c63844904fd568a15375050829'
+NEW_SCRIPT = 'fd17f5a2d2547f01ccf0e62849ce4d6a67037fca7f0bd0cb3357e0636c85210b'
+SIDECAR = Path('/home/tjninja/.framerize/camoufox_host.py')
+
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+
+def bind_parent():
+    import ctypes
+    import signal
+    parent = os.getppid()
+    require(parent > 1, 'privileged helper has no owning parent')
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.prctl.argtypes = [ctypes.c_int] + [ctypes.c_ulong] * 4
+    libc.prctl.restype = ctypes.c_int
+    require(libc.prctl(1, signal.SIGKILL, 0, 0, 0) == 0,
+            'cannot bind privileged helper lifetime')
+    require(os.getppid() == parent, 'privileged helper parent exited')
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def process(pid):
+    require(type(pid) is int and pid > 1, 'invalid process identity')
+    root = Path('/proc', str(pid))
+    def ticks():
+        return int((root / 'stat').read_text().rsplit(') ', 1)[1].split()[19])
+    started = ticks()
+    result = dict(pid=pid, start=started, exe_sha256=sha(root / 'exe'))
+    require(ticks() == started, 'process changed during verification')
+    return result
+
+
+def read_request(expected, uid, purpose='activate'):
+    require(purpose in ('activate', 'rollback'), 'unknown descriptor purpose')
+    directory = 'controller' if purpose == 'activate' else 'manual'
+    path = Path(__file__).resolve().parent / directory / 'execution/memory-access.json'
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(fd)
+        require(stat.S_ISREG(info.st_mode) and info.st_uid == uid and
+                stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1,
+                'unsafe descriptor request')
+        raw = os.read(fd, 16385)
+        require(len(raw) <= 16384 and hashlib.sha256(raw).hexdigest() == expected,
+                'descriptor request changed')
+        return json.loads(raw)
+    finally:
+        os.close(fd)
+
+
+def privileged_grant(expected, purpose='activate'):
+    require(os.geteuid() == 0, 'one-time administrator authentication is required')
+    uid = pwd.getpwnam('tjninja').pw_uid
+    request = read_request(expected, uid, purpose)
+    require(set(request) == {'controller', 'main', 'sidecar', 'nonce', 'socket', 'at_unix'},
+            'unexpected descriptor request fields')
+    require(0 <= time.time() - request['at_unix'] <= 180, 'descriptor request expired')
+    for name in ('controller', 'main', 'sidecar'):
+        owner = request[name]
+        require(process(owner['pid']) == owner, 'descriptor process identity changed')
+        require(Path('/proc', str(owner['pid'])).stat().st_uid == uid, 'wrong process owner')
+    binary, script = (OLD_BINARY, OLD_SCRIPT) if purpose == 'activate' else (NEW_BINARY, NEW_SCRIPT)
+    require(request['main']['exe_sha256'] == binary and
+            request['sidecar']['exe_sha256'] == request['controller']['exe_sha256'] == PYTHON_SHA,
+            'unsupported executable for memory access')
+    proc = Path('/proc', str(request['sidecar']['pid']))
+    args = (proc / 'cmdline').read_bytes().split(b'\0')
+    require(len(args) > 1 and args[1] == os.fsencode(SIDECAR) and sha(SIDECAR) == script,
+            'memory request is not for the deployed sidecar')
+    parent = int((proc / 'stat').read_text().rsplit(') ', 1)[1].split()[1])
+    require(parent == request['main']['pid'], 'sidecar parent changed')
+    return send_descriptor(request, uid)
+
+
+def send_descriptor(request, uid):
+    nonce = request['nonce']
+    require(type(nonce) is str and re.fullmatch('[0-9a-f]{32}', nonce), 'invalid nonce')
+    path = Path('/run/user', str(uid), 'framerize-cooldown-' + nonce + '.sock')
+    require(str(path) == request['socket'], 'unexpected descriptor socket')
+    info = path.lstat()
+    require(stat.S_ISSOCK(info.st_mode) and info.st_uid == uid and
+            stat.S_IMODE(info.st_mode) == 0o600, 'unsafe descriptor socket')
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
+        connection.settimeout(5)
+        connection.connect(str(path))
+        pid, peer_uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
+        require(peer_uid == uid and pid == request['controller']['pid'], 'wrong descriptor recipient')
+        fd = os.open('/proc/' + str(request['sidecar']['pid']) + '/mem', os.O_RDONLY | os.O_CLOEXEC)
+        try:
+            require(process(pid) == request['controller'] and
+                    process(request['sidecar']['pid']) == request['sidecar'], 'recipient or target changed')
+            sent = connection.sendmsg([nonce.encode()], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [fd]))])
+            require(sent == len(nonce), 'incomplete descriptor handoff')
+        finally:
+            os.close(fd)
+
+
+def receive_descriptor(before, output, save):
+    import uuid
+    nonce = uuid.uuid4().hex
+    path = Path('/run/user', str(os.getuid()), 'framerize-cooldown-' + nonce + '.sock')
+    request = dict(controller=process(os.getpid()), main=before['main'], sidecar=before['sidecar'],
+                   nonce=nonce, socket=str(path), at_unix=time.time())
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
+        server.bind(str(path))
+        path.chmod(0o600)
+        server.listen(1)
+        server.settimeout(150)
+        try:
+            target = output / 'memory-access.json'
+            save(target, request)
+            print(json.dumps({'phase': 'memory_access_ready', 'request_sha256': sha(target)}), flush=True)
+            connection, _ = server.accept()
+            with connection:
+                connection.settimeout(5)
+                return receive_one(connection, request)
+        finally:
+            path.unlink(missing_ok=True)
+
+
+def receive_one(connection, request):
+    _, uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
+    require(uid == 0, 'descriptor sender is not the authenticated helper')
+    raw, ancillary, flags, _ = connection.recvmsg(64, socket.CMSG_SPACE(4))
+    fds = array.array('i')
+    for level, kind, data in ancillary:
+        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
+            fds.frombytes(data[:len(data) - len(data) % fds.itemsize])
+    try:
+        require(not flags and raw == request['nonce'].encode() and len(fds) == 1,
+                'invalid descriptor message')
+        require(process(request['sidecar']['pid']) == request['sidecar'], 'capture target changed')
+        require(os.readlink('/proc/self/fd/' + str(fds[0])) ==
+                '/proc/' + str(request['sidecar']['pid']) + '/mem', 'wrong memory descriptor')
+        os.set_inheritable(fds[0], False)
+        return fds[0]
+    except BaseException:
+        for fd in fds:
+            os.close(fd)
+        raise
+
+
+if __name__ == '__main__':
+    import resource
+    import signal
+    import sys
+    require(len(sys.argv) in (2, 3) and re.fullmatch('[0-9a-f]{64}', sys.argv[1]) and
+            (len(sys.argv) == 2 or sys.argv[2] == '--rollback'),
+            'the exact request hash is required')
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+    resource.setrlimit(resource.RLIMIT_CPU, (10, 10))
+    bind_parent()
+    signal.alarm(12)
+    privileged_grant(sys.argv[1], 'rollback' if len(sys.argv) == 3 else 'activate')
+    print('{"descriptor_transferred":true}', flush=True)
