+"""Retain the exact installed launch files in both binary directions."""
+from pathlib import Path
+import stat
+
+class PreservedRuntime:
+    def __init__(self, original):
+        self.original = original
+        self.plan = original.plan
+        self.verify_files = original.verify_files
+
+    def verify_process(self, adapter, pid, old):
+        data = self.plan(adapter)
+        adapter.require(data['original_argv'] == data['candidate_argv'],
+                        'binary-only release changes launch arguments')
+        self.original.verify_process(adapter, pid, old=False)
+
+    def stage(self, adapter, record):
+        data = self.plan(adapter)
+        adapter.require(data['original_argv'] == data['candidate_argv'],
+                        'binary-only release changes launch arguments')
+        adapter.require(self.verify_files(adapter), 'installed runtime missing')
+        files = []
+        for label in ('config', 'dropin'):
+            item = data[label]
+            path = Path(item['destination'])
+            info = path.lstat()
+            adapter.require(stat.S_ISREG(info.st_mode), 'runtime is not a regular file')
+            files.append(dict(target=str(path), sha256=item['source']['sha256'],
+                              installed_identity=[info.st_dev, info.st_ino]))
+        record['runtime_launch'] = dict(files=files, preserved=True,
+            sha256=adapter.sha(adapter.HERE / 'runtime-launch.json'))
+        adapter.save(record)
+
+    def install(self, adapter, record, stopped, old=False):
+        adapter.require(type(old) is bool, 'invalid binary direction')
+        adapter.require_stopped(adapter.accepted_base(), stopped['before'])
+        data, saved = self.plan(adapter), record['runtime_launch']
+        adapter.require(saved['preserved'] is True and
+            saved['sha256'] == adapter.sha(adapter.HERE / 'runtime-launch.json'),
+            'preserved launch plan changed')
+        adapter.require(len(saved['files']) == 2, 'runtime inventory changed')
+        for item, label in zip(saved['files'], ('config', 'dropin')):
+            path = Path(item['target'])
+            info = path.lstat()
+            adapter.require(str(path) == data[label]['destination'] and
+                stat.S_ISREG(info.st_mode) and not path.is_symlink(), 'runtime target changed')
+            adapter.require(item['installed_identity'] == [info.st_dev, info.st_ino],
+                            'runtime file identity changed')
+            adapter.require(adapter.sha(path) == item['sha256'] ==
+                            data[label]['source']['sha256'], 'runtime bytes changed')
+        adapter.require(self.verify_files(adapter), 'installed runtime missing')
+        adapter.require_stopped(adapter.accepted_base(), stopped['before'])
