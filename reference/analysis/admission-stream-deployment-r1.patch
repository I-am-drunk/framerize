+"""Load the selected modules without subprocesses, networking or private reads."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+sys.path.insert(0, str(Path(__file__).resolve().parent / 'controller'))
+import recovery_binding as binding
+
+HERE = Path(__file__).resolve().parent
+INPUTS = json.loads((HERE / 'module-bindings.json').read_text())
+ALLOWED = {Path(p).resolve() for p in INPUTS['files']}
+CACHE = {Path(importlib.util.cache_from_source(str(p))) for p in ALLOWED}
+STDLIB = Path(os.__file__).resolve().parent
+GUARDED = False
+
+
+def audit(event, args):
+    if not GUARDED:
+        return
+    if event.startswith('socket.') or event in ('subprocess.Popen', 'os.system'):
+        raise AssertionError('live action forbidden in import fixture')
+    if event == 'open':
+        path, _mode, flags = args
+        assert isinstance(path, (str, bytes, os.PathLike))
+        target = Path(os.fsdecode(path)).resolve()
+        assert not flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND)
+        if target in CACHE and not target.exists():
+            return
+        assert target in ALLOWED or target.is_relative_to(STDLIB), 'unbound read: ' + str(target)
+
+
+sys.addaudithook(audit)
+
+
+def load_selected():
+    order = ('rollback_safety', 'window', 'control', 'observer', 'launch',
+             'startup_runtime', 'settlement_runtime', 'adapter', 'cooldown_transfer',
+             'fd_bridge', 'coordinator', 'recovery_identity', 'restoration')
+    return {name: binding.module(name, INPUTS['modules'][name]) for name in order}
+
+
+class ImportTests(unittest.TestCase):
+    def test_real_selected_modules_load_without_live_actions(self):
+        global GUARDED
+        with patch.dict(sys.modules):
+            GUARDED = True
+            try:
+                loaded = load_selected()
+                self.assertEqual(set(loaded), set(INPUTS['modules']))
+                self.assertEqual(loaded['adapter'].HERE, HERE)
+                self.assertEqual(loaded['adapter'].OLD_BIN,
+                    '9e03bde34d7ca68ed6ed58a38cf0a373f3bac6978383a1c0f603306d6589bfb8')
+                self.assertIs(loaded['recovery_identity'].require, binding.require)
+                driver_path = HERE / 'controller/driver.py'
+                driver = binding.module('new_driver', {
+                    'path': str(driver_path), 'sha256': binding.sha(driver_path)})
+                self.assertTrue(callable(driver.execute))
+            finally:
+                GUARDED = False
