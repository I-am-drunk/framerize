+"""Import selected recovery modules without installed state or live actions."""
+import json
+import importlib.util
+import os
+import sys
+import unittest
+from contextlib import contextmanager
+from pathlib import Path
+from unittest.mock import patch
+import recovery_binding as binding
+
+HERE = Path(__file__).resolve().parent
+INPUTS = json.loads((HERE.parent / 'module-bindings.json').read_bytes())
+ALLOWED = {Path(path).resolve() for path in INPUTS['files']}
+CACHE_PROBES = {Path(importlib.util.cache_from_source(str(path))) for path in ALLOWED}
+STDLIB = Path(os.__file__).resolve().parent
+GUARDED = False
+
+def audit(event, args):
+    if not GUARDED:
+        return
+    if event.startswith('socket.') or event in ('subprocess.Popen', 'os.system'):
+        raise AssertionError('live action forbidden in import fixture')
+    if event == 'open':
+        path, _mode, flags = args
+        assert isinstance(path, (str, bytes, os.PathLike)), 'unexpected file descriptor'
+        target = Path(os.fsdecode(path)).resolve()
+        assert not flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND)
+        if target in CACHE_PROBES and not target.exists():
+            return
+        assert target in ALLOWED or target.is_relative_to(STDLIB), 'unbound file read'
+
+sys.addaudithook(audit)
+
+@contextmanager
+def guarded_imports():
+    global GUARDED
+    with patch.dict(sys.modules):
+        sys.modules.pop('binding', None)
+        GUARDED = True
+        try:
+            yield
+        finally:
+            GUARDED = False
+
+class ModuleImportTests(unittest.TestCase):
+    def test_original_identity_has_unresolved_binding_import(self):
+        with guarded_imports(), self.assertRaises(ModuleNotFoundError) as caught:
+            binding.module('original_identity', INPUTS['original_identity'])
+        self.assertEqual(caught.exception.name, 'binding')
+
+    def test_all_selected_recovery_modules_load_without_live_actions(self):
+        order = ('rollback_safety', 'prior_recovery', 'adapter', 'cooldown_transfer',
+                 'restoration', 'window', 'control', 'recovery_identity', 'observer',
+                 'launch', 'startup_runtime', 'settlement_runtime', 'fd_bridge', 'coordinator')
+        with guarded_imports():
+            loaded = {name:binding.module(name, INPUTS['modules'][name]) for name in order}
+            self.assertEqual(set(loaded), set(INPUTS['modules']))
+            self.assertIs(loaded['recovery_identity'].require, binding.require)
+            self.assertIs(loaded['recovery_identity'].sha, binding.sha)
