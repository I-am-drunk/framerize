+"""Launch only the two inert selected-module import cases."""
+import hashlib
+import json
+import shutil
+import subprocess
+import time
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+UNIT = 'framerize-recovery-import-r3-fixture-20261023'
+mem = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
+available = int(mem['MemAvailable'].split()[0]) * 1024
+free = shutil.disk_usage(HERE).free
+assert available >= int(mem['MemTotal'].split()[0])*1024//10 + 640*1024**2, 'fixture memory reserve'
+assert free >= 1024**3, 'fixture disk reserve'
+paths = sorted(set([Path(path) for path in json.loads((HERE / 'module-bindings.json').read_bytes())['files']] + list(HERE.glob('*.py')) + list((HERE / 'controller').glob('*.py')) + [HERE / 'module-bindings.json', Path('/usr/bin/python3').resolve()]))
+pins = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
+def save(name, value):
+    with (HERE / name).open('x') as output:
+        json.dump(value, output, sort_keys=True, indent=2); output.write('\n')
+command = ['systemd-run', '--user', '--quiet', '--wait', '--pipe', '--collect',
+    '--unit=' + UNIT, '--property=Type=exec', '--property=MemoryMax=134217728',
+    '--property=MemorySwapMax=0', '--property=TasksMax=16', '--property=CPUQuota=50%',
+    '--property=RuntimeMaxSec=45', '--property=TimeoutStopSec=5',
+    '--property=KillMode=control-group', '--working-directory=' + str(HERE),
+    '/usr/bin/python3', '-I', '-B', '-S', str(HERE / 'run_checks.py')]
+save('admission.json', dict(at_unix=time.time(), memory_available=available,
+    disk_free=free, inputs=pins, command=command))
+started = time.monotonic()
+with (HERE / 'validation.log').open('x') as output:
+    result = subprocess.run(command, stdout=output, stderr=subprocess.STDOUT, timeout=55)
+save('launcher-result.json', dict(returncode=result.returncode,
+    elapsed_seconds=time.monotonic() - started, command=command))
+print(json.dumps(dict(returncode=result.returncode, directory=str(HERE))))
+raise SystemExit(result.returncode)
