+        cleared = context['clear'](adapter, record, current)
+        save(output / 'cleared-handoff.json', cleared)
+        current = adapter.snapshot(base)
+        require(adapter.same_processes(current, verified['current']),
+                'generation changed after handoff clearance')
+        live = adapter.observe_live_state(record['stops'][-1])
+        protection = context['recovery'].protected(adapter, record, current)
+        require(protection == verified['protected'], 'protected inputs changed before release')
+        values = recovery_checks.metrics(current)
+        recovery_checks.no_events(values)
+        require(values['memory.swap.current'] == values['memory.swap.peak'] == '0',
+                'service swap appeared before hold release')
+        controls.assert_held()
+        require(adapter.same_processes(current, adapter.snapshot(base)),
+                'generation changed before hold release')
+        controls.release()
+        record['hold_released'] = True
+        marker = Path('/home/tjninja/.local/state/framerize-recovery/maintenance')
+        require(not marker.exists(), 'maintenance marker remains')
+        record['status'] = 'RESTORED_RUNTIME_HOLD_RELEASED'
+        adapter.save(record)
+        result = dict(status=record['status'], current=current, final_live_state=live,
+            metrics=values, protected=protection, post_recovery=pin(output / 'post-recovery.json'),
+            state=pin(adapter.RECEIPT), marker_absent=True, browserless_accepted=False)
