+"""Input diagnosis and strict post-recovery checks. No work runs on import."""
+from pathlib import Path
+from recovery_binding import require
+
+
+def metrics(current):
+    root = Path('/sys/fs/cgroup' + current['cgroup'])
+    return {name: (root / name).read_text().strip() for name in (
+        'memory.current', 'memory.peak', 'memory.swap.current',
+        'memory.swap.peak', 'memory.swap.max', 'memory.events')}
+
+
+def no_events(values):
+    require(all(row.split()[1] == '0' for row in values['memory.events'].splitlines()),
+            'service resource event detected')
+
+
