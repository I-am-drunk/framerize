+"""Run only the eight inert recovery cases under the explicit test unit."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import sys
+import time
+import unittest
+HERE = Path(__file__).resolve().parent
+unit = sys.argv[1]
+group = Path('/sys/fs/cgroup' + Path('/proc/self/cgroup').read_text().split('0::')[1].strip())
+assert group.name == unit + '.service' and unit.startswith('framerize-recovery-fixture-')
+for name, value in (('memory.max', str(64 * 1024**2)), ('memory.swap.max', '0'), ('pids.max', '8')):
+    assert (group / name).read_text().strip() == value
+started = time.time()
+inputs = json.loads((HERE / 'test-inputs.json').read_text())
+for name, digest in inputs.items():
+    assert hashlib.sha256(Path(name).read_bytes()).hexdigest() == digest
+sys.path.insert(0, str(HERE / 'controller'))
+import test_recovery
+suite = unittest.defaultTestLoader.loadTestsFromModule(test_recovery)
+assert suite.countTestCases() == 8
+result = unittest.TextTestRunner(verbosity=2).run(suite)
+metrics = {name: (group / name).read_text().strip() for name in (
+    'memory.peak', 'memory.swap.current', 'memory.swap.peak', 'memory.events', 'pids.peak')}
+for name, digest in inputs.items():
+    assert hashlib.sha256(Path(name).read_bytes()).hexdigest() == digest
+passed = result.wasSuccessful() and result.testsRun == 8 and not result.skipped
+resources_ok = metrics['memory.swap.current'] == metrics['memory.swap.peak'] == '0'
+resources_ok &= all(row.split()[1] == '0' for row in metrics['memory.events'].splitlines())
+payload = dict(accepted=passed and resources_ok, tests_run=result.testsRun,
+    cases=unittest.defaultTestLoader.getTestCaseNames(test_recovery.RecoveryTests),
+    inputs=inputs, unit=unit, cgroup=str(group), metrics=metrics,
+    started_at=started, completed_at=time.time(), service_action=False)
+path = HERE / 'test-result.json'
+temporary = HERE / 'test-result.json.tmp'
+fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+with os.fdopen(fd, 'w') as stream:
+    json.dump(payload, stream, indent=2); stream.write('\n')
