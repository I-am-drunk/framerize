+
+
+class RecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.output = Path(self.temporary.name)
+        self.current = dict(main={'pid': 100}, sidecar={'pid': 101})
+        self.protected = {'fingerprint': 'original'}
+        self.record = dict(status='recovery_preflight', release={}, current=self.current,
+                           stops=[{}], pool_residency={}, pool_verified={})
+        self.adapter, self.controls, self.observer = Mock(), Mock(spec=['assert_held', 'release']), Mock()
+        self.adapter.OLD_BIN = self.adapter.OLD_PY = 'same'
+        self.adapter.sha.return_value = 'same'
+        self.adapter.snapshot.return_value = self.current
+        self.adapter.same_processes.side_effect = lambda a, b: a == b
+        self.adapter.RECEIPT = self.output / 'state.json'
+        self.adapter.save.side_effect = lambda r: driver.save(self.adapter.RECEIPT, r)
+        self.adapter.observe_live_state.return_value = {'unchanged': True}
+        self.adapter.verify_started.return_value = self.current
+        self.adapter.stop_for_change.return_value = {}
+        self.recovery, self.clear = Mock(), Mock(return_value={'cleared': True})
+        self.recovery.protected.return_value = self.protected
+        self.values = {'memory.swap.current': '0', 'memory.swap.peak': '0',
+                       'memory.events': 'oom 0\noom_kill 0'}
+        self.fd = os.open(os.devnull, os.O_RDONLY)
+        loaded = dict(
+            fd_bridge=SimpleNamespace(receive_descriptor=lambda *_: self.fd),
+            cooldown_transfer=SimpleNamespace(Transfer=Mock()),
+            settlement_runtime=SimpleNamespace(Settlement=Mock(return_value=Mock())),
+            startup_runtime=SimpleNamespace(StartupObserver=Mock(return_value=self.observer)),
+            coordinator=SimpleNamespace(Coordinator=Mock(return_value=Mock())))
+        loaded['coordinator'].Coordinator.return_value.wait_drain.return_value = {'drained': True}
+        self.context = dict(adapter=self.adapter, record=self.record, controls=self.controls,
+            loaded=loaded, base=Mock(), output=self.output, recovery=self.recovery,
+            before=dict(current=self.current, protected=self.protected), coordination={},
+            sources={}, capture={}, restore=Mock(return_value={'restored': True}), clear=self.clear)
+        self.metric_patch = patch.object(driver.recovery_checks, 'metrics', return_value=self.values)
+        self.metric_patch.start()
+        self.addCleanup(self.metric_patch.stop)
+        marker = Mock()
+        marker.exists.return_value = False
+        self.path_patch = patch.object(driver, 'Path', return_value=marker)
+        self.path_patch.start()
+        self.addCleanup(self.path_patch.stop)
+
+    def tearDown(self):
+        self.observer.close.assert_called_once()
+        with self.assertRaises(OSError):
+            os.fstat(self.fd)
+
+    def refused(self, message):
+        with self.assertRaisesRegex(RuntimeError, message):
+            driver.execute(self.context)
+        self.controls.release.assert_not_called()
+        self.assertFalse((self.output / 'released.json').exists())
