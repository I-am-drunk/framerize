+    controls = cls(coordination, sources)
+    controls.marker_identity = held.marker_identity
+    controls.marker_sha256 = held.marker_sha256
+    controls.boot_id = held.boot_id
+    controls.acquired_at = time.monotonic()
+    controls.assert_held()
