+"""One coordinated restart of the installed runtime under the existing hold."""
+from pathlib import Path
+import argparse
+import copy
+import json
+import os
+import subprocess
+import sys
+import time
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from recovery_binding import checked_plan, document, module, require, save, sha
+import recovery_checks
+
+
+def pin(path):
+    return dict(path=str(path), sha256=sha(path))
+
+
+def require_supervisor():
+    relative = Path('/proc/self/cgroup').read_text().split('0::')[1].strip().lstrip('/')
+    group = Path('/sys/fs/cgroup') / relative
+    require(group.name.startswith('framerize-r16-recover-') and
+            group.name.endswith('.service'), 'reviewed supervisor is required')
+    for name, expected in (('memory.max', str(128 * 1024**2)),
+                           ('memory.swap.max', '0'), ('pids.max', '32')):
+        require((group / name).read_text().strip() == expected, 'supervisor limit differs')
+    duration = subprocess.check_output(['systemctl', '--user', 'show', group.name,
+        '-p', 'RuntimeMaxUSec', '--value'], text=True, timeout=5).strip()
+    require(duration in ('45min', '2700s'), 'external deadline differs')
+
+
+def prepare(plan, coordination, bindings):
+    output = Path(plan['execution_dir'])
+    require(output == Path(__file__).resolve().parent / 'execution', 'wrong output path')
+    output.mkdir(mode=0o700)
+    recovery = module('prior_recovery', plan['modules']['prior_recovery'])
+    adapter, held, record, restore, clear = recovery.prepare()
+    before = recovery_checks.existing(recovery, adapter, held, record, restore)
+    save(output / 'input-inspection.json', before)
+    names = ('observer', 'launch', 'startup_runtime', 'settlement_runtime',
+             'cooldown_transfer', 'fd_bridge', 'coordinator', 'recovery_identity')
+    loaded = {name: module(name, plan['modules'][name]) for name in names}
+    guard = document(plan['guard_identity'])
+    require(loaded['recovery_identity'].identity() == guard, 'recovery producer changed')
+    base = adapter.accepted_base()
+    capture = loaded['launch'].capture_launch(adapter, base, adapter.OLD_BIN)
+    require(adapter.same_processes(capture['prior'], before['current']),
+            'generation changed before launch capture')
+    capture_path = output / 'launch-capture.json'
+    save(capture_path, capture)
+    sources = dict(plan['sources']) | plan['evidence'] | bindings
+    sources[str(capture_path)] = sha(capture_path)
