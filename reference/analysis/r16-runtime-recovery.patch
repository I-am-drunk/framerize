+    def persist(value):
+        value['updated_at_unix'] = time.time()
+        save(adapter.RECEIPT, value)
+    adapter.save = persist
+    persist(record)
+    return dict(recovery=recovery, adapter=adapter, controls=controls, record=record,
+        restore=restore, clear=clear, before=before, loaded=loaded, base=base,
+        output=output, sources=sources, capture=capture, coordination=coordination)
+
+
+def execute(context):
+    adapter, record = context['adapter'], context['record']
+    controls, loaded = context['controls'], context['loaded']
+    base, output = context['base'], context['output']
+    before, coordination = context['before']['current'], context['coordination']
+    fd = loaded['fd_bridge'].receive_descriptor(before, output, save)
+    observer = None
+    try:
+        adapter.TRANSFER = loaded['cooldown_transfer'].Transfer(
+            adapter, controls, before['sidecar'], fd)
+        settlement = loaded['settlement_runtime'].Settlement(adapter, base, controls)
+        observer = loaded['startup_runtime'].StartupObserver(
+            adapter, base, controls.assert_held, context['sources'], context['capture'])
+        coordinator = loaded['coordinator'].Coordinator(adapter, base, controls,
+            settlement, lambda: observer, lambda value: None, lambda: coordination)
+        coordinator.wait_known_guard(before)
+        record['recovery_drain'] = coordinator.wait_drain(coordination)
