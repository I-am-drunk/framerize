+"""Terminal-owned, bounded request for the single privileged descriptor open."""
+import hashlib
+import os
+import resource
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+BRIDGE_SHA = 'b10952d9bcffe6d3d98e76fe923fcad243ff4d242c1b89fb71e808db6fccb7c5'
+STOP_REQUESTED = False
+
+
+def request_stop(_number, _frame):
+    global STOP_REQUESTED
+    STOP_REQUESTED = True
+
+
+def main(purpose, parent):
+    if purpose not in ('activate', 'rollback'):
+        raise ValueError('unknown operation')
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+    resource.setrlimit(resource.RLIMIT_CPU, (20, 20))
+    if type(parent) is not int or parent <= 1 or os.getppid() != parent:
+        raise RuntimeError('authorization owner changed before entry')
+    deadline = time.monotonic() + 180
+    directory = 'controller' if purpose == 'activate' else 'manual'
+    request = HERE / directory / 'execution/memory-access.json'
+    while not request.exists():
+        if STOP_REQUESTED or os.getppid() != parent or time.monotonic() >= deadline:
+            raise RuntimeError('controller did not request memory access')
+        time.sleep(0.2)
+    bridge = HERE / 'fd_bridge.py'
+    if hashlib.sha256(bridge.read_bytes()).hexdigest() != BRIDGE_SHA:
+        raise RuntimeError('privileged helper changed')
+    with request.open('rb') as stream:
+        raw = stream.read(16385)
+    if len(raw) > 16384:
+        raise RuntimeError('oversized memory-access request')
+    command = ['sudo', '-n', '--', '/usr/bin/python3', '-I', '-B', '-S', str(bridge),
+               hashlib.sha256(raw).hexdigest()]
+    if purpose == 'rollback':
+        command.append('--rollback')
+    run_owned(command, 140, parent)
+
+
+def run_owned(command, timeout, parent=None):
+    parent = os.getppid() if parent is None else parent
+    if STOP_REQUESTED or parent <= 1 or os.getppid() != parent:
+        raise InterruptedError('authorization owner exited before spawn')
+    child = subprocess.Popen(command)
+    try:
+        deadline = time.monotonic() + timeout
+        while child.poll() is None:
+            if STOP_REQUESTED or os.getppid() != parent or time.monotonic() >= deadline:
+                raise InterruptedError('authorization cancelled or expired')
+            time.sleep(0.1)
+        if child.returncode:
+            raise RuntimeError('descriptor authorization failed')
+    finally:
+        if child.poll() is None:
+            try:
+                child.terminate()
+            except (ProcessLookupError, PermissionError):
+                pass
+        try:
+            child.wait(timeout=20)
+        except subprocess.TimeoutExpired:
+            child.kill()
+            child.wait(timeout=5)
+            raise RuntimeError('authorization required forced cleanup')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 3 or sys.flags.optimize:
+        raise SystemExit('an explicit operation and unoptimized Python are required')
+    signal.signal(signal.SIGTERM, request_stop)
+    signal.signal(signal.SIGINT, request_stop)
+    main(sys.argv[1], int(sys.argv[2]))
