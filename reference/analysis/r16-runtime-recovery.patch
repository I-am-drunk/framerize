+"""Exact source and result binding for the fixed deployment controller."""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import os
+import sys
+
+
+def require(ok, message):
+    if not ok:
+        raise RuntimeError(message)
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def document(pin):
+    path = Path(pin['path'])
+    require(path.is_absolute() and sha(path) == pin['sha256'], 'pinned input changed')
+    require(path.stat().st_size <= 4 * 1024**2, 'oversized controller input')
+    return json.loads(path.read_text())
+
+
+def module(name, pin):
+    path = Path(pin['path'])
+    require(sha(path) == pin['sha256'], 'module bytes changed')
+    sys.dont_write_bytecode = True
+    spec = importlib.util.spec_from_file_location(name, path)
+    result = importlib.util.module_from_spec(spec)
+    sys.modules[name] = result
+    spec.loader.exec_module(result)
+    require(sha(path) == pin['sha256'], 'module changed while loading')
+    return result
+
+
+def save(path, data):
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    with open(temporary, 'w', opener=lambda p, f: os.open(p, f, 0o600)) as stream:
+        json.dump(data, stream, indent=2, allow_nan=False)
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(temporary, path)
+    fd = os.open(path.parent, os.O_DIRECTORY | os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def checked_plan(plan_pin, review_pin):
+    plan, review = document(plan_pin), document(review_pin)
+    require(review.get('accepted') is True and review.get('status') == 'ACCEPTED_FOR_OWNED_RUNTIME_RECOVERY',
+            'controller source/results review is missing')
+    require(review.get('plan_sha256') == plan_pin['sha256'], 'review covers another plan')
+    for group in ('sources', 'evidence'):
+        require(isinstance(plan[group], dict) and plan[group], 'empty controller binding')
+        for path, digest in plan[group].items():
+            require(Path(path).is_absolute() and sha(path) == digest, 'bound input changed')
+    for pin in plan['modules'].values():
+        require(plan['sources'].get(pin['path']) == pin['sha256'], 'unbound module')
+    require(plan['max_settlement_seconds'] == 900 and plan['outer_seconds'] == 2700,
+            'unreviewed deployment time limits')
+    require(plan.get('purpose') == 'RECOVER_INSTALLED_RUNTIME_WITH_OWNED_HOLD', 'wrong recovery scope')
+    return plan
