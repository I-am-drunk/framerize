+        adapter.save(record)
+        stopped = adapter.stop_for_change(base, bound, record, before, coordination,
+            settlement.authorize_client_drain, observer)
+        adapter.settle_stopped(base, record, stopped, settlement.settle_after_stop)
+        adapter.bind_startup(base, record, observer, stopped, old=True)
+        adapter.before_start(base, record, stopped, observer)
+        adapter.start_service(base, record, stopped, old=True)
+        current = adapter.verify_started(base, bound, record, old=True)
+        adapter.finish_startup(base, record, current, observer, old=True)
