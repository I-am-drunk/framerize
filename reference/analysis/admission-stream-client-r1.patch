+"""Inert framing and socket-lifetime regressions for the live-check client."""
+import http.client
+import json
+import socket
+import time
+import unittest
+from frames import Frames
+from streaming import Stream
+
+def event(kind, **fields):
+    return ('event: ' + kind + '\ndata: ' + json.dumps({'type': kind, **fields})
+            + '\n\n').encode()
+
+OPEN = event('response.created', response={'status': 'in_progress'})
+TEXT = event('response.output_text.delta', delta='OK')
+END = event('response.completed', response={'status': 'completed', 'output': [
+    {'content': [{'type': 'output_text', 'text': 'OK'}]}]})
+
+class FramingTests(unittest.TestCase):
+    def test_opening_frames_are_not_completion(self):
+        frames = Frames()
+        frames.feed(OPEN)
+        self.assertEqual(frames.completed, 0)
+        with self.assertRaisesRegex(RuntimeError, 'missing_terminal_completion'):
+            frames.finish()
+
+    def test_complete_stream_accepts_fragmented_crlf_without_retaining_text(self):
+        frames = Frames()
+        for byte in (OPEN + TEXT + END).replace(b'\n', b'\r\n'):
+            frames.feed(bytes([byte]))
+        frames.finish()
+        self.assertEqual(frames.public()['text_characters'], 2)
+        self.assertNotIn('OK', json.dumps(frames.public()))
+
+    def test_terminal_errors_cannot_pass_as_output(self):
+        for kind in ('error', 'response.failed', 'response.incomplete'):
+            with self.subTest(kind=kind):
+                with self.assertRaisesRegex(RuntimeError, 'stream_error'):
+                    Frames().feed(event(kind))
+
+    def test_done_without_completed_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, 'done_without_completion'):
+            Frames().feed(b'data: [DONE]\n\n')
+
+    def test_truncated_frame_is_rejected(self):
+        frames = Frames()
+        frames.feed(END[:-1])
+        with self.assertRaisesRegex(RuntimeError, 'partial_stream_frame'):
+            frames.finish()
+
+    def test_empty_completion_is_rejected(self):
+        frames = Frames()
+        frames.feed(event('response.completed', response={'status': 'completed'}))
+        with self.assertRaisesRegex(RuntimeError, 'empty_stream_output'):
+            frames.finish()
+
+    def test_late_event_and_oversized_stream_are_rejected(self):
+        frames = Frames()
+        frames.feed(END)
+        with self.assertRaisesRegex(RuntimeError, 'event_after_completion'):
+            frames.feed(TEXT)
+        with self.assertRaisesRegex(RuntimeError, 'stream_byte_limit'):
+            Frames().feed(b' ' * 65537)
