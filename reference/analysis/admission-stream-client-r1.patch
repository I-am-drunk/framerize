+"""Real local sockets, with no network listener or application service."""
+import http.client
+import socket
+import time
+import unittest
+from streaming import Stream
+from test_streaming import OPEN, TEXT, END
+
+class SocketTests(unittest.TestCase):
+    def connected(self, payload):
+        client, peer = socket.socketpair()
+        client.settimeout(2)
+        peer.settimeout(2)
+        self.addCleanup(peer.close)
+        connection = http.client.HTTPConnection('fixture.invalid')
+        connection.sock = client
+        connection.request('POST', '/fixture', body=b'')
+        peer.recv(4096)
+        peer.sendall(b'HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n'
+                     b'Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n' + payload)
+        stream = Stream(connection)
+        self.addCleanup(stream.close)
+        return connection, peer, stream
+
+    def wait_for(self, stream, predicate):
+        deadline = time.monotonic() + 2
+        while not predicate(stream.snapshot()):
+            self.assertLess(time.monotonic(), deadline, stream.snapshot())
+            time.sleep(0.005)
+
+    @staticmethod
+    def chunk(data):
+        return ('%x\r\n' % len(data)).encode() + data + b'\r\n'
+
+    def test_disconnect_closes_detached_live_response_socket(self):
+        connection, peer, stream = self.connected(self.chunk(OPEN))
+        self.wait_for(stream, lambda state: state['events'] == 1)
+        self.assertIsNone(connection.sock)
+        self.assertEqual(stream.snapshot()['terminal_completions'], 0)
+        stream.close(cancel=True)
+        self.assertEqual(peer.recv(1), b'')
+        self.assertFalse(stream.reader.is_alive())
+        self.assertIn('disconnected_at_unix', stream.snapshot())
+
+    def test_complete_stream_requires_clean_http_end(self):
+        _, _, stream = self.connected(self.chunk(OPEN + TEXT + END) + b'0\r\n\r\n')
+        self.wait_for(stream, lambda state: state['finished'])
+        state = stream.snapshot()
+        self.assertIsNone(state['read_error'])
+        self.assertTrue(state['eof'])
+        self.assertEqual(state['text_characters'], 2)
+
+    def test_truncated_http_after_terminal_is_not_success(self):
+        _, peer, stream = self.connected(self.chunk(OPEN + TEXT + END))
+        peer.shutdown(socket.SHUT_WR)
+        self.wait_for(stream, lambda state: state['finished'])
+        self.assertIsNotNone(stream.snapshot()['read_error'])
+        self.assertFalse(stream.snapshot()['eof'])
+
+    def test_completed_response_cannot_be_claimed_as_cancelled(self):
+        _, _, stream = self.connected(self.chunk(END) + b'0\r\n\r\n')
+        self.wait_for(stream, lambda state: state['finished'])
+        with self.assertRaisesRegex(RuntimeError, 'stream_finished_before_disconnect'):
+            stream.close(cancel=True)
+        self.assertNotIn('disconnected_at_unix', stream.snapshot())
