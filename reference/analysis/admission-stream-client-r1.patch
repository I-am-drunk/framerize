+"""Request limits and admission guards without live inputs."""
+import json
+import unittest
+from unittest.mock import Mock, patch
+import run as client
+from checks import pending, quiet
+
+class BoundsTests(unittest.TestCase):
+    def test_two_normal_streams_only(self):
+        report = {'post_calls': 0}
+        with patch.object(client.http.client, 'HTTPConnection') as factory, \
+                patch.object(client, 'Stream'):
+            client.send('fixture', 'gpt-4.1', True, report)
+            client.send('fixture', 'gpt-4.1', False, report)
+            with self.assertRaisesRegex(RuntimeError, 'post_limit'):
+                client.send('fixture', 'gpt-4.1', False, report)
+        calls = factory.return_value.request.call_args_list
+        self.assertEqual(len(calls), 2)
+        self.assertEqual([json.loads(c.kwargs['body'])['max_output_tokens']
+                          for c in calls], [700, 16])
+        for call in calls:
+            self.assertEqual(call.args, ('POST', '/openai/v1/responses'))
+            self.assertIs(json.loads(call.kwargs['body'])['stream'], True)
+        self.assertNotEqual(calls[0].kwargs['headers']['x-framerize-session'],
+                            calls[1].kwargs['headers']['x-framerize-session'])
+
+    def test_active_and_unknown_cleanup_do_not_pass_settlement(self):
+        for user, uncertain, closing in [(1, False, False), (0, True, False),
+                                         (0, False, True)]:
+            self.assertFalse(quiet({'residency': {'residents': [dict(
+                users=user, uncertain=uncertain, close_started=closing)]}}))
+
+    def test_open_frames_are_pending_but_terminal_or_error_is_not(self):
+        state = dict(read_error=None, finished=False, eof=False,
+                     terminal_completions=0, status=200, events=1)
+        stream = Mock()
+        stream.snapshot.return_value = state
+        self.assertEqual(pending(stream), state)
+        for field, value in [('finished', True), ('eof', True),
+                             ('terminal_completions', 1), ('read_error', 'error')]:
+            with self.subTest(field=field):
+                stream.snapshot.return_value = state | {field: value}
+                with self.assertRaises(RuntimeError):
+                    pending(stream)
