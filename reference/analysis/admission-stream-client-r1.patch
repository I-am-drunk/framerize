+"""One bounded fixture run with private profiles and networking unavailable."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import subprocess
+import time
+
+HERE = Path(__file__).resolve().parent
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+resource.setrlimit(resource.RLIMIT_CPU, (10, 10))
+resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+paths = sorted(HERE.glob('*.py')) + [Path('/usr/bin/python3.12'), Path('/usr/bin/bwrap')]
+before = {str(path): sha(path) for path in paths}
+argv = ['/usr/bin/bwrap', '--die-with-parent', '--unshare-net', '--ro-bind', '/', '/',
+        '--tmpfs', '/tmp', '--tmpfs', '/home/tjninja/.framerize', '--dev', '/dev',
+        '--proc', '/proc', '--chdir', str(HERE), '/usr/bin/python3.12', '-B',
+        '-m', 'unittest', '-v', 'test_streaming', 'test_socket', 'test_bounds']
+started = time.time()
+result = subprocess.run(argv, capture_output=True, text=True, timeout=15,
+    env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C.UTF-8', 'PYTHONDONTWRITEBYTECODE': '1'})
+after = {str(path): sha(path) for path in paths}
+accepted = before == after and result.returncode == 0
+report = dict(accepted=accepted, inputs=before, after=after, argv=argv,
+    exit_code=result.returncode, stdout=result.stdout, stderr=result.stderr,
+    started_at_unix=started, finished_at_unix=time.time(),
+    child_peak_rss_kib=resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,
+    scope='Local framing, socket lifetime and request limits; no live application or input.',
+    controls=dict(network_namespace='isolated', private_profiles='masked',
+                  address_space_bytes=128 * 1024**2, cpu_seconds=10, wall_seconds=15),
+    limitations=['RSS is a child high-water mark; no aggregate cgroup or swap claim.'])
+path = HERE / ('validation-' + str(time.time_ns()) + '.json')
