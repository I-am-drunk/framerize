+"""Observe start, HEAD, disconnect and joined completion in that order."""
+import datetime
+import http.client
+import time
+from support import pool, require
+
+def quiet(value):
+    return all(row['users'] == 0 and not row['uncertain'] and
+               not row['close_started'] for row in value['residency']['residents'])
+
+def observe(events, report, base, service):
+    events.poll()
+    report['events'] = events.public
+    report['memory_samples'].append({'at_unix': time.time(),
+                                    'values': base.memory_snapshot(service)})
+    require(len(report['memory_samples']) <= 2500, 'sample_limit')
+    require(events.count('operation.admission.refused') == 0, 'admission_refused')
+
+def head_probe(report):
+    connection = http.client.HTTPConnection('127.0.0.1', 8787, timeout=5)
+    try:
+        started = time.time()
+        connection.request('HEAD', '/anthropic/api/hello',
+                           headers={'Connection': 'close'})
+        response = connection.getresponse()
+        body = response.read(1)
+        require(response.status == 200 and not body and
+                response.getheader('Content-Length') == '2', 'hello_head_failed')
+        report['hello_head'] = {'path': '/anthropic/api/hello', 'method': 'HEAD',
+            'started_at_unix': started, 'finished_at_unix': time.time(),
+            'status': response.status, 'body_bytes': len(body), 'content_length': 2}
+    finally:
+        connection.close()
+
+def pending(stream):
+    state = stream.snapshot()
+    require(state['read_error'] is None, 'cancel_stream_error')
+    require(not state['finished'] and not state['eof'] and
+            state['terminal_completions'] == 0, 'stream_finished_before_disconnect')
+    return state
+
+def cancel_request(stream, events, report, base, service, account):
+    deadline = time.monotonic() + 70
+    while True:
+        observe(events, report, base, service)
+        state = pending(stream)
+        require(time.monotonic() < deadline, 'start_not_observed')
+        require(events.count('ai.post') == events.count('ai.chain') == 0,
+                'call_finished_before_disconnect')
+        require(events.count('ai.post.started') <= 1, 'competing_call')
+        if events.count('ai.post.started') and state['status'] == 200 and state['events']:
+            started = [r for r in events.seen if r.get('event') == 'ai.post.started']
+            require(started[0].get('path') == '/ai/v3/responses/', 'unexpected_started_route')
+            rows = pool()['residency']['residents']
+            require(sum(r['users'] for r in rows) == 1 and any(
+                r['account'] == account and r['users'] == 1 for r in rows), 'competing_work')
+            report['start_observed_at_unix'] = time.time()
+            report['cancel_stream_before_head'] = state
+            break
+        time.sleep(0.1)
+    head_probe(report)
+    observe(events, report, base, service)
+    report['cancel_stream_before_disconnect'] = pending(stream)
+    require(events.count('ai.post.started') == 1 and events.count('ai.post') ==
+            events.count('ai.chain') == 0, 'call_completed_during_head')
+    stream.close(cancel=True)
+    report['disconnected_at_unix'] = stream.snapshot()['disconnected_at_unix']
+    deadline = time.monotonic() + 190
+    while events.count('ai.chain') < 1:
+        observe(events, report, base, service)
+        require(events.count('ai.post.started') == 1, 'new_attempt_after_disconnect')
+        require(time.monotonic() < deadline, 'call_completion_unconfirmed')
+        time.sleep(0.1)
+    require(events.count('ai.chain') == events.count('ai.post') == 1,
+            'browser_completion_unconfirmed')
+    completed = [r for r in events.seen if r.get('event') in ('ai.post', 'ai.chain')]
+    for row in completed:
+        timestamp = datetime.datetime.fromisoformat(row['ts'].replace('Z', '+00:00'))
+        require(timestamp.timestamp() > report['disconnected_at_unix'],
+                'completion_predates_disconnect')
+    require(events.count('ai.chain.repick') == 0, 'repick_after_disconnect')
+    report['completion_observed_at_unix'] = time.time()
+
+def complete_request(stream, events, report, base, service):
+    deadline = time.monotonic() + 65
+    while True:
+        observe(events, report, base, service)
+        state = stream.snapshot()
+        require(state['read_error'] is None, 'delivery_stream_error')
+        if state['finished']:
+            report['response'] = state
+            require(state['status'] == 200 and state['eof'] and
+                    state['terminal_completions'] == 1 and state['text_characters'] > 0,
+                    'normal_stream_incomplete')
+            report['response_complete_at_unix'] = time.time()
+            return
+        require(time.monotonic() < deadline, 'response_deadline')
+        time.sleep(0.1)
+
+def settled(events, report, base, service):
+    deadline = time.monotonic() + 10
+    while True:
+        observe(events, report, base, service)
+        if quiet(pool()):
+            report['cleanup_observed_at_unix'] = time.time()
+            return
+        require(time.monotonic() < deadline, 'local_cleanup_unconfirmed')
+        time.sleep(0.2)
