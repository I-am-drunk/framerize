+"""Retain the accepted supervisor and replace only the prepared mount layer."""
+import hashlib
+import importlib.util
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+base_path = HERE / 'run_onboarding.py'
+raw = base_path.read_bytes()
+assert hashlib.sha256(raw).hexdigest() == 'ac7ff8e7e990b1ed1e9d5a24007e63f72f727fa983610cd33d2a74a142099244'
+spec = importlib.util.spec_from_file_location('retained_onboarding_runner', base_path)
+base = importlib.util.module_from_spec(spec)
+exec(compile(raw, str(base_path), 'exec'), base.__dict__)
+runner = base.runner
+
+
+def onboarding_mounts():
+    sys.path.insert(0, str(HERE))
+    from compact_mounts import mounts
+    from runtime_mounts_r2 import extra_mounts
+    return mounts() + extra_mounts(HERE)
+
+
+runner.onboarding_mounts = onboarding_mounts
+original_inputs = runner.inputs
+
+
+def inputs(phase, attempt, expected):
+    value = original_inputs(phase, attempt, expected)
+    sys.path.insert(0, str(HERE))
+    from compact_mounts import verify_stage
+    verify_stage()
+    return value
+
+
+runner.inputs = inputs
+if __name__ == '__main__':
+    assert sys.argv[1:3] == ['onboarding', 'r2'], 'wrong compact attempt'
+    raise SystemExit(runner.main())
