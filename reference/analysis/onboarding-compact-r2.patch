+"""Use the pinned compact software tree with the existing onboarding boundary."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+STAGE = HERE.parent / 'onboarding-software-stage-r1'
+PLAN_SHA = '6c30525caf57ce7bec3da535bfb701bc8617cc3777c0274fdce7ce498033fbb0'
+VERIFY_SHA = '1224a335d7f3ce29b1bb453a53aaf19fb7d99e2242aa211e1d0a036ad13b4985'
+
+
+def plan():
+    raw = (STAGE / 'compact-plan.json').read_bytes()
+    assert hashlib.sha256(raw).hexdigest() == PLAN_SHA, 'compact plan changed'
+    return json.loads(raw)
+
+
+def verify_stage():
+    path = STAGE / 'finish_tree.py'
+    raw = path.read_bytes()
+    assert hashlib.sha256(raw).hexdigest() == VERIFY_SHA, 'stage verifier changed'
+    spec = importlib.util.spec_from_file_location('owned_stage_verifier', path)
+    module = importlib.util.module_from_spec(spec)
+    exec(compile(raw, str(path), 'exec'), module.__dict__)
+    modes = {}
+    for path in (STAGE / 'batches').glob('*.json'):
+        modes.update({row['source']: row for row in json.loads(path.read_text())})
+    return module.verify(STAGE / 'tree', plan(), modes, True)
+
+
+def mounts():
+    args = list(plan()['argv'])
+    for kind in ('net', 'pid'):
+        args += ['--setenv', 'CHECK_PARENT_' + kind.upper() + 'NS',
+                 os.readlink('/proc/self/ns/' + kind)]
+    args += ['--setenv', 'TOKIO_WORKER_THREADS', '2']
+    assert len(args) + 256 < 9000, 'complete argument reserve'
+    assert sum(len(arg.encode()) + 9 for arg in args) < os.sysconf('SC_ARG_MAX') - 65536
+    return args
