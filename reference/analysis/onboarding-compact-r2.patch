+import json, os, tempfile, unittest
+from pathlib import Path
+from create_private import create
+from runtime_mounts_r2 import extra_mounts
+
+class RuntimeMountTests(unittest.TestCase):
+    def setup_view(self, root):
+        view = dict(account_state=str(root/'private'),
+                    environment_root=str(root/'private-environment'))
+        (root/'dependency-view.json').write_text(json.dumps(view))
+        files = [root/name for name in ('lifecycle.py', 'layout.py', 'launch-plan.json')]
+        for path in files: path.write_text('')
+        plan = dict(private=str(root/'private'), control_files=list(map(str, files)))
+        (root/'launch-plan.json').write_text(json.dumps(plan))
+        runtime = root/'onboarding-r2'
+        (runtime/'tmp').mkdir(parents=True)
+        (runtime/'receipt.json').write_text('{}')
+        return plan
+
+    def test_only_empty_account_store_is_writable(self):
+        with tempfile.TemporaryDirectory() as raw:
+            root = Path(raw)
+            self.setup_view(root)
+            create(root)
+            args = extra_mounts(root)
+            self.assertEqual(args.count('--ro-bind'), 3)
+            self.assertEqual(args[-3:], ['--bind', str(root/'private'), str(root/'private')])
+            self.assertEqual(args.count('--bind'), 1)
+            self.assertFalse((root/'private-environment').exists())
+
+    def test_existing_state_and_unbound_working_directory_refuse(self):
+        for defect in ('state', 'cwd', 'symlink', 'wrong-plan'):
+            with self.subTest(defect=defect), tempfile.TemporaryDirectory() as raw:
+                root = Path(raw)
+                plan = self.setup_view(root)
+                create(root)
+                if defect == 'state': (root/'private/account.db').write_text('fixture')
+                if defect == 'cwd': (root/'onboarding-r2/$').mkdir()
+                if defect == 'symlink':
+                    (root/'private').rmdir()
+                    (root/'private').symlink_to(root/'onboarding-r2', target_is_directory=True)
+                if defect == 'wrong-plan':
+                    plan['private'] = str(root/'other')
+                    (root/'launch-plan.json').write_text(json.dumps(plan))
+                with self.assertRaises(AssertionError): extra_mounts(root)
+
+    def test_initialization_is_single_use_and_does_not_create_environment(self):
+        with tempfile.TemporaryDirectory() as raw:
+            root = Path(raw)
+            self.setup_view(root)
+            create(root)
+            self.assertEqual((root/'private').stat().st_mode & 0o777, 0o700)
+            self.assertEqual(list((root/'private').iterdir()), [])
+            self.assertFalse((root/'private-environment').exists())
+            with self.assertRaises(AssertionError): create(root)
+
+    def test_empty_r1_cannot_substitute_for_missing_or_populated_r2(self):
+        for defect in ('missing', 'unexpected-entry', 'populated-scratch'):
+            with self.subTest(defect=defect), tempfile.TemporaryDirectory() as raw:
+                root = Path(raw)
+                self.setup_view(root)
+                create(root)
+                old = root/'onboarding-r1'
+                (old/'tmp').mkdir(parents=True)
+                (old/'receipt.json').write_text('{}')
+                runtime = root/'onboarding-r2'
+                if defect == 'missing':
+                    (runtime/'receipt.json').unlink()
+                    (runtime/'tmp').rmdir()
+                    runtime.rmdir()
+                elif defect == 'unexpected-entry':
+                    (runtime/'unexpected').write_text('fixture')
+                else:
+                    (runtime/'tmp/occupied').write_text('fixture')
+                self.assertEqual({path.name for path in old.iterdir()},
+                                 {'receipt.json', 'tmp'})
+                self.assertEqual(list((old/'tmp').iterdir()), [])
+                with self.assertRaises(AssertionError): extra_mounts(root)
