+"""Collect the one owned compact onboarding attempt without reading credentials."""
+import datetime,fcntl,hashlib,json,subprocess,sys
+from pathlib import Path
+HERE=Path(__file__).resolve().parent
+def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+assert len(sys.argv)==2, 'actual terminal chunk required'
+outer=json.loads((HERE/'onboarding-outer-r2.json').read_text())
+receipt=json.loads((HERE/'onboarding-r2/receipt.json').read_text())
+instance=json.loads((HERE/'private/instance-result.json').read_text())
+spawn=json.loads((HERE/'onboarding-spawn-r2.json').read_text())
+manifest=json.loads((HERE/'inputs-onboarding-r2.json').read_text())
+assert outer['exit_code']==0 and receipt['status']=='commands_passed'
+assert receipt['input_hashes_before']==receipt['input_hashes_after']==manifest['sha256']
+assert not receipt['remaining_child_pids'] and not receipt.get('final_check_errors')
+assert instance['status']=='parked' and instance['joined_park'] and instance['daemon_joined']
+assert instance['registered_accounts']==0 and instance['parked_residents']==0
+assert instance['agent_login_submissions']==instance['agent_inference_submissions']==0
+unit='framerize-onboarding-onboarding-r2.service'
+state=subprocess.check_output(['systemctl','--user','show',unit,'-p','LoadState','--value'],text=True).strip()
+assert state=='not-found'
+assert all(not Path('/proc',str(spawn[k]['pid'])).exists() for k in ('launcher','unit_client'))
+with (HERE.parents[1]/'t3-binding-recovery-r1/execution-slot.lock').open('a') as slot:
+ fcntl.flock(slot,fcntl.LOCK_EX|fcntl.LOCK_NB)
+record=dict(at=datetime.datetime.now(datetime.timezone.utc).isoformat(),accepted=True,
+ execution_chunk=sys.argv[1],unit_absent=True,known_processes_absent=True,lock_free=True,
+ empty_instance_started=True,ui_readiness=True,joined_cleanup=True,login_submissions=0,
+ inference_submissions=0,native_acceptance=False,instance=instance,
+ receipts={str(p.relative_to(HERE)):sha(p) for p in [HERE/'onboarding-outer-r2.json',HERE/'onboarding-r2/receipt.json',HERE/'ui-ready-r2.json',HERE/'inputs-onboarding-r2.json',HERE/'private/instance-result.json']})
+with (HERE/'collection-compact-r2.json').open('x') as out:out.write(json.dumps(record,sort_keys=True)+'\n')
+print(json.dumps(dict(accepted=True,joined_cleanup=True,collection=sha(HERE/'collection-compact-r2.json'))))
