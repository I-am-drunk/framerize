+"""Fresh binding after R7 refused before controller entry; no service action."""
+import datetime, fcntl, hashlib, json, os, shutil, stat, sys, uuid
+from pathlib import Path
+BASE = Path(__file__).resolve().parent
+OLD, HERE = BASE/'execution-r7', BASE/'execution-r8'
+def sha(path): return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+def save(path, value):
+    with path.open('x') as out:
+        out.write(json.dumps(value, sort_keys=True)+'\n')
+assert sha(OLD/'plan.json') == '86ae9f578dedd9df8f51e40b63388f803574b185d925e694c24b12310182395e'
+assert sha(OLD/'collection-failed-r7.json') == '5baedf25d5db96283b25da688bbbff53fe15196eb00ef7d8e1ebfa52f7b16225'
+assert not (OLD/'output').exists()
+plan = json.loads((OLD/'plan.json').read_text())
+assert json.loads((OLD/'launch-terminal.json').read_text())['exit'] == 1
+HERE.mkdir(exist_ok=False)
+skip = {'activation-fence.conf.proposed', 'authenticate-command.sh'}
+for name, digest in plan['sources'].items():
+    path = Path(name)
+    assert sha(path) == digest
+    if path.is_relative_to(OLD) and str(path.relative_to(OLD)) not in skip:
+        target = HERE/path.relative_to(OLD)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(path, target)
+sys.path.insert(0, str(HERE))
+from binding import verify_original, verify_package
+from runtime import same
+from handoff import private_state
+current = verify_original()
+assert same(current, json.loads((OLD/'current-generation.json').read_text()))
+verify_package(plan)
+for path in (plan['dropin'], plan['rollback']['dropin'], plan['fence']['dropin']):
+    assert not Path(path).exists()
+plan.update(ready_for_execution=False, activation_nonce=uuid.uuid4().hex,
+            activation_permit=str(HERE/'output/activation/permit.json'))
+plan['proposed_dropin'] = str(HERE/'admission.conf.proposed')
+plan['rollback']['proposed_dropin'] = str(HERE/'rollback.conf.proposed')
+fence = HERE/'activation-fence.conf.proposed'
+with fence.open('x') as out:
+    out.write('[Unit]\nConditionPathExists='+plan['activation_permit']+'\n[Service]\nRestart=no\n')
+plan['fence'].update(proposed_dropin=str(fence), dropin_sha256=sha(fence))
+script = HERE/'authenticate-command.sh'
+with script.open('x') as out:
+    out.write('#!/bin/sh\nset -eu\nexec /usr/bin/python3 -I -B '+str(HERE/'authenticate.py')+' "$1"\n')
+script.chmod(0o700)
+paths = {HERE/Path(p).relative_to(OLD) if Path(p).is_relative_to(OLD) else Path(p)
+         for p in plan['sources']}
+paths.update([Path(__file__), OLD/'collection-failed-r7.json'])
+plan['sources'] = {str(path):sha(path) for path in sorted(paths)}
+assert same(current, verify_original())
+with Path(plan['execution_lock']).open('a') as lock:
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+plan['ready_for_execution'] = True
+save(HERE/'plan.json', plan)
+digest = sha(HERE/'plan.json')
+coordination = dict(mode='direct-bounded-control', plan_sha256=digest,
+                    requests_may_be_cancelled=True, timed_quiet_window=False)
+context = HERE/'operator-context.json'
+context_digest = private_state.write_new(context, coordination)
+checked, actual_digest = private_state.read(context, context_digest)
+assert checked == coordination and actual_digest == context_digest
+save(HERE/'invocation.json', dict(plan_sha256=digest,
+    authentication=['/usr/bin/python3','-I','-B',str(HERE/'authenticate.py'),digest],
+    launch=['/usr/bin/python3','-I','-B',str(HERE/'launch.py'),'--execute',digest,
+            str(context),context_digest]))
+save(HERE/'preflight.json', dict(at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+    context_mode=oct(stat.S_IMODE(context.stat().st_mode)), context_nlink=context.stat().st_nlink,
+    context_uid=context.stat().st_uid, context_sha256=context_digest, private_read_passed=True,
+    unchanged_controller_sources=True, original_generation=current['service']['InvocationID'],
+    retained_package=plan['release'], launched=False))
+print(json.dumps(dict(ready=True, plan_sha256=digest, sources=len(paths),
+    context_mode=oct(stat.S_IMODE(context.stat().st_mode)), launched=False)))
