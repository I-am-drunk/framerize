+"""Bind the qualified compact layout; leave runtime and account state uncreated."""
+import ast, hashlib, json
+from pathlib import Path
+HERE = Path(__file__).resolve().parent
+STAGE = HERE.parent/'onboarding-software-stage-r1'
+CHECK = HERE.parent/'onboarding-runtime-r2-qualification-r1'
+KERNEL = HERE.parent/'onboarding-layout-kernel-r4'
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+def save(name, data):
+    with (HERE/name).open('x') as out:
+        out.write(json.dumps(data, sort_keys=True)+'\n')
+assert sha(CHECK/'checks-collected.json') == '7c77e381de853484841fff031837e4e546ed99519f58ab9fbfc9bab31ff2311f'
+assert sha(KERNEL/'collection.json') == '92827fe9a9c55aba873fa7277b112110d4da34cab7a5065df641f4365319d84e'
+assert sha(HERE/'runtime_mounts_r2.py') == '5d4c73c01accc451b55c97ee2549529f5b7028a966a95eb898d364eed1313556'
+assert not any((HERE/name).exists() for name in ('private', 'private-environment', 'onboarding-r2'))
+contract = json.loads((HERE/'contract-onboarding-r1.json').read_text())
+argv = contract['argv_without_manifest_digest']
+contract['argv_without_manifest_digest'] = [
+    str(HERE/'run_onboarding_compact.py') if arg == str(HERE/'run_onboarding.py') else
+    '--unit=framerize-onboarding-onboarding-r2' if arg.startswith('--unit=') else
+    'r2' if arg == 'r1' else arg for arg in argv]
+pins = json.loads((HERE/'inputs-onboarding-r1.json').read_text())['sha256']
+extras = [HERE/name for name in ('compact_mounts.py', 'run_onboarding_compact.py',
+    'runtime_mounts_r2.py', 'launch_compact.py', 'prepare_compact.py')]
+extras += [STAGE/'compact-plan.json', STAGE/'finish_tree.py', CHECK/'checks-collected.json',
+           KERNEL/'collection.json'] + sorted((STAGE/'batches').glob('*.json'))
+assert len(list((STAGE/'batches').glob('*.json'))) == 6
+for path in extras:
+    assert path.resolve(strict=True) == path
+    if path.suffix == '.py': ast.parse(path.read_text())
+    pins[str(path)] = sha(path)
+contract_path = HERE/'contract-onboarding-r2.json'
+contract['required_inputs'] = sorted([*pins, str(contract_path)])
+contract['retained_evidence'] = dict(adapter=sha(CHECK/'checks-collected.json'),
+    kernel_layout=sha(KERNEL/'collection.json'), compact_plan=sha(STAGE/'compact-plan.json'))
+save(contract_path.name, contract)
+pins[str(contract_path)] = sha(contract_path)
+save('inputs-onboarding-r2.json', dict(sha256=pins))
+save('invocation-compact-r2.json', dict(status='PREPARED_UNRUN', command=[
+    '/usr/bin/flock', '-n', str(HERE.parents[1]/'t3-binding-recovery-r1/execution-slot.lock'),
+    '/usr/bin/python3.12', '-I', '-B', str(HERE/'launch_compact.py'), 'onboarding'],
+    manifest_sha256=sha(HERE/'inputs-onboarding-r2.json'),
+    contract_sha256=sha(contract_path)))
+save('compact-preparation-r2.json', dict(status='PREPARED_UNRUN', inputs=len(pins),
+    retained_original_inputs=True, prior_runtime_unconsumed=True,
+    software_mount_argument_count=len(json.loads((STAGE/'compact-plan.json').read_text())['argv']),
+    private_state_created=False, browser_started=False, sdk_started=False))
+print(json.dumps(dict(status='PREPARED_UNRUN', inputs=len(pins),
+    contract_sha256=sha(contract_path), manifest_sha256=sha(HERE/'inputs-onboarding-r2.json'))))
