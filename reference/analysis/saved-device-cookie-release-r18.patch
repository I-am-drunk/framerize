+"""Exercise the actual saved-device cookie build-evidence consumer offline."""
+import json, resource, sys
+from pathlib import Path
+resource.setrlimit(resource.RLIMIT_AS, (128 * 1024**2, 128 * 1024**2))
+resource.setrlimit(resource.RLIMIT_CPU, (10, 10))
+HERE = Path(__file__).resolve().parent
+DEPLOY = HERE.parent / 'offline-serving-deployment-r18'
+BUILD = HERE.parent / 'offline-device-cookie-r1'
+PEER = Path('/home/tjninja/.t3/scratch/2026-10-20-can-you-look-at-the-430fdc9c')
+sys.path.insert(0, str(DEPLOY))
+import adapter, release_evidence
+def pin(path): return {'path': str(path), 'sha256': adapter.sha(path)}
+summary = adapter.document(BUILD / 'validation-summary.json')
+origins = adapter.document(DEPLOY / 'origins.json')
+data = dict(validation_summary=pin(BUILD / 'validation-summary.json'),
+    preparation=pin(BUILD / 'validation-freeze.json'), test_preparation=summary['fixture'],
+    binary=summary['binary'], device_handoff_review=origins['device_handoff_review'],
+    cooldown_runtime=pin(DEPLOY / 'runtime-sources.json'),
+    cooldown_sidecar=pin(DEPLOY / 'camoufox_host.py'),
+    independent_results_review=pin(PEER / 'offline-device-cookie-results-review-r1/review.json'))
+before = release_evidence.build_inputs(adapter, data)
+paths = [Path(__file__), Path('/usr/bin/python3.12'), Path('/usr/bin/bwrap')]
+paths += [DEPLOY / n for n in ('adapter.py', 'release_evidence.py',
+    'live_checks.py', 'runtime_config.py', 'runtime_inputs.py', 'origins.json')]
+paths += [Path(row['path']) for row in data.values()]
+before.update({str(p): adapter.sha(p) for p in paths})
+assert before == {p: adapter.sha(p) for p in before}
+passed = ['accept_current_cookie_build_and_unchanged_runtime']
+old = dict(data, validation_summary=origins['completion_summary'])
+try:
+    release_evidence.build_inputs(adapter, old)
+except RuntimeError as error:
+    assert str(error) == 'saved-device cookie validation is required'
+    passed.append('reject_previous_completion_summary')
+else:
+    raise AssertionError('previous build accepted as cookie build')
+assert before == {p: adapter.sha(p) for p in before}
+result = dict(status='pass', passed=passed, inputs=before, release_bindings=data,
+    scope='Saved build and source consumer only; no service or request.')
+with (HERE / 'result.json').open('x') as f: json.dump(result, f, sort_keys=True)
+print(json.dumps({'status': 'pass', 'checks': passed, 'input_count': len(before)}))
