+"""One quiet cooldown wait followed by the reviewed binary deployment."""
+from pathlib import Path
+import json
+import os
+import sqlite3
+import subprocess
+import sys
+import time
+HERE = Path(__file__).resolve().parents[1] / 'admission-stream-deployment-r1'
+sys.path.insert(0, str(HERE / 'controller'))
+from recovery_binding import checked_plan, document, require, save, sha
+
+
+def pin(path):
+    return dict(path=str(path), sha256=sha(path))
+
+
+def main():
+    require(sys.argv[1:] == ['--execute'] and not sys.flags.optimize, 'explicit execution required')
+    plan_pin = pin(HERE / 'release/plan.json')
+    review_pin = document(pin(HERE / 'release/plan-review-pin.json'))
+    checked_plan(plan_pin, review_pin)
+    require(not (HERE / 'controller/execution').exists(), 'preserve prior recovery attempt')
+    auth = ['sudo', '-v'] if sys.stdin.isatty() else ['sudo', '-n', '-v']
+    require(subprocess.run(auth, timeout=120).returncode == 0, 'authentication required')
+    print(json.dumps(dict(phase='quiet_settling', seconds=45)), flush=True)
+    time.sleep(45)
+    uri = 'file:/home/tjninja/.framerize/framerize.db?mode=ro'
+    with sqlite3.connect(uri, uri=True) as db:
+        rows = [json.loads(row[0]) for row in db.execute('SELECT json FROM accounts')]
+    require(len(rows) == 11, 'account count changed')
+    selected = [r for r in rows if r['state'] == 'ready' and
+                r['current_team'] is not None and r['current_project'] is not None]
+    ends = [r['cooling_until_ms'] for r in selected if r.get('cooling_until_ms') is not None]
+    require(all(type(end) is int and end >= 0 for end in ends), 'invalid cooldown')
+    delay = max(0, max(ends, default=0) / 1000 - time.time() + 2)
+    require(delay <= 900, 'cooldown exceeds this bounded quiet attempt')
+    record = dict(at_unix=time.time(), ready_with_context=len(selected), wait_seconds=delay)
+    path = HERE / ('cooldown-window-' + str(time.time_ns()) + '.json')
+    save(path, record)
+    until = time.monotonic() + delay
+    while time.monotonic() < until:
+        remaining = max(0, until - time.monotonic())
+        print(json.dumps(dict(phase='cooldown_wait', remaining_seconds=round(remaining))), flush=True)
+        require(subprocess.run(['sudo', '-n', '-v'], timeout=5).returncode == 0,
+                'terminal authentication expired')
+        time.sleep(min(30, remaining))
+    checked_plan(plan_pin, review_pin)
+    os.execv('/usr/bin/python3', ['/usr/bin/python3', '-I', '-B', '-S',
+             str(HERE / 'operator.py'), 'activate'])
+
+
+if __name__ == '__main__':
+    main()
