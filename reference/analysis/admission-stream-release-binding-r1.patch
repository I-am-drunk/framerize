+                 patch.object(run_once.sys, 'argv', ['run_once.py', '--execute']), \
+                 patch.object(run_once.os, 'execv') as execute:
+                run_once.main()
+                with self.assertRaises(FileExistsError):
+                    run_once.main()
+                execute.assert_called_once()
+                self.assertEqual(execute.call_args.args[1][-2:], [str(root / 'launch.py'), seal])
