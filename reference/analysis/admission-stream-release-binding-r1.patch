+"""One guarded binary deployment, then two normal-stream acceptance requests."""
+import hashlib
+import json
+import os
+import resource
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+DEPLOY = HERE.parent / 'admission-stream-deployment-r1'
+CLIENT = HERE.parent / 'admission-stream-live-check-r3'
+PEERS = {'466b6e5b-4733-4325-b5c4-fb2eac98b835',
+         'mcp:5f12e90a-05fe-4ae9-ad74-80288a94c597',
+         '0b8f0573-c8fd-4bd6-a241-d202430fdc9c',
+         'mcp:28c55101-e602-443c-a616-db31e42ee907'}
+ACTIVE = None
+CANCELLED = False
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+def document(pin):
+    path = Path(pin['path'])
+    assert path.is_absolute() and sha(path) == pin['sha256'], 'bound input changed'
+    assert path.stat().st_size <= 4 * 1024**2, 'oversized control input'
+    return json.loads(path.read_bytes())
+
+def cancelled(_number, _frame):
+    global CANCELLED
+    CANCELLED = True
+    if ACTIVE is not None and ACTIVE.poll() is None:
+        try:
+            os.killpg(ACTIVE.pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+
+def checked_client(control):
+    freeze = document(control['client_freeze'])
+    review = document(control['client_review'])
+    assert review.get('accepted') is True, 'client review refused'
+    assert review.get('status') == 'ACCEPTED_SOURCE_AND_SAVED_EVIDENCE_BINDINGS_ONLY', 'client review scope differs'
+    assert review.get('freeze') == control['client_freeze'], 'review covers another freeze'
+    assert review.get('validation') == freeze['validation'], 'review covers another result'
+    source = document(freeze['source'])
+    manifest = freeze['manifest']
+    assert sha(manifest['path']) == manifest['sha256'], 'client manifest changed'
+    base = Path(manifest['path']).parent
+    for row in Path(manifest['path']).read_text().splitlines():
+        digest, name = row.split('  ', 1)
+        assert sha(base / name) == digest, 'client seal changed'
+    for path, digest in source['files'].items():
+        assert sha(path) == digest, 'client source changed'
+    driver = control['driver']
+    assert source['files'].get(driver['path']) == driver['sha256'], 'driver is not sealed'
+    assert Path(driver['path']).name == 'run_once.py', 'wrong client entry'
+    prepare = str(HERE / 'prepare.py')
+    assert source['files'].get(prepare) == control['prepare_sha256'], 'unsealed preparation'
+    return driver
+
+def run_phase(script, arguments, log_name):
+    global ACTIVE
+    assert not CANCELLED, 'sequence cancelled'
+    with (HERE / log_name).open('x') as log:
+        ACTIVE = subprocess.Popen(['/usr/bin/python3', '-I', '-B', '-S', str(script),
+            *arguments], stdout=log, stderr=subprocess.STDOUT, process_group=0)
+        try:
+            code = ACTIVE.wait()
+        finally:
+            ACTIVE = None
+    assert not CANCELLED, 'sequence cancelled'
