+"""Inert checks of the recovery-to-client orchestration boundary."""
+import json
+import tempfile
+import unittest
+from contextlib import ExitStack, contextmanager
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+import sequence as runner
+
+
+@contextmanager
+def client_case(include_prepare=True):
+    with tempfile.TemporaryDirectory() as folder:
+        root = Path(folder)
+        def pin(path):
+            return dict(path=str(path), sha256=runner.sha(path))
+        def write(name, data):
+            path = root / name
+            path.write_text(json.dumps(data))
+            return pin(path)
+        driver, prepare = root / 'run_once.py', root / 'prepare.py'
+        driver.write_text('inert driver')
+        prepare.write_text('inert preparation')
+        files = {str(driver): runner.sha(driver)}
+        if include_prepare:
+            files[str(prepare)] = runner.sha(prepare)
+        manifest = root / 'SOURCE.sha256'
+        manifest.write_text(runner.sha(driver) + '  run_once.py\n')
+        validation = write('validation.json', {'accepted': True})
+        frozen = dict(source=write('source.json', {'files': files}),
+                      manifest=pin(manifest), validation=validation)
+        freeze = write('freeze.json', frozen)
+        review = write('review.json', dict(accepted=True,
+            status='ACCEPTED_SOURCE_AND_SAVED_EVIDENCE_BINDINGS_ONLY',
+            freeze=freeze, validation=validation))
+        control = dict(client_freeze=freeze, client_review=review,
+                       driver=pin(driver), prepare_sha256=runner.sha(prepare))
+        with patch.object(runner, 'HERE', root):
+            yield control
+
+
+class ClientSealTests(unittest.TestCase):
+    def test_bound_client_and_preparation_are_accepted(self):
+        with client_case() as control:
+            self.assertEqual(runner.checked_client(control), control['driver'])
+
+    def test_unsealed_preparation_is_rejected(self):
+        with client_case(False) as control, self.assertRaisesRegex(AssertionError, 'unsealed preparation'):
+            runner.checked_client(control)
+
+@contextmanager
+def case(deployment_exit=0, client_exit=0):
+    with tempfile.TemporaryDirectory() as temporary, ExitStack() as stack:
+        root = Path(temporary)
+        attempt = root / 'attempt'
+        attempt.mkdir()
+        recovery = root / 'recovery'
+        driver = dict(path=str(root / 'client/run_once.py'), sha256='a' * 64)
+        plan_pin = dict(path=str(root / 'plan.json'), sha256='a' * 64)
+        review_pin = dict(path=str(root / 'review.json'), sha256='a' * 64)
+        control = dict(sequence_sha256='a' * 64, prepare_sha256='a' * 64, quiet_until_unix=6000,
+            deployment_plan=plan_pin, deployment_review=review_pin,
+            peers=[dict(thread_id=p, message_id='inert', ack_at_unix=999,
+                        quiet_until_unix=6000) for p in runner.PEERS])
+        plan = dict(sources={str(recovery / 'quiet_then_recover.py'): 'a' * 64})
+        review = dict(accepted=True, status='ACCEPTED_FOR_COORDINATED_ACTIVATION',
+                      plan_sha256='a' * 64)
+        documents = {str(attempt / 'control.json'): control,
+                     plan_pin['path']: plan, review_pin['path']: review}
+        calls = []
+        def phase(script, arguments, log_name):
+            calls.append(str(script))
+            (attempt / log_name).write_text('inert\n')
+            if len(calls) == 1:
+                released = recovery / 'release/released.json'
+                released.parent.mkdir(parents=True)
+                released.write_text(json.dumps(dict(
+                    status='VERIFIED_ADMISSION_BINARY_RELEASED', marker_absent=True, accepted=True)))
+            return deployment_exit if len(calls) == 1 else client_exit
+        checked = Mock(return_value=driver)
+        stack.enter_context(patch.multiple(runner, HERE=attempt, DEPLOY=recovery, CLIENT=root / 'client',
+            ACTIVE=None, CANCELLED=False, checked_client=checked,
+            sha=lambda _: 'a' * 64, run_phase=phase,
+            document=lambda pin: documents[pin['path']]))
+        stack.enter_context(patch.object(runner.sys, 'argv',
+            ['sequence.py', '--execute', 'a' * 64]))
+        stack.enter_context(patch.object(runner.time, 'time', return_value=1000))
+        stack.enter_context(patch.object(runner.resource, 'setrlimit'))
+        stack.enter_context(patch.object(runner.signal, 'signal'))
+        stack.enter_context(patch.object(runner.os, 'umask'))
+        stack.enter_context(patch('builtins.print'))
+        yield SimpleNamespace(calls=calls, checked=checked, control=control,
+            driver=driver, output=attempt / 'sequence-result.json')
+
+class SequenceTests(unittest.TestCase):
+    def test_deployment_precedes_the_single_client(self):
+        with case() as f:
+            self.assertEqual(runner.main(), 0)
+            self.assertEqual([Path(p).name for p in f.calls],
+                             ['prepare.py', 'run_once.py'])
+
+    def test_refused_deployment_never_starts_client(self):
+        with case(deployment_exit=1) as f:
+            self.assertEqual(runner.main(), 1)
+            self.assertEqual(len(f.calls), 1)
+            self.assertFalse(json.loads(f.output.read_text())['client_started'])
+
+    def test_changed_client_after_deployment_is_refused(self):
+        with case() as f:
+            f.checked.side_effect = [f.driver, AssertionError('client seal changed')]
+            self.assertEqual(runner.main(), 1)
+            self.assertEqual(len(f.calls), 1)
+
+    def test_short_quiet_window_never_starts_recovery(self):
+        with case() as f:
+            f.control['quiet_until_unix'] = 5000
+            self.assertEqual(runner.main(), 1)
+            self.assertEqual(f.calls, [])
+
+    def test_existing_attempt_cannot_be_replayed(self):
+        with case() as f:
+            self.assertEqual(runner.main(), 0)
+            original = f.output.read_bytes()
+            with self.assertRaises(FileExistsError):
+                runner.main()
+            self.assertEqual(len(f.calls), 2)
+            self.assertEqual(f.output.read_bytes(), original)
