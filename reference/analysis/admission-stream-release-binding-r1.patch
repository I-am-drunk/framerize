+"""Bind the accepted normal-stream client to the reviewed binary-only release."""
+import hashlib as _hashlib
+from pathlib import Path as _Path
+_prior = _Path(__file__).resolve().parents[1] / 'offline-serving-client-check-r9/check.py'
+_source = _prior.read_bytes()
+assert _hashlib.sha256(_source).hexdigest() == \
+    '439d9269db5eb4f7c535d2b6bb065eac96bd5815228f747201782274a8a69b3b'
+exec(compile(_source, str(_prior), 'exec'), globals())
+
+
+def deployed():
+    root = DEPLOY / 'release'
+    released, digest = read_document(root / 'released.json')
+    require(released.get('accepted') is True and released.get('marker_absent') is True
+            and released.get('status') == 'VERIFIED_ADMISSION_BINARY_RELEASED',
+            'deployment_not_released')
+    require(not Path('/home/tjninja/.local/state/framerize-recovery/maintenance').exists(),
+            'maintenance_active')
+    expected = {'plan': root / 'plan.json', 'post_start': root / 'post-start.json',
+                'cleared_handoff': root / 'cleared-handoff.json'}
+    documents = {}
+    for key, path in expected.items():
+        row = released[key]
+        require(Path(row['path']) == path, 'wrong_release_evidence')
+        documents[key] = read_document(path, row['sha256'])[0]
+    require(released['plan']['sha256'] == PLAN, 'wrong_deployment_plan')
+    review_pin = read_document(root / 'plan-review-pin.json')[0]
+    require(released['plan_review'] == review_pin, 'review_binding_changed')
+    review = read_document(review_pin['path'], review_pin['sha256'])[0]
+    require(review.get('accepted') is True and review.get('findings') == [] and
+            review.get('status') == 'ACCEPTED_FOR_COORDINATED_ACTIVATION' and
+            review.get('plan_sha256') == PLAN, 'plan_not_accepted')
+    post = documents['post_start']
+    require(post['plan'] == released['plan'] and post['plan_review'] == review_pin and
+            post['status'] == 'VERIFIED_BINARY_DEPLOYMENT_PENDING_HOLD_RELEASE' and
+            post['current'] == released['service'], 'release_postcheck_differs')
+    state_pin = post['adapter_receipt']
+    require(Path(state_pin['path']) == DEPLOY / 'deployment.json', 'wrong_deployment_state')
+    state = read_document(state_pin['path'], state_pin['sha256'])[0]
+    require(state['status'] == 'configured_pending_independent_verification' and
+            len(state['stops']) == len(state['startup_attempts']) == 1 and
+            state['protected'] == post['protected'], 'deployment_state_differs')
+    require(state['files']['binary']['new_sha256'] == BINARY, 'wrong_replacement_binary')
+    for record in (post['metrics'], released['metrics']):
+        require(record['memory.swap.current'] == record['memory.swap.peak'] == '0'
+                and all(line.split()[1] == '0' for line in record['memory.events'].splitlines()),
+                'release_resource_evidence_failed')
+    service = current_service()
+    saved = released['service']
+    require(service['invocation_id'] == saved['service']['InvocationID'] and
+            service['pid'] == saved['main']['pid'] and service['start'] == saved['main']['start'],
+            'released_service_changed')
+    listener_owned(service['pid'])
+    return service, digest
