+import copy
+import json
+import unittest
+from unittest.mock import patch
+import check
+import recovery_state as recovery
+from recovery_fixture import case, live, write
+
+class RecoveryTests(unittest.TestCase):
+    def test_saved_recovery_binds_new_generation_and_original_release(self):
+        with case() as f:
+            result = recovery.saved(f.client, f.original, f.original_sha)
+            self.assertEqual(result['service'], recovery.service(f.current))
+            self.assertEqual(recovery.origin(f.client), recovery.service(f.original['service']))
+
+    def test_incomplete_controller_is_rejected(self):
+        for field, value in [('exit_code', 1), ('errors', ['failure']),
+                             ('command_joined', False), ('unit_absent', False), ('cgroup_absent', False)]:
+            with self.subTest(field=field), case() as f:
+                f.outer[field] = value; f.refresh()
+                with self.assertRaisesRegex(check.Refused, 'recovery_controller_incomplete'):
+                    recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_source_only_review_cannot_authorize_recovered_client(self):
+        with case() as f:
+            pin = write(f.root / 'review.json', dict(accepted=True,
+                status='ACCEPTED_SOURCE_ONLY_PENDING_VALIDATION', plan_sha256=recovery.PLAN_SHA))
+            write(f.runtime / 'release/plan-review-pin.json', pin)
+            with patch.object(recovery, 'REVIEW_SHA', pin['sha256']):
+                with self.assertRaisesRegex(RuntimeError, 'source/results review is missing'):
+                    recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_changed_or_unrecovered_generation_is_rejected(self):
+        for variant in ['state', 'post', 'unchanged']:
+            with self.subTest(variant=variant), case() as f:
+                if variant == 'unchanged':
+                    for value in [f.state, f.post, f.released]:
+                        value['current'] = copy.deepcopy(f.original['service'])
+                    expected = 'wrong_recovery_generation'
+                else:
+                    value = f.state if variant == 'state' else f.post
+                    value['current'] = copy.deepcopy(value['current'])
+                    value['current']['main']['start'] += 1
+                    expected = 'inconsistent_recovery_generation'
+                f.refresh()
+                with self.assertRaisesRegex(check.Refused, expected):
+                    recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_unreleased_hold_is_rejected(self):
+        with case() as f:
+            f.state['hold_released'] = False; f.refresh()
+            with self.assertRaisesRegex(check.Refused, 'recovery_state_incomplete'):
+                recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_changed_protected_files_are_rejected(self):
+        with case() as f:
+            f.post['protected'] = dict(changed=True); f.refresh()
+            with self.assertRaisesRegex(check.Refused, 'inconsistent_recovery_protection'):
+                recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_unpinned_state_is_rejected(self):
+        with case() as f:
+            write(f.output / 'recovery-state.json', dict(untrusted=True))
+            with self.assertRaisesRegex(check.Refused, 'changed_evidence'):
+                recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_saved_resource_failures_are_rejected(self):
+        for field, value in [('memory.swap.current', '1'), ('memory.swap.peak', '1'),
+                             ('memory.events', 'oom 1')]:
+            with self.subTest(field=field), case() as f:
+                f.released['metrics'] = dict(f.metrics, **{field: value}); f.refresh()
+                with self.assertRaisesRegex(check.Refused, 'recovery_resource_event'):
+                    recovery.saved(f.client, f.original, f.original_sha)
+
+    def test_fresh_identity_and_protection_are_checked(self):
+        with case() as f:
+            active = live(f)
+            service, _ = recovery.checked(f.client, f.original, f.original_sha)
+            self.assertEqual(service, recovery.service(f.current))
+            active.helper['identity'].assert_called_once()
+            active.adapter.protected.assert_called_once()
+            active.adapter.admit.assert_called_once()
+
+    def test_live_changes_refuse_before_delivery(self):
+        for variant in ['generation', 'sidecar', 'protection']:
+            with self.subTest(variant=variant), case() as f:
+                active = live(f)
+                if variant == 'generation':
+                    active.current.return_value = dict(active.current.return_value, start=999)
+                elif variant == 'sidecar':
+                    active.identity['sidecar'] = dict(active.identity['sidecar'], start=999)
+                else:
+                    active.adapter.protected.return_value = dict(changed=True)
+                with self.assertRaisesRegex(check.Refused, 'recovered_(service|protection)_changed'):
+                    recovery.checked(f.client, f.original, f.original_sha)
+
+    def test_live_resource_changes_refuse_before_delivery(self):
+        for variant in ['swap', 'swap_peak', 'event', 'disk']:
+            with self.subTest(variant=variant), case() as f:
+                active = live(f)
+                if variant == 'swap': active.memory['memory.swap.current'] = '1'
+                elif variant == 'swap_peak': active.peak = '1'
+                elif variant == 'event': active.memory['memory.events'] = 'oom 1'
+                else: active.free = 1024**3
+                with self.assertRaisesRegex(check.Refused, 'recovered_(resource_event|disk_reserve)'):
+                    recovery.checked(f.client, f.original, f.original_sha)
+
+    def test_changed_original_release_is_rejected(self):
+        with case() as f:
+            with self.assertRaisesRegex(check.Refused, 'changed_original_release'):
+                recovery.checked(f.client, f.original, '0'*64)
