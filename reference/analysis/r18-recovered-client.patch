@@ -0,0 +1,39 @@
+import runpy
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from client_fixture import SERVICE, case
+import run_once as driver
+
+ORIGINAL = runpy.run_path(str(Path(__file__).resolve().parent.parent /
+                             'offline-serving-client-input-r8/run_once.py'))
+
+def use_recovered_generation(state):
+    current = dict(SERVICE, start=124, invocation_id='recovered-generation')
+    state.client['deployed'].return_value = (current, 'recovery-release')
+    state.current.return_value = current
+
+class RecoveredDriverTests(unittest.TestCase):
+    def test_recovered_generation_preserves_origin_and_original_refusal(self):
+        with case() as state:
+            use_recovered_generation(state)
+            original_run = ORIGINAL['run']
+            with patch.dict(ORIGINAL['run'].__globals__, vars(driver)):
+                with self.assertRaisesRegex(AssertionError, 'R18 generation changed'):
+                    original_run(state.report)
+            state.connection.request.assert_not_called()
+        with case() as state:
+            use_recovered_generation(state)
+            driver.run(state.report)
+            self.assertTrue(state.report['accepted'])
+            state.connection.request.assert_called_once()
+            state.native.assert_called_once()
+
+    def test_recovery_refusal_never_reaches_a_request(self):
+        with case() as state:
+            state.client['deployed'].side_effect = AssertionError('recovery refused')
+            with self.assertRaisesRegex(AssertionError, 'recovery refused'):
+                driver.run(state.report)
+            state.pool.assert_not_called()
+            state.connection.request.assert_not_called()
+            state.native.assert_not_called()
