+    fixture.stack.enter_context(patch.object(Path, 'read_text', lambda path, *a, **k:
+        state.peak if str(path) == '/sys/fs/cgroup/inert-recovery/memory.swap.peak'
+        else original_read(path, *a, **k)))
+    fixture.stack.enter_context(patch.object(Path, 'exists', lambda path:
+        False if str(path) == '/home/tjninja/.local/state/framerize-recovery/maintenance' else original_exists(path)))
+    fixture.stack.enter_context(patch.object(recovery.shutil, 'disk_usage',
+        side_effect=lambda _path: SimpleNamespace(free=state.free)))
+    return state
