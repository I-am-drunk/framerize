+"""Inert saved recovery records for the client binding checks."""
+import hashlib
+import json
+import tempfile
+from contextlib import ExitStack, contextmanager
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+import check
+import recovery_state as recovery
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value))
+    return dict(path=str(path), sha256=sha(path))
+
+def snapshot(pid, generation):
+    return dict(main=dict(pid=pid, start=pid, exe_sha256='b'*64),
+                sidecar=dict(pid=pid+1, start=pid, exe_sha256='c'*64),
+                service=dict(InvocationID=generation), cgroup='/inert-recovery')
+
+@contextmanager
+def case():
+    with tempfile.TemporaryDirectory() as directory, ExitStack() as stack:
+        root = Path(directory); deployment = root / 'deployment'; runtime = root / 'recovery'
+        output = runtime / 'controller/execution'; output.mkdir(parents=True)
+        binding = runtime / 'controller/recovery_binding.py'
+        binding.write_bytes((recovery.RECOVERY / 'controller/recovery_binding.py').read_bytes())
+        old = snapshot(100, 'old'); current = snapshot(200, 'recovered')
+        original = dict(service=old, marker_absent=True)
+        origin_pin = write(deployment / 'release/released.json', original)
+        release_pin = write(deployment / 'release/release.json', dict(kind='inert'))
+        receipt_pin = write(deployment / 'deployment.json', dict(kind='inert'))
+        plan = dict(sources={str(binding): sha(binding)}, evidence={origin_pin['path']: origin_pin['sha256']},
+                    modules={}, max_settlement_seconds=900, outer_seconds=2700,
+                    purpose='RECOVER_INSTALLED_RUNTIME_WITH_OWNED_HOLD',
+                    original_release=origin_pin, release=release_pin,
+                    original_receipt=receipt_pin, execution_dir=str(output))
+        plan_pin = write(runtime / 'release/plan.json', plan)
+        review_pin = write(root / 'review.json', dict(accepted=True,
+            status='ACCEPTED_FOR_OWNED_RUNTIME_RECOVERY', plan_sha256=plan_pin['sha256']))
+        write(runtime / 'release/plan-review-pin.json', review_pin)
+        protection = dict(unchanged=True)
+        metrics = {'memory.swap.current': '0', 'memory.swap.peak': '0', 'memory.events': 'high 0\noom 0'}
+        before = dict(current=old, protected=protection)
+        before_pin = write(output / 'input-inspection.json', before)
+        post = dict(current=current, protected=protection, metrics=metrics)
+        post_pin = write(output / 'post-recovery.json', post)
+        state = dict(status='RESTORED_RUNTIME_HOLD_RELEASED', hold_released=True,
+                     release=release_pin, recovery_original_receipt=receipt_pin,
+                     recovery_input=before_pin, current=current, protected=protection)
+        state_pin = write(output / 'recovery-state.json', state)
+        released = dict(status=state['status'], marker_absent=True, state=state_pin,
+                        post_recovery=post_pin, current=current, protected=protection, metrics=metrics)
+        write(output / 'released.json', released)
+        log = runtime / 'controller/framerize-r18-recover-fixture.log'
+        log.write_text('inert successful recovery\n')
+        outer = dict(unit=log.stem, plan=plan_pin, review=review_pin, exit_code=0,
+                     errors=[], command_joined=True, unit_absent=True, cgroup_absent=True,
+                     log_sha256=sha(log))
+        write(log.with_suffix('.json'), outer)
+        stack.enter_context(patch.multiple(recovery, RECOVERY=runtime,
+            PLAN_SHA=plan_pin['sha256'], REVIEW_SHA=review_pin['sha256'], ORIGIN_SHA=origin_pin['sha256']))
+        client = dict(vars(check), DEPLOY=deployment, BINARY='b'*64)
+        fixture = SimpleNamespace(root=root, runtime=runtime, output=output, client=client,
+            original=original, original_sha=origin_pin['sha256'], before=before, post=post,
+            state=state, released=released, outer=outer, outer_path=log.with_suffix('.json'),
+            review_pin=review_pin, plan=plan, current=current, metrics=metrics, stack=stack)
+        def refresh():
+            state['recovery_input'] = write(output / 'input-inspection.json', before)
+            released['state'] = write(output / 'recovery-state.json', state)
+            released['post_recovery'] = write(output / 'post-recovery.json', post)
+            write(output / 'released.json', released)
+            write(log.with_suffix('.json'), outer)
+        fixture.refresh = refresh
+        yield fixture
+
+def live(fixture):
+    support = fixture.root / 'support.py'; support.write_text('inert support\n')
+    fixture.stack.enter_context(patch.multiple(recovery, SUPPORT=support, SUPPORT_SHA=sha(support)))
+    expected = recovery.service(fixture.current)
+    identity = dict(service=expected, main=fixture.current['main'], sidecar=fixture.current['sidecar'])
+    adapter = Mock()
+    adapter.protected.return_value = fixture.state['protected']
+    helper = dict(load=Mock(return_value=adapter), identity=Mock(return_value=identity))
+    original_run = recovery.runpy.run_path
+    fixture.stack.enter_context(patch.object(recovery.runpy, 'run_path',
+        side_effect=lambda path: helper if Path(path) == support else original_run(path)))
+    current = Mock(return_value=expected)
+    memory = dict(fixture.metrics)
