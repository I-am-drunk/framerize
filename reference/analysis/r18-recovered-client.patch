+"""Read-only binding to one verified R18 recovery result."""
+import hashlib, json, runpy, shutil, sys
+from pathlib import Path
+from types import SimpleNamespace
+HERE = Path(__file__).resolve().parent
+RECOVERY = HERE.parent / 'offline-serving-r18-runtime-recovery-r2'
+PLAN_SHA = '7c0d9a2948b47484abf5ea15c3edbd93befdc02c3e57b498f3a4129a81ba2bda'
+REVIEW_SHA = 'a4338526ccfdfa7a7a0abe2b34c385af030a55334666f41d40327ca305c9020c'
+BINDING_SHA = '3e3d9731d7c161b7cc5f05d9c6b659783b379674724ffb6a26eabd6d45f047a5'
+SUPPORT = HERE.parent / 'admission-live-check-r1/support.py'
+SUPPORT_SHA = '2cbce5e2082b3c3ad08b482d73ae6b6c8f43172a3c07d92e1c5d4643a4a6b164'
+ORIGIN_SHA = '0d52e0ca2a1e8e5e1e3b0c565e045d76bb91a6c09f94b80ea7c44d496d515608'
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+def service(snapshot):
+    main = snapshot['main']
+    return dict(pid=main['pid'], start=main['start'], binary_sha256=main['exe_sha256'],
+                invocation_id=snapshot['service']['InvocationID'], cgroup=snapshot['cgroup'])
+
+def read_pin(client, pin, path):
+    client['require'](Path(pin['path']) == path, 'wrong_recovery_evidence_path')
+    return client['read_document'](path, pin['sha256'])[0]
+
+def origin(client):
+    value, _ = client['read_document'](client['DEPLOY'] / 'release/released.json', ORIGIN_SHA)
+    return service(value['service'])
+
+def saved(client, original, original_sha):
+    require = client['require']
+    require(len(REVIEW_SHA) == 64, 'recovery_review_unbound')
+    binding = RECOVERY / 'controller/recovery_binding.py'
+    require(sha(binding) == BINDING_SHA, 'recovery_binding_changed')
+    review, _ = client['read_document'](RECOVERY / 'release/plan-review-pin.json')
+    require(review['sha256'] == REVIEW_SHA, 'wrong_recovery_review')
+    plan_pin = dict(path=str(RECOVERY / 'release/plan.json'), sha256=PLAN_SHA)
+    plan = runpy.run_path(str(binding))['checked_plan'](plan_pin, review)
+    require(plan['original_release'] == dict(path=str(client['DEPLOY'] / 'release/released.json'),
+                                            sha256=original_sha), 'wrong_recovery_origin')
+    output = RECOVERY / 'controller/execution'
+    require(Path(plan['execution_dir']) == output, 'wrong_recovery_output')
+    receipts = list((RECOVERY / 'controller').glob('framerize-r18-recover-*.json'))
+    require(len(receipts) == 1, 'ambiguous_recovery_controller')
+    outer, _ = client['read_document'](receipts[0])
+    require(outer['plan'] == plan_pin and outer['review'] == review, 'wrong_recovery_controller')
+    require(outer.get('exit_code') == 0 and outer.get('errors') == [] and
+            all(outer.get(key) is True for key in ('command_joined', 'unit_absent', 'cgroup_absent')),
+            'recovery_controller_incomplete')
+    require(receipts[0].stem == outer['unit'] and
+            sha(receipts[0].with_suffix('.log')) == outer['log_sha256'], 'changed_recovery_log')
+    released, digest = client['read_document'](output / 'released.json')
+    require(released.get('status') == 'RESTORED_RUNTIME_HOLD_RELEASED' and
+            released.get('marker_absent') is True, 'recovery_not_released')
+    state = read_pin(client, released['state'], output / 'recovery-state.json')
+    post = read_pin(client, released['post_recovery'], output / 'post-recovery.json')
+    before = read_pin(client, state['recovery_input'], output / 'input-inspection.json')
+    require(state.get('status') == released['status'] and state.get('hold_released') is True,
+            'recovery_state_incomplete')
+    require(state['release'] == plan['release'] and
+            state['recovery_original_receipt'] == plan['original_receipt'], 'wrong_recovery_state')
+    expected = service(released['current'])
+    require(service(before['current']) == service(original['service']) and
+            expected != service(before['current']), 'wrong_recovery_generation')
+    for snapshot in (state['current'], post['current']):
+        require(service(snapshot) == expected and snapshot['sidecar'] == released['current']['sidecar'],
+                'inconsistent_recovery_generation')
+    require(released['protected'] == post['protected'] == before['protected'] == state['protected'],
+            'inconsistent_recovery_protection')
+    for values in (released['metrics'], post['metrics']):
+        require(values['memory.swap.current'] == values['memory.swap.peak'] == '0' and
+                all(row.split()[1] == '0' for row in values['memory.events'].splitlines()),
+                'recovery_resource_event')
+    return dict(service=expected, digest=digest, state=state, plan=plan, released=released)
+
+def checked(client, original, original_sha):
+    require = client['require']
+    require(original_sha == ORIGIN_SHA, 'changed_original_release')
+    bound = saved(client, original, original_sha)
+    expected, state = bound['service'], bound['state']
+    require(expected['binary_sha256'] == client['BINARY'], 'wrong_recovered_binary')
+    require(sha(SUPPORT) == SUPPORT_SHA, 'changed_identity_helper')
+    support = runpy.run_path(str(SUPPORT))
+    sys.path.insert(0, str(client['DEPLOY']))
+    path = client['DEPLOY'] / 'adapter.py'
+    adapter = support['load']('recovered_client_adapter', path, bound['plan']['sources'][str(path)])
+    live = support['identity'](SimpleNamespace(**client), adapter)
+    require(live['service'] == expected and
+            live['main'] == bound['released']['current']['main'] and
+            live['sidecar'] == bound['released']['current']['sidecar'], 'recovered_service_changed')
+    protection = adapter.protected(adapter.release(bound['plan']['release']), expected['pid'])
+    require(protection == state['protected'], 'recovered_protection_changed')
+    memory = client['memory_snapshot'](expected)
+    group = Path('/sys/fs/cgroup' + expected['cgroup'])
+    require(memory['memory.swap.current'] == '0' and
+            (group / 'memory.swap.peak').read_text().strip() == '0' and
+            all(row.split()[1] == '0' for row in memory['memory.events'].splitlines()),
+            'recovered_resource_event')
+    adapter.admit()
+    require(shutil.disk_usage(HERE).free > 1024**3, 'recovered_disk_reserve')
+    require(not Path('/home/tjninja/.local/state/framerize-recovery/maintenance').exists(),
+            'maintenance_active')
+    require(client['current_service']() == expected, 'recovered_service_changed')
+    return expected, bound['digest']
